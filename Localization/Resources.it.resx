  <data name="ImpossibleQuestionComplaintsNoPositive" xml:space="preserve">
    <value>Quanto siete accomodante.</value>
  </data>
  <data name="ImpossibleQuestionComplaintsNoNegative" xml:space="preserve">
    <value>Sospetto. Il silenzio, il più delle volte, cela i lamenti più grandi.</value>
