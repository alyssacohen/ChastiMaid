<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChastiMaid.App"
             xmlns:local="using:ChastiMaid"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="DisplayFont">avares://ChastiMaid/Assets/Fonts#Instrument Serif</FontFamily>
            <FontFamily x:Key="HeadingFont">avares://ChastiMaid/Assets/Fonts#Instrument Serif Italic</FontFamily>
            <FontFamily x:Key="DefaultFont">avares://ChastiMaid/Assets/Fonts#Inter 28pt Light</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ChastiMaid/GlobalStyles.axaml" />
    </Application.Styles>

</Application>
