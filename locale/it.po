msgstr "Rigenera"

#: ../ViewModels/StartSessionViewModel.cs:320
msgid "Regenerate Outfit"
msgstr "Rigenera outfit"

#: ../ViewModels/StartSessionViewModel.cs:321
#, csharp-format
msgid ""
"Regenerating will reduce your bonus to {0:F0}% of the base multiplier. The "
"new outfit replaces this one for good: there is no going back to it. Proceed?"
msgstr ""
"Rigenerare ridurrà il vostro bonus al {0:F0}% del moltiplicatore base. Il "
"nuovo outfit prenderà il posto di questo in via definitiva: non sarà "
"possibile ripensarci né tornare indietro. Procedere?"

#: ../Views/SafeLockView.axaml:54
msgid "Retry Capture"
msgstr "Riprova scatto"

#: ../Views/SafeLockView.axaml:19
msgid "Safe Lock"
msgstr "Blocco cassaforte"

#: ../ViewModels/GameCompleteViewModel.cs:61
msgid "Safe combination photo exported."
msgstr "Foto della combinazione cassaforte esportata."

#: ../Views/SafeLockView.axaml:48
msgid "Safe locked!"
msgstr "Cassaforte bloccata!"

#: ../Views/ForcedOutfitPresetEditorView.axaml:169
msgid "Save"
msgstr "Salva"

#: ../Views/ChangeOutfitView.axaml:157
msgid "Save outfit"
msgstr "Salva outfit"

