#. {0} is the save name, {1} the technical error message
#: ../ViewModels/LoadGameViewModel.cs:146
#, csharp-format
msgid ""
"Could not load \"{0}\". The save file may be corrupted.\n"
"\n"
"{1}"
msgstr ""
"Impossibile caricare \"{0}\". Il file di salvataggio potrebbe essere "
"danneggiato.\n"
"\n"
"{1}"

