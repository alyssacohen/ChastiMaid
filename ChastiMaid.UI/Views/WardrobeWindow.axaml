<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChastiMaid.UI.ViewModels"
        x:Class="ChastiMaid.UI.Views.WardrobeWindow"
        x:DataType="vm:WardrobeViewModel"
        Title="Wardrobe Manager"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="AcrylicBlur" Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger" TintColor="Black" TintOpacity="0.8" MaterialOpacity="0.9" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <Grid ColumnDefinitions="300, *" Margin="20,50,20,20">
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,10,10,0">
                    <Button Content="ADD NEW ITEM" Command="{Binding AddNewItemCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="SAVE ALL CHANGES" Command="{Binding SaveChangesCommand}" Background="#2ECC71" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="DELETE SELECTED" Command="{Binding DeleteItemCommand}" Background="#E74C3C" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="#11FFFFFF" CornerRadius="8" Margin="0,0,10,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="5"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" Background="#11FFFFFF" CornerRadius="8" Padding="25">
                <ScrollViewer>
                    <StackPanel Spacing="10"
                                IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" >

                        <TextBlock Text="ITEM DETAILS" FontSize="20" FontWeight="Bold"/>
                        <StackPanel DataContext="{Binding SelectedItem}">
                            <Label Content="Item Name:"/>
                            <TextBox Text="{Binding Name}"/>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <Label Content="Weight:"/>
                                    <NumericUpDown Value="{Binding Weight}" Minimum="1" Maximum="100" FormatString="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <Label Content="Multiplier:"/>
                                    <NumericUpDown Value="{Binding Multiplier}" Increment="0.05" FormatString="0.00" />
                                </StackPanel>
                            </Grid>

                            <Label Content="Tags (comma separated):"/>
                            <TextBox Text="{Binding TagsText}" Watermark="e.g. leather, formal, restrictive"/>
                        </StackPanel>
                        <Separator Margin="0,10" Background="#22FFFFFF"/>

                        <TextBlock Text="Compatible layers" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding LayerOptions}">

                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,10,0"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Occupied slots" FontWeight="Bold" Margin="0,10,0,0"/>
                        <ItemsControl ItemsSource="{Binding SlotOptions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,10,0"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,15" Background="#22FFFFFF"/>

                        <TextBlock Text="Rules &amp; conditions" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Define what items must or cannot be worn with this." FontSize="10" Opacity="0.6" Margin="0,0,0,10"/>

                        <Grid ColumnDefinitions="*, *, Auto" Margin="0,0,0,10">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding RuleTypes}"
                                      SelectedItem="{Binding NewRuleType}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,5,0"
                                      Padding="5"/>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableTargets}"
                                      SelectedItem="{Binding NewRuleTarget}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,5,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name, FallbackValue='Unknown'}"
                                                   VerticalAlignment="Center"
                                                   Padding="5"
                                                   IsHitTestVisible="False" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="2" Content="✔" Command="{Binding AddRuleCommand}" HotKey="Enter"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding CurrentRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22000000" CornerRadius="4" Padding="8,4" Margin="0,0,0,5">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="✘"
                                                    Command="{Binding $parent[Window].((vm:WardrobeViewModel)DataContext).DeleteRuleCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#E74C3C"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Panel>
</Window>
