<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChastiMaid.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ChastiMaid.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ChastiMaid"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen"
        Width="450" Height="700">

    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="Black"
                    TintOpacity="0.6"
                    MaterialOpacity="0.70" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <ScrollViewer Margin="{Binding $parent[Window].OffScreenMargin}">
            <StackPanel Margin="30" Spacing="20">
                <StackPanel Background="Transparent" HorizontalAlignment="Stretch" Orientation="Horizontal">
                    <TextBlock Text="THE CHORES APP"
                           FontSize="28"
                           FontWeight="Heavy"
                           HorizontalAlignment="Center"
                           LetterSpacing="5"/>
                    <Border Width="0" HorizontalAlignment="Stretch" />

                    <Button Content="&#x2699;" HorizontalAlignment="Right" Height="32"
                            Command="{Binding OpenWardrobeCommand}" />
                </StackPanel>


                <Border Background="#22FFFFFF" CornerRadius="15" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Text="{Binding ElapsedTimeDisplay}"
                                   FontSize="42"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PlayerLevelDisplay}"
                                   HorizontalAlignment="Center"
                                   FontWeight="Light"/>
                    </StackPanel>
                </Border>
                <Grid ColumnDefinitions ="*,auto">
                    <TextBlock Text="OUTFIT OF THE DAY" FontWeight="Bold" Margin="0,10,0,0" Grid.Column="0"/>
                    <Button Content="REGENERATE" Grid.Column="1" Command="{Binding RegenerateOutfitCommand}"/>
                </Grid>
                <Border Background="#11FFFFFF" CornerRadius="10" Padding="15">
                    <TextBlock Text="{Binding DailyOutfitDescription}"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               LineHeight="25"/>
                </Border>

                <Button Content="START SESSION"
                        Command="{Binding StartActivityCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="15"
                        Background="{DynamicResource SystemAccentColor}"
                        CornerRadius="20"/>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</Window>
