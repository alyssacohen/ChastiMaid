<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChastiMaid.UI.ViewModels"
        x:Class="ChastiMaid.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        WindowState="FullScreen"
        SystemDecorations="None"
        CanResize="False">

    <Panel>

        <TransitioningContentControl Content="{Binding CurrentPage}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.5" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <Panel IsVisible="{Binding ShowConfirmOverlay}">
            <ExperimentalAcrylicBorder IsHitTestVisible="True">
                <ExperimentalAcrylicBorder.Material>
                    <ExperimentalAcrylicMaterial
                        BackgroundSource="None"
                        TintColor="Black"
                        TintOpacity="0.6"
                        MaterialOpacity="0.85" />
                </ExperimentalAcrylicBorder.Material>
            </ExperimentalAcrylicBorder>

            <Border Classes="GlassPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400"
                    Padding="30">
                <StackPanel Spacing="20">
                    <TextBlock Text="WARNING"
                               Classes="Header"
                               Foreground="{StaticResource DangerBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Starting a new session will reset all current progress. Your wardrobe will remain intact. Continue?"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <Grid ColumnDefinitions="*, *">
                        <Button Grid.Column="0" Content="CANCEL" Classes="KioskButton" Command="{Binding CancelNewSessionCommand}" Margin="5"/>
                        <Button Grid.Column="1" Content="YES, RESET" Classes="KioskButton" Command="{Binding ConfirmNewSessionCommand}" Background="{StaticResource DangerBrush}" Margin="5"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
