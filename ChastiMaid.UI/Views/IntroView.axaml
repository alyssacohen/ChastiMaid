<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.UI.ViewModels"
             x:Class="ChastiMaid.UI.Views.IntroView"
             x:DataType="vm:IntroViewModel">

    <Grid RowDefinitions="*, Auto, *">
        <StackPanel Grid.Row="1" Spacing="20" HorizontalAlignment="Center">
            <TextBlock Text="The Chores App"
                       Classes="Header"
                       HorizontalAlignment="Center"
                       FontSize="60" />

            <TextBlock Text="Welcome back. How would you like to proceed?"
                       HorizontalAlignment="Center"
                       Opacity="0.7"
                       FontSize="20"
                       Margin="0,0,0,40"/>

            <StackPanel Spacing="15" Width="400">

                <Button Classes="KioskButton Primary"
                        Command="{Binding ContinueSessionCommand}"
                        Height="80">
                    <StackPanel Orientation="Horizontal" Spacing="15">
                        <TextBlock Text="&#xf04b;" Classes="Icon" FontSize="24"/>
                        <TextBlock Text="CONTINUE..." FontSize="22" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="KioskButton"
                        Command="{Binding StartNewSessionCommand}"
                        Height="80">
                    <StackPanel Orientation="Horizontal" Spacing="15">
                        <TextBlock Text="&#xf067;" Classes="Icon" FontSize="24"/>
                        <TextBlock Text="NEW GAME" FontSize="22" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="KioskButton"
                        Command="{Binding ExitAppCommand}"
                        Margin="0,20,0,0"
                        Background="Transparent"
                        Foreground="{StaticResource DangerBrush}">
                    <TextBlock Text="CLOSE" />
                </Button>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="v 0.0.1 Alpha - Development Mode"
                   FontSize="12"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="20"
                   Opacity="0.3"/>
    </Grid>
</UserControl>
