<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.UI.ViewModels"
             x:Class="ChastiMaid.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Panel>
        <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
            <TextBlock Text="SESSION SETTINGS" Classes="Header" HorizontalAlignment="Center"/>

            <Border Classes="GlassPanel" Padding="20">
                <StackPanel Spacing="15">
                    <Button Classes="KioskButton" Command="{Binding OpenWardrobeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <TextBlock Text="&#xf559;" Classes="Icon"/>
                            <TextBlock Text="MANAGE WARDROBE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <CheckBox Content="Enable Advanced Rules" IsChecked="True"/>
                    <CheckBox Content="Auto-save Progress" IsChecked="True"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*, *">
                <Button Grid.Column="0" Content="BACK" Command="{Binding BackToIntroCommand}" Classes="KioskButton" Margin="5"/>
                <Button Grid.Column="1" Content="START SESSION" Command="{Binding StartDashboardCommand}" Classes="KioskButton Primary" Margin="5"/>
            </Grid>
        </StackPanel>

        <Panel IsVisible="{Binding IsWardrobeOpen}" Background="{StaticResource GlassBackgroundBrush}">
            <Border Classes="GlassPanel" Margin="40" Padding="20">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                        <TextBlock Text="WARDROBE MANAGER" Classes="Header"/>
                        <Button Grid.Column="1" Content="&#xf00d;" Classes="Icon"
                                Command="{Binding CloseWardrobeCommand}"
                                Background="Transparent" Foreground="{StaticResource DangerBrush}"/>
                    </Grid>

                    <ContentControl Content="{Binding WardrobeVM}"/>
                </DockPanel>
            </Border>
        </Panel>
    </Panel>
</UserControl>
