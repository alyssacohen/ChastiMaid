<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
          <StackPanel Spacing="8">
              <TextBlock Classes="heading" Text="This is a header" />
              <TextBlock Text="This is a text block" />
              <Button Content="Click Me" />
              <Button Classes="warning" Content="Warning" />
          </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Window, UserControl">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="WrapWithOverflow" />
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}" />
    </Style>

    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
    </Style>

    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MaxHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Placeholder text inside TextBox -->
    <Style Selector="TextBox /template/ TextBlock#PART_Placeholder">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    </Style>

    <!-- Dirty field highlighting -->
    <Style Selector="TextBox.dirty /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="Gold" />
    </Style>
    <Style Selector="NumericUpDown.dirty">
        <Setter Property="BorderBrush" Value="Gold" />
    </Style>
    <Style Selector="ComboBox.dirty">
        <Setter Property="BorderBrush" Value="Gold" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MaxHeight" Value="32" />
    </Style>

    <!-- Card style: consistent container for grouped controls -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeButton}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeButton}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="24,12" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Padding" Value="48,14" />
    </Style>

    <Style Selector="Button.compact">
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style Selector="Button.warning">
        <Setter Property="BorderBrush" Value="Red" />
        <Setter Property="Foreground" Value="Red" />
    </Style>

    <!-- Slot card button: transparent clickable area for load interaction -->
    <Style Selector="Button.slotCard">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.slotCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#20FFFFFF" />
    </Style>
    <Style Selector="Button.slotCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#30FFFFFF" />
    </Style>
    <Style Selector="Button.slotCard:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.slotCard:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

</Styles>
