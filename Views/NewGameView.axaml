<UserControl xmlns:ic="using:ChastiMaid.Views" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views.Dialogs"
             xmlns:controls="using:ChastiMaid.Views.Controls"
             x:DataType="vm:NewGameViewModel"
             x:Class="ChastiMaid.Views.NewGameView">

    <Panel>

        <Grid RowDefinitions="*,Auto">

            <!-- The contract itself scrolls; the action bar below stays pinned -->
            <ScrollViewer Grid.Row="0">
                <controls:ContractDocument DataContext="{Binding Clauses}" />
            </ScrollViewer>

            <Border Grid.Row="1" Classes="contractActionBar">
                <StackPanel Spacing="{StaticResource SpacingSm}">

                    <TextBlock Classes="BodySmall"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding StatusMessage}" />

                    <!-- Back sits apart and quiet; the three actions wrap under it when space runs out -->
                    <WrapPanel HorizontalAlignment="Center"
                               ItemSpacing="{StaticResource SpacingSm}"
                               LineSpacing="{StaticResource SpacingSm}">
                        <Button Classes="Quiet"
                                Command="{Binding BackCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.ArrowLeft}" />
                                <TextBlock Text="{l:Tr 'Back'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="Ghost"
                                Command="{Binding LoadContractCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.FolderOpen}" />
                                <TextBlock Text="{l:Tr 'Load another contract'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="Ghost"
                                Command="{Binding EditCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.PencilLine}" />
                                <TextBlock Text="{l:Tr 'Edit the terms'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="Primary"
                                Content="{l:Tr 'Accept the terms'}"
                                Command="{Binding AcceptCommand}" />
                    </WrapPanel>

                </StackPanel>
            </Border>

        </Grid>

        <views:ConfirmDialog
            DataContext="{Binding ActiveDialog}"
            IsVisible="{Binding $parent[UserControl].((vm:NewGameViewModel)DataContext).ActiveDialog,
                    Converter={x:Static ObjectConverters.IsNotNull},
                    FallbackValue=False}" />

    </Panel>

</UserControl>
