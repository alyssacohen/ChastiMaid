<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:NewGameViewModel"
             x:Class="ChastiMaid.Views.NewGameView">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="24"
                MaxWidth="480">

        <TextBlock Text="New Game"
                   Classes="h1"
                   HorizontalAlignment="Center" />

        <TextBlock Text="Choose your difficulty:"
                   HorizontalAlignment="Center"
                   Opacity="0.7" />

        <ItemsControl ItemsSource="{Binding Options}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DifficultyOptionViewModel">
                    <Button Command="{Binding $parent[ItemsControl].((vm:NewGameViewModel)DataContext).SelectCommand}"
                            CommandParameter="{Binding Difficulty}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="20,14"
                            Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="18" />
                            <TextBlock Grid.Column="1" Text="{Binding DebtRange}" Opacity="0.7" Margin="16,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding InterestRate}" Opacity="0.5" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Back"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Center"
                Padding="24,10"
                Margin="0,8,0,0" />

    </StackPanel>

</UserControl>
