<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views.Dialogs"
             xmlns:controls="using:ChastiMaid.Views.Controls"
             xmlns:conv="using:ChastiMaid.Converters"
             x:DataType="vm:NewGameViewModel"
             x:Class="ChastiMaid.Views.NewGameView">

    <Panel>

        <Grid RowDefinitions="*,Auto">

            <!-- The contract itself scrolls; the action bar below stays pinned -->
            <ScrollViewer Grid.Row="0">
                <controls:ContractDocument DataContext="{Binding Clauses}" />
            </ScrollViewer>

            <Border Grid.Row="1" Classes="contractActionBar">
                <StackPanel Spacing="{StaticResource SpacingSm}">

                    <TextBlock Classes="BodySmall"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding StatusMessage}" />

                    <!-- Back sits apart and quiet; the three actions wrap under it in portrait -->
                    <WrapPanel HorizontalAlignment="Center"
                               ItemSpacing="{StaticResource SpacingSm}"
                               LineSpacing="{StaticResource SpacingSm}">
                        <Button Classes="Quiet"
                                Content="{conv:Tr Back}"
                                Command="{Binding BackCommand}" />
                        <Button Classes="Ghost"
                                Content="{conv:Tr ContractLoad}"
                                Command="{Binding LoadContractCommand}" />
                        <Button Classes="Ghost"
                                Content="{conv:Tr ContractEdit}"
                                Command="{Binding EditCommand}" />
                        <Button Classes="Primary"
                                Content="{conv:Tr ContractAccept}"
                                Command="{Binding AcceptCommand}" />
                    </WrapPanel>

                </StackPanel>
            </Border>

        </Grid>

        <views:ConfirmDialog
            DataContext="{Binding ActiveDialog}"
            IsVisible="{Binding $parent[UserControl].((vm:NewGameViewModel)DataContext).ActiveDialog,
                    Converter={x:Static ObjectConverters.IsNotNull},
                    FallbackValue=False}" />

    </Panel>

</UserControl>
