<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:NewGameViewModel"
             x:Class="ChastiMaid.Views.NewGameView">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420"
                Margin="40"
                Spacing="16">

        <TextBlock Classes="PageTitle"
                   Text="New Game"
                   HorizontalAlignment="Center" />

        <TextBlock Classes="Subheading"
                   Text="Your game will start with these settings:"
                   HorizontalAlignment="Center" />

        <StackPanel Spacing="4">
            <TextBlock Classes="Body" HorizontalAlignment="Center">
                <Run Text="Initial debt: " Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding DebtRange}" />
            </TextBlock>
            <TextBlock Classes="Body" HorizontalAlignment="Center">
                <Run Text="Daily interest: " Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding InterestRate}" />
            </TextBlock>
        </StackPanel>

        <Button Content="Start Game"
                Command="{Binding StartGameCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Classes="Primary" />

        <Button Content="Settings"
                Command="{Binding SettingsCommand}"
                Classes="Ghost"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />

        <Button Content="Back"
                Command="{Binding BackCommand}"
                Classes="Ghost"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />

    </StackPanel>

</UserControl>
