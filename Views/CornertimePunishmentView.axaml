<UserControl xmlns:ic="using:ChastiMaid.Views" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:v="using:ChastiMaid.Views.Controls"
             x:DataType="vm:CornertimePunishmentViewModel"
             x:Class="ChastiMaid.Views.CornertimePunishmentView"
             Background="{DynamicResource BrushWindowBackground}">

    <Panel Margin="40">

        <!-- Framing: the preview fills the "*" row, so the page never needs to scroll -->
        <Grid IsVisible="{Binding IsFraming}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RowDefinitions="Auto,*,Auto">
            <StackPanel Classes="cameraText">
                <TextBlock Classes="PageTitle"
                           Text="{l:Tr 'The Corner Awaits'}"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="Body"
                           Text="{l:Tr 'Frame the corner in which you shall stand, then confirm when ready.'}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
            <v:WebcamPreviewControl Classes="cameraMedia between" Grid.Row="1" Service="{Binding Webcam}" />
            <StackPanel Classes="cameraText" Grid.Row="2">
                <ComboBox IsVisible="{Binding Webcam.HasMultipleCameras}"
                          ItemsSource="{Binding Webcam.AvailableCameras}"
                          SelectedItem="{Binding Webcam.SelectedCamera}"
                          HorizontalAlignment="Center"
                          MinWidth="240" />
                <Button Content="{l:Tr 'Begin'}"
                        Command="{Binding ConfirmFramingCommand}"
                        Classes="Primary"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Active -->
        <StackPanel IsVisible="{Binding IsActive}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600"
                    Spacing="16">
            <TextBlock Classes="EmployerVoice"
                       Text="{Binding NarrationText}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock Classes="NumberLarge"
                       Text="{Binding ElapsedDisplay}"
                       HorizontalAlignment="Center" />
            <TextBlock Classes="Caption"
                       Text="{Binding RequiredDisplay, StringFormat='of {0}'}"
                       HorizontalAlignment="Center" />
            <TextBlock Classes="Caption"
                       Text="{Binding MaxDisplay, StringFormat='max {0} if you keep moving'}"
                       HorizontalAlignment="Center" />
            <Button
                    Command="{Binding AbandonCommand}"
                    Classes="Danger compact"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.X}" />
                    <TextBlock Text="{l:Tr 'Abandon'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Result -->
        <StackPanel IsVisible="{Binding IsResult}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600"
                    Spacing="16">
            <TextBlock Classes="EmployerVoice"
                       Text="{Binding ResultMessage}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Content="{l:Tr 'Done'}"
                    Command="{Binding DoneCommand}"
                    Classes="Primary"
                    HorizontalAlignment="Center" />
        </StackPanel>

    </Panel>

</UserControl>
