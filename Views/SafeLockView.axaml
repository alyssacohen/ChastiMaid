<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:d="using:ChastiMaid.Views.Dialogs"
             xmlns:conv="using:ChastiMaid.Views.Converters"
             x:DataType="vm:SafeLockViewModel"
             x:Class="ChastiMaid.Views.SafeLockView">

    <Panel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600"
                    Margin="40"
                    Spacing="16">

            <TextBlock Classes="PageTitle"
                       Text="{conv:Tr SafeLockTitle}"
                       HorizontalAlignment="Center" />

            <!-- Initial: instructions + start camera -->
            <StackPanel Spacing="16" IsVisible="{Binding IsInitial}">
                <TextBlock Classes="EmployerVoice"
                           Text="{conv:Tr SafeLockInstructions}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <Button Content="{conv:Tr SafeLockStartCamera}"
                        Command="{Binding StartCameraCommand}"
                        HorizontalAlignment="Center"
                        Classes="Primary" />
                <Button Content="{conv:Tr SafeLockSkip}"
                        Command="{Binding SkipCommand}"
                        Classes="Ghost"
                        HorizontalAlignment="Center"
                        Opacity="0.6" />
            </StackPanel>

            <!-- Done -->
            <StackPanel Spacing="16" IsVisible="{Binding IsDone}" HorizontalAlignment="Center">
                <TextBlock Classes="Body"
                           Text="{conv:Tr SafeLockLockedMessage}"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="Caption"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="{conv:Tr SafeLockEncryptedNotice}" />
                <Button Content="{conv:Tr SafeLockStartSession}"
                        Command="{Binding ContinueCommand}"
                        HorizontalAlignment="Center"
                        Classes="Primary" />
            </StackPanel>

        </StackPanel>

        <!-- Webcam capture dialog overlay -->
        <ContentControl Content="{Binding ActiveDialog}"
                        IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:WebcamCaptureDialogViewModel">
                    <d:WebcamCaptureDialog />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Panel>

</UserControl>
