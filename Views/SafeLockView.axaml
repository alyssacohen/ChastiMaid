<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:d="using:ChastiMaid.Views.Dialogs"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:conv="using:ChastiMaid.Converters"
             x:DataType="vm:SafeLockViewModel"
             x:Class="ChastiMaid.Views.SafeLockView">

    <Panel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600"
                    Margin="40"
                    Spacing="16">

            <TextBlock Classes="PageTitle"
                       Text="{conv:Tr SafeLockTitle}"
                       HorizontalAlignment="Center" />

            <!-- Initial: instructions + start camera -->
            <StackPanel Spacing="16" IsVisible="{Binding !IsDone}">
                <TextBlock Classes="EmployerVoice"
                           Text="{conv:Tr SafeLockInstructions}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <Button Content="{conv:Tr SafeLockStartCamera}"
                        Command="{Binding StartCameraCommand}"
                        HorizontalAlignment="Center"
                        Classes="Primary" />
                <Button Content="{conv:Tr SafeLockSkip}"
                        Command="{Binding SkipCommand}"
                        Classes="Ghost"
                        HorizontalAlignment="Center"
                        Opacity="0.6" />
            </StackPanel>

            <!-- Done -->
            <StackPanel Spacing="16" IsVisible="{Binding IsDone}" HorizontalAlignment="Center">
                <TextBlock Classes="EmployerVoice"
                        Text="{conv:Tr SafeLockEncryptedNotice}"           
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <ic:SymbolIcon Symbol="LockClosed" IconVariant="Regular" FontSize="16" />
                    <TextBlock Classes="Body" Text="{conv:Tr SafeLockLockedMessage}" />
                </StackPanel>
                <Button Content="{conv:Tr SafeLockStartSession}"
                        Command="{Binding ContinueCommand}"
                        HorizontalAlignment="Center"
                        Classes="Primary" />
                <Button Content="{conv:Tr SafeLockRetryCapture}"
                        Command="{Binding StartCameraCommand}"
                        HorizontalAlignment="Center"
                        Classes="Ghost" />
            </StackPanel>

        </StackPanel>

        <!-- Webcam capture dialog overlay -->
        <ContentControl Content="{Binding ActiveDialog}"
                        IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:WebcamCaptureDialogViewModel">
                    <d:WebcamCaptureDialog />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Panel>

</UserControl>
