<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:d="using:ChastiMaid.Views.Dialogs"
             xmlns:ic="using:ChastiMaid.Views"
             x:DataType="vm:SafeLockViewModel"
             x:Class="ChastiMaid.Views.SafeLockView">

    <Panel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600"
                    Margin="40"
                    Spacing="16">

            <TextBlock Classes="PageTitle"
                       Text="{l:Tr 'Safe Lock'}"
                       HorizontalAlignment="Center" />

            <!-- Initial: instructions + start camera -->
            <StackPanel Spacing="16" IsVisible="{Binding !IsDone}">
                <TextBlock Classes="EmployerVoice"
                           Text="{l:Tr 'Place your distracting object inside the safe.&#10;Point the camera at the combination without looking at it.'}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <Button
                        Command="{Binding StartCameraCommand}"
                        HorizontalAlignment="Center"
                        Classes="Primary">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                        <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.Camera}" />
                        <TextBlock Text="{l:Tr 'Start Camera'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="{l:Tr 'Skip (no safe)'}"
                        Command="{Binding SkipCommand}"
                        Classes="Ghost"
                        HorizontalAlignment="Center"
                        Opacity="0.6" />
            </StackPanel>

            <!-- Done -->
            <StackPanel Spacing="16" IsVisible="{Binding IsDone}" HorizontalAlignment="Center">
                <TextBlock Classes="EmployerVoice"
                        Text="{l:Tr 'The combination photo has been encrypted and stored. You will only see it again when the game is complete or you choose to unlock the safe. You can retry to take the combination photo if you are not sure of the first try.'}"           
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}" HorizontalAlignment="Center">
                    <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.Lock}" />
                    <TextBlock Classes="Body" Text="{l:Tr 'Safe locked!'}" />
                </StackPanel>
                <Button
                        Command="{Binding ContinueCommand}"
                        HorizontalAlignment="Center"
                        Classes="Primary">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                        <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.Play}" />
                        <TextBlock Text="{l:Tr 'Start Session'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                        Command="{Binding StartCameraCommand}"
                        HorizontalAlignment="Center"
                        Classes="Ghost">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                        <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.RefreshCw}" />
                        <TextBlock Text="{l:Tr 'Retry Capture'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>

        <!-- Webcam capture dialog overlay -->
        <ContentControl Content="{Binding ActiveDialog}"
                        IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:WebcamCaptureDialogViewModel">
                    <d:WebcamCaptureDialog />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Panel>

</UserControl>
