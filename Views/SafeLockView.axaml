<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:d="using:ChastiMaid.Views.Dialogs"
             x:DataType="vm:SafeLockViewModel"
             x:Class="ChastiMaid.Views.SafeLockView">

    <Panel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600"
                    Margin="40"
                    Spacing="16">

            <TextBlock Classes="PageTitle"
                       Text="Safe Lock"
                       HorizontalAlignment="Center" />

            <!-- Initial: instructions + start camera -->
            <StackPanel Spacing="16" IsVisible="{Binding IsInitial}">
                <TextBlock Classes="EmployerVoice"
                           Text="Place your distracting object inside the safe.&#10;Point the camera at the combination without looking at it."
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <Button Content="Start Camera"
                        Command="{Binding StartCameraCommand}"
                        HorizontalAlignment="Center"
                        Classes="Primary" />
                <Button Content="Skip (no safe)"
                        Command="{Binding SkipCommand}"
                        Classes="Ghost"
                        HorizontalAlignment="Center"
                        Opacity="0.6" />
            </StackPanel>

            <!-- Done -->
            <StackPanel Spacing="16" IsVisible="{Binding IsDone}" HorizontalAlignment="Center">
                <TextBlock Classes="Body"
                           Text="🔒 Safe locked!"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="Caption"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="The combination photo has been encrypted and stored. You will only see it again when the game is complete or you choose to unlock the safe." />
                <Button Content="Start Session"
                        Command="{Binding ContinueCommand}"
                        HorizontalAlignment="Center"
                        Classes="Primary" />
            </StackPanel>

        </StackPanel>

        <!-- Webcam capture dialog overlay -->
        <ContentControl Content="{Binding ActiveDialog}"
                        IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:WebcamCaptureDialogViewModel">
                    <d:WebcamCaptureDialog />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Panel>

</UserControl>
