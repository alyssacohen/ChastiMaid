<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:v="using:ChastiMaid.Views"
             x:DataType="vm:SafeLockViewModel"
             x:Class="ChastiMaid.Views.SafeLockView">

    <StackPanel Classes="pageContent" MaxWidth="600">

        <TextBlock Text="Safe Lock" Classes="pageTitle" />

        <!-- Initial: instructions + start camera -->
        <StackPanel Spacing="16" IsVisible="{Binding IsInitial}">
            <TextBlock Classes="subtitle"
                       Text="Place your distracting object inside the safe.&#10;Point the camera at the combination without looking at it." />
            <Button Content="Start Camera"
                    Command="{Binding StartCameraCommand}"
                    HorizontalAlignment="Center" Classes="primary" />
            <Button Content="Skip (no safe)"
                    Command="{Binding SkipCommand}"
                    HorizontalAlignment="Center" Opacity="0.6" />
        </StackPanel>

        <!-- Preview: webcam + Capture -->
        <StackPanel Spacing="16" IsVisible="{Binding IsPreviewing}" HorizontalAlignment="Center">
            <TextBlock Text="Point the camera at the combination, then press Capture."
                       HorizontalAlignment="Center" Classes="muted" TextAlignment="Center" />
            <v:WebcamPreviewControl Service="{Binding Webcam}" Width="480" Height="360" />
            <Button Content="📸 Capture"
                    Command="{Binding CaptureCommand}"
                    HorizontalAlignment="Center" Classes="primary" />
            <Button Content="Skip (no safe)"
                    Command="{Binding SkipCommand}"
                    HorizontalAlignment="Center" Opacity="0.6" />
        </StackPanel>

        <!-- No webcam -->
        <StackPanel Spacing="16" IsVisible="{Binding NoWebcam}" HorizontalAlignment="Center">
            <TextBlock Text="No webcam detected." HorizontalAlignment="Center" Classes="muted" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Classes="muted"
                       Text="The combination photo cannot be captured. You can continue without locking the safe." />
            <Button Content="Continue without safe"
                    Command="{Binding SkipCommand}"
                    HorizontalAlignment="Center" Classes="primary" />
        </StackPanel>

        <!-- Done -->
        <StackPanel Spacing="16" IsVisible="{Binding IsDone}" HorizontalAlignment="Center">
            <TextBlock Text="🔒 Safe locked!" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Classes="muted"
                       Text="The combination photo has been encrypted and stored. You will only see it again when the game is complete or you choose to unlock the safe." />
            <Button Content="Start Session"
                    Command="{Binding ContinueCommand}"
                    HorizontalAlignment="Center" Classes="primary" />
        </StackPanel>

    </StackPanel>

</UserControl>
