<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:conv="using:ChastiMaid.Views.Converters"
             x:DataType="vm:EndSessionViewModel"
             x:Class="ChastiMaid.Views.EndSessionView">

    <Panel>

        <!-- Choice screen -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420"
                    Margin="40"
                    Spacing="16"
                    IsVisible="{Binding !ShowingCombo}">

            <TextBlock Classes="PageTitle"
                       Text="{conv:Tr DashboardEndSession}"
                       HorizontalAlignment="Center" />

            <TextBlock Classes="Body"
                       Text="{conv:Tr EndSessionConfirmQuestion}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <StackPanel Spacing="12">
                <Button Content="{conv:Tr EndSessionShowComboAndClose}"
                        Command="{Binding ShowComboAndCloseCommand}"
                        IsVisible="{Binding HasSafeCombo}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="Amber" />

                <TextBlock Classes="Caption"
                           Text="{conv:Tr EndSessionInterestNotice}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           IsVisible="{Binding HasSafeCombo}" />

                <Button Content="{conv:Tr EndSessionCloseWithoutCombo}"
                        Command="{Binding CloseWithoutComboCommand}"
                        Classes="Ghost"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

                <Button Content="{conv:Tr Cancel}"
                        Command="{Binding CancelCommand}"
                        Classes="Ghost"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,12,0,0" />
            </StackPanel>

        </StackPanel>

        <!-- Combo revealed screen -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600"
                    Margin="40"
                    Spacing="16"
                    IsVisible="{Binding ShowingCombo}">

            <TextBlock Classes="SectionTitle"
                       Text="{conv:Tr EndSessionYourCombo}"
                       HorizontalAlignment="Center" />

            <Image Source="{Binding ComboImage}"
                   MaxHeight="400"
                   Stretch="Uniform"
                   HorizontalAlignment="Center" />

            <TextBlock Classes="Caption"
                       Text="{conv:Tr EndSessionComboSavedNotice}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <Button Content="{conv:Tr EndSessionCloseApp}"
                    Command="{Binding ConfirmCloseCommand}"
                    HorizontalAlignment="Center"
                    Classes="Primary" />

        </StackPanel>

    </Panel>

</UserControl>