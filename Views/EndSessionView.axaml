<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:EndSessionViewModel"
             x:Class="ChastiMaid.Views.EndSessionView">

    <Panel>

        <!-- Choice screen -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420"
                    Margin="40"
                    Spacing="16"
                    IsVisible="{Binding !ShowingCombo}">

            <TextBlock Classes="PageTitle"
                       Text="End Session"
                       HorizontalAlignment="Center" />

            <TextBlock Classes="Body"
                       Text="Are you sure you want to end this session?"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <StackPanel Spacing="12">
                <Button Content="Show Safe Combination and Close"
                        Command="{Binding ShowComboAndCloseCommand}"
                        IsVisible="{Binding HasSafeCombo}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="Amber" />

                <TextBlock Classes="Caption"
                           Text="A daily interest will be applied until you resume your session."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           IsVisible="{Binding HasSafeCombo}" />

                <Button Content="Close Without Combination"
                        Command="{Binding CloseWithoutComboCommand}"
                        Classes="Ghost"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Classes="Ghost"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,12,0,0" />
            </StackPanel>

        </StackPanel>

        <!-- Combo revealed screen -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600"
                    Margin="40"
                    Spacing="16"
                    IsVisible="{Binding ShowingCombo}">

            <TextBlock Classes="SectionTitle"
                       Text="Your Safe Combination"
                       HorizontalAlignment="Center" />

            <Image Source="{Binding ComboImage}"
                   MaxHeight="400"
                   Stretch="Uniform"
                   HorizontalAlignment="Center" />

            <TextBlock Classes="Caption"
                       Text="The combination has been saved alongside your session media."
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <Button Content="Close Application"
                    Command="{Binding ConfirmCloseCommand}"
                    HorizontalAlignment="Center"
                    Classes="Primary" />

        </StackPanel>

    </Panel>

</UserControl>
