<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:EndSessionViewModel"
             x:Class="ChastiMaid.Views.EndSessionView">

    <Panel>
        <!-- Choice screen -->
        <StackPanel Classes="pageContent" IsVisible="{Binding !ShowingCombo}">

            <TextBlock Text="End Session" Classes="pageTitle" />

            <TextBlock Text="Are you sure you want to end this session?"
                       Classes="subtitle" />

            <StackPanel Spacing="12">
                <Button Content="Show Safe Combination and Close"
                        Command="{Binding ShowComboAndCloseCommand}"
                        IsVisible="{Binding HasSafeCombo}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="amber" />

                <TextBlock Text="A daily interest will be applied until you resume your session."
                           Classes="small muted"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           IsVisible="{Binding HasSafeCombo}" />

                <Button Content="Close Without Combination"
                        Command="{Binding CloseWithoutComboCommand}"
                        Classes="secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Classes="secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,12,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Combo revealed screen -->
        <StackPanel Classes="pageContent" MaxWidth="600" IsVisible="{Binding ShowingCombo}">

            <TextBlock Text="Your Safe Combination" Classes="subtitle" />

            <Image Source="{Binding ComboImage}"
                   MaxHeight="400"
                   Stretch="Uniform"
                   HorizontalAlignment="Center" />

            <TextBlock Text="The combination has been saved alongside your session media."
                       Classes="small muted"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <Button Content="Close Application"
                    Command="{Binding ConfirmCloseCommand}"
                    HorizontalAlignment="Center"
                    Classes="primary" />
        </StackPanel>
    </Panel>

</UserControl>
