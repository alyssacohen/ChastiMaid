<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.Controls.WardrobeToolbar">

    <Border Background="{DynamicResource BrushSurfaceBase}" Padding="20,4">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">

            <TextBox Grid.Column="0"
                     Text="{Binding WardrobeNameFilter}"
                     PlaceholderText="Filter by name or tag…"
                     Width="240"
                     MinHeight="44"
                     VerticalContentAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Classes="Body"
                       Text="Layer:"
                       VerticalAlignment="Center"
                       Margin="16,0,8,0" />

            <ItemsControl Grid.Column="2"
                          ItemsSource="{Binding LayerFilterChips}"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:LayerFilterChipVm">
                        <ToggleButton Classes="filterChip"
                                      Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsActive}"
                                      Command="{Binding SelectCommand}"
                                      Margin="0,0,4,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
            <Button Grid.Column="4"
                    Classes="Primary"
                    Content="+ Add item"
                    Command="{Binding AddWardrobeItemCommand}"
                    MinHeight="44"
                    VerticalAlignment="Center" />
            -->

        </Grid>
    </Border>

</UserControl>
