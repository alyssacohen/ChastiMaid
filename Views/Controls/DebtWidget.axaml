<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChastiMaid.Views.Controls.DebtWidget"
             x:Name="Root">

    <Border Classes="card" Margin="0">
        <StackPanel Spacing="10">

            <TextBlock Classes="SectionTitle" Text="Outstanding Balance" />

            <Grid ColumnDefinitions="*,*">

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="LabelUI" Text="SETTLED" />
                    <TextBlock Classes="NumberLarge"
                               Text="{Binding #Root.DebtSettled, StringFormat='${0:F2}'}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                    <TextBlock Classes="LabelUI" Text="REMAINING"
                               HorizontalAlignment="Right" />
                    <TextBlock Classes="NumberLarge"
                               Text="{Binding #Root.DebtRemaining, StringFormat='${0:F2}'}"
                               HorizontalAlignment="Right" />
                </StackPanel>

            </Grid>

            <ProgressBar Minimum="0" Maximum="1"
                         Value="{Binding #Root.DebtProgress}"
                         Height="6"
                         Foreground="{DynamicResource TextPrimary}"
                         Background="{DynamicResource BrushSurfaceMuted}"
                         CornerRadius="3" />

            <TextBlock Classes="Caption"
                       Text="{Binding #Root.DebtTotal, StringFormat='Total incurred: ${0:F2}'}" />

        </StackPanel>
    </Border>

</UserControl>
