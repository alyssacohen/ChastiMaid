<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:ChastiMaid.Views.Converters"
             x:Class="ChastiMaid.Views.Controls.DebtWidget"
             x:Name="Root">

    <Border Classes="card" Margin="0">
        <StackPanel Spacing="10">

            <TextBlock Classes="SectionTitle" Text="{conv:Tr DebtWidgetTitle}" />

            <Grid ColumnDefinitions="*,*">

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="LabelUI" Text="{conv:UpperCase {conv:Tr DebtWidgetSettled}}" />
                    <TextBlock Classes="NumberLarge"
                               Text="{Binding #Root.DebtSettled, Converter={x:Static conv:CurrencyConverter.Instance}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                    <TextBlock Classes="LabelUI" Text="{conv:UpperCase {conv:Tr DebtWidgetRemaining}}"
                               HorizontalAlignment="Right" />
                    <TextBlock Classes="NumberLarge"
                               Text="{Binding #Root.DebtRemaining, Converter={x:Static conv:CurrencyConverter.Instance}}"
                               HorizontalAlignment="Right" />
                </StackPanel>

            </Grid>

            <ProgressBar Minimum="0" Maximum="1"
                         Value="{Binding #Root.DebtProgress}"
                         Height="6"
                         Foreground="{DynamicResource TextPrimary}"
                         Background="{DynamicResource BrushSurfaceMuted}"
                         CornerRadius="3" />

            <TextBlock Classes="Caption"
                       Text="{Binding #Root.DebtTotal, StringFormat={conv:Tr DebtWidgetTotalIncurredFormat}}" />

        </StackPanel>
    </Border>

</UserControl>