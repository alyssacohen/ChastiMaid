<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:converters="using:ChastiMaid.Views.Converters"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.Controls.SettingsPermissionsTab">

    <Grid RowDefinitions="Auto,*" Margin="0,0,0,16">
        <StackPanel Grid.Row="0" Margin="24,0,32,0">
            <TextBlock Classes="SectionTitle" Text="{converters:Tr SettingsTabPermissions}" Margin="0,20,0,8" />
            <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,8" />
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" Margin="24,0,32,0">
                <ItemsControl ItemsSource="{Binding PermissionTypes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PermissionTypeEditViewModel">
                            <Border Classes="card" Margin="0,0,0,12">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="Heading" Text="{Binding Name}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="BodySmall" Text="{converters:Tr PermissionColumnProbability}"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner compact"
                                                       Value="{Binding BaseGrantPercent, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0}"
                                                       Minimum="0" Maximum="100" FormatString="0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="BodySmall" Text="{converters:Tr PermissionColumnDuration}"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner compact"
                                                       Value="{Binding DurationMinutes, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}"
                                                       Minimum="1" FormatString="0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="BodySmall" Text="{converters:Tr PermissionColumnCooldown}"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner compact"
                                                       Value="{Binding CooldownMinutes, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}"
                                                       Minimum="1" FormatString="0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
