<UserControl
    x:Class="ChastiMaid.Views.Controls.DashboardIdlePopupOverlay"
    x:DataType="vm:DashboardViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="using:ChastiMaid.Views.Controls"
    xmlns:vm="using:ChastiMaid.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ChastiMaid.Localization">

    <Panel
        Classes="dialogOverlay"
        IsVisible="{Binding IsPopupVisible}"
        PointerPressed="OnOverlayPointerPressed">
        <Border
            Classes="dialogBox"
            MaxHeight="{Binding PopupDialogMaxHeight}"
            MaxWidth="500"
            PointerPressed="OnDialogBoxPointerPressed">
            <Panel>
                <StackPanel IsVisible="{Binding IsShowingQuestionPanel}" Spacing="16">
                    <!-- Camera list outlives the popup that filled it, so the selector must share the preview's gate. -->
                    <StackPanel IsVisible="{Binding IsWebcamPreviewNeededInQuestionPanel}" Spacing="16">
                        <controls:WebcamPreviewControl
                            Height="{Binding PopupPreviewHeight}"
                            HorizontalAlignment="Center"
                            Service="{Binding Webcam}"
                            Stretch="UniformToFill"
                            Width="{Binding PopupPreviewWidth}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding Webcam.HasMultipleCameras}"
                            ItemsSource="{Binding Webcam.AvailableCameras}"
                            SelectedItem="{Binding Webcam.SelectedCamera}" />
                    </StackPanel>
                    <Image
                        Height="{Binding PopupPreviewHeight}"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsSelfCheckPopupActive}"
                        Source="{Binding SelfCheckPhoto}"
                        Stretch="Uniform"
                        Width="{Binding PopupPreviewWidth}" />
                    <TextBlock
                        Classes="Body"
                        HorizontalAlignment="Center"
                        Text="{Binding PopupQuestion}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding PopupAnswers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button
                                    Classes="Ghost"
                                    Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).AnswerCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Margin="0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel IsVisible="{Binding IsPoseCountdownActive}" Spacing="16">
                    <controls:WebcamPreviewControl
                        Height="{Binding PopupPreviewHeight}"
                        HorizontalAlignment="Center"
                        Service="{Binding Webcam}"
                        Stretch="UniformToFill"
                        Width="{Binding PopupPreviewWidth}" />
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{l:Tr 'Hold your pose.'}"
                        TextAlignment="Center" />
                    <TextBlock
                        Classes="NumberLarge"
                        HorizontalAlignment="Center"
                        Text="{Binding PoseCountdown}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsPoseCapturing}" Spacing="16">
                    <controls:WebcamPreviewControl
                        Height="{Binding PopupPreviewHeight}"
                        HorizontalAlignment="Center"
                        Service="{Binding Webcam}"
                        Stretch="UniformToFill"
                        Width="{Binding PopupPreviewWidth}" />
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{l:Tr 'Hold still.'}"
                        TextAlignment="Center" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsCurtsyCountdownActive}" Spacing="16">
                    <controls:WebcamPreviewControl
                        Height="{Binding PopupPreviewHeight}"
                        HorizontalAlignment="Center"
                        Service="{Binding Webcam}"
                        Stretch="UniformToFill"
                        Width="{Binding PopupPreviewWidth}" />
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{l:Tr 'Prepare yourself.'}"
                        TextAlignment="Center" />
                    <TextBlock
                        Classes="NumberLarge"
                        HorizontalAlignment="Center"
                        Text="{Binding CurtsyCountdown}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsCurtsyRecordingActive}" Spacing="16">
                    <controls:WebcamPreviewControl
                        Height="{Binding PopupPreviewHeight}"
                        HorizontalAlignment="Center"
                        Service="{Binding Webcam}"
                        Stretch="UniformToFill"
                        Width="{Binding PopupPreviewWidth}" />
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{l:Tr 'Recording now.'}"
                        TextAlignment="Center" />
                    <TextBlock
                        Classes="NumberLarge"
                        HorizontalAlignment="Center"
                        Text="{Binding CurtsyRecordingSecondsLeft}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsQuoteListeningActive}" Spacing="16">
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{l:Tr 'I am listening.'}"
                        TextAlignment="Center" />
                    <TextBlock
                        Classes="Body"
                        HorizontalAlignment="Center"
                        Text="{Binding PopupQuestion}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border Classes="statCard" HorizontalAlignment="Stretch">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{Binding CurrentQuoteText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                    <TextBlock
                        Classes="NumberLarge"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding !IsQuoteProcessing}"
                        Text="{Binding QuoteListenCountdown}" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsQuoteProcessing}"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Ellipse
                            Fill="{DynamicResource BrushStatusIdle}"
                            Height="10"
                            Width="10" />
                        <TextBlock Classes="BodySmall" Text="{l:Tr 'One moment — I am considering what was said.'}" />
                    </StackPanel>
                    <TextBlock
                        Classes="Caption"
                        HorizontalAlignment="Center"
                        Text="{Binding QuoteAttemptsRemainingText}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsQuoteTypingActive}" Spacing="16">
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{l:Tr 'The microphone is not to be found. You will write it instead.'}"
                        TextAlignment="Center" />
                    <TextBlock
                        Classes="Body"
                        HorizontalAlignment="Center"
                        Text="{Binding PopupQuestion}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border Classes="statCard" HorizontalAlignment="Stretch">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{Binding CurrentQuoteText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                    <TextBox
                        Classes="underline"
                        PlaceholderText="{l:Tr 'Type the quotation here'}"
                        Text="{Binding QuoteTypedAnswer}" />
                    <TextBlock
                        Classes="Caption"
                        HorizontalAlignment="Center"
                        Text="{Binding QuoteAttemptsRemainingText}" />
                    <Button
                        Classes="Ghost"
                        Command="{Binding SubmitQuoteTypedAnswerCommand}"
                        Content="{l:Tr 'Submit'}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsKneelFramingActive}" Spacing="16">
                    <controls:WebcamPreviewControl
                        Height="{Binding PopupPreviewHeight}"
                        HorizontalAlignment="Center"
                        Service="{Binding Webcam}"
                        Stretch="UniformToFill"
                        Width="{Binding PopupPreviewWidth}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding Webcam.HasMultipleCameras}"
                        ItemsSource="{Binding Webcam.AvailableCameras}"
                        SelectedItem="{Binding Webcam.SelectedCamera}" />
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{l:Tr 'Position the camera to frame where you shall kneel.'}"
                        TextAlignment="Center" />
                    <Button
                        Classes="Ghost"
                        Command="{Binding ConfirmKneelFramingCommand}"
                        Content="{l:Tr 'Position confirmed'}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsKneelActive}" Spacing="16">
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{Binding PopupQuestion}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="NumberDisplay"
                        HorizontalAlignment="Center"
                        Text="{Binding KneelCountdown}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsShowingPopupOutcome}" Spacing="16">
                    <Image
                        Height="{Binding PopupPreviewHeight}"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding CapturedPosePhoto, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Source="{Binding CapturedPosePhoto}"
                        Stretch="UniformToFill"
                        Width="{Binding PopupPreviewWidth}" />
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{Binding PopupOutcomeMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Panel>
        </Border>
    </Panel>
</UserControl>
