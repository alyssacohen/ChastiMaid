<UserControl
    x:Class="ChastiMaid.Views.Controls.DashboardIdlePopupOverlay"
    x:DataType="vm:DashboardViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="using:ChastiMaid.Views.Controls"
    xmlns:vm="using:ChastiMaid.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ChastiMaid.Localization">

    <!-- Popups with a camera picture are a Grid: the picture fills the "*" row, so it gets every pixel the
         texts below leave on screen and the box never needs to scroll. -->
    <Panel
        Classes="dialogOverlay"
        IsVisible="{Binding IsPopupVisible}"
        PointerPressed="OnOverlayPointerPressed">
        <Border
            Classes="dialogBox fit"
            Margin="{StaticResource SpacingXxlThickness}"
            PointerPressed="OnDialogBoxPointerPressed">
            <Panel>
                <Grid IsVisible="{Binding IsShowingQuestionPanel}" RowDefinitions="*,Auto">
                    <Panel>
                        <controls:WebcamPreviewControl
                            Classes="cameraMedia"
                            IsVisible="{Binding IsWebcamPreviewNeededInQuestionPanel}"
                            Service="{Binding Webcam}" />
                        <Image
                            Classes="cameraMedia"
                            IsVisible="{Binding IsSelfCheckPopupActive}"
                            Source="{Binding SelfCheckPhoto}"
                            Stretch="Uniform" />
                    </Panel>
                    <StackPanel Classes="cameraText" Grid.Row="1">
                        <!-- Camera list outlives the popup that filled it, so the selector must share the preview's gate. -->
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Webcam.AvailableCameras}"
                            SelectedItem="{Binding Webcam.SelectedCamera}">
                            <ComboBox.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsWebcamPreviewNeededInQuestionPanel" />
                                    <Binding Path="Webcam.HasMultipleCameras" />
                                </MultiBinding>
                            </ComboBox.IsVisible>
                        </ComboBox>
                        <TextBlock
                            Classes="Body"
                            HorizontalAlignment="Center"
                            Text="{Binding PopupQuestion}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding PopupAnswers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button
                                        Classes="Ghost"
                                        Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).AnswerCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                <Grid IsVisible="{Binding IsPoseCountdownActive}" RowDefinitions="*,Auto">
                    <controls:WebcamPreviewControl Classes="cameraMedia" Service="{Binding Webcam}" />
                    <StackPanel Classes="cameraText" Grid.Row="1">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{l:Tr 'Hold your pose.'}"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="NumberLarge"
                            HorizontalAlignment="Center"
                            Text="{Binding PoseCountdown}" />
                    </StackPanel>
                </Grid>
                <Grid IsVisible="{Binding IsPoseCapturing}" RowDefinitions="*,Auto">
                    <controls:WebcamPreviewControl Classes="cameraMedia" Service="{Binding Webcam}" />
                    <StackPanel Classes="cameraText" Grid.Row="1">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{l:Tr 'Hold still.'}"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid IsVisible="{Binding IsCurtsyCountdownActive}" RowDefinitions="*,Auto">
                    <controls:WebcamPreviewControl Classes="cameraMedia" Service="{Binding Webcam}" />
                    <StackPanel Classes="cameraText" Grid.Row="1">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{l:Tr 'Prepare yourself.'}"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="NumberLarge"
                            HorizontalAlignment="Center"
                            Text="{Binding CurtsyCountdown}" />
                    </StackPanel>
                </Grid>
                <Grid IsVisible="{Binding IsCurtsyRecordingActive}" RowDefinitions="*,Auto">
                    <controls:WebcamPreviewControl Classes="cameraMedia" Service="{Binding Webcam}" />
                    <StackPanel Classes="cameraText" Grid.Row="1">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{l:Tr 'Recording now.'}"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="NumberLarge"
                            HorizontalAlignment="Center"
                            Text="{Binding CurtsyRecordingSecondsLeft}" />
                    </StackPanel>
                </Grid>
                <StackPanel Classes="cameraText" IsVisible="{Binding IsQuoteListeningActive}">
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{l:Tr 'I am listening.'}"
                        TextAlignment="Center" />
                    <TextBlock
                        Classes="Body"
                        HorizontalAlignment="Center"
                        Text="{Binding PopupQuestion}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border Classes="statCard" HorizontalAlignment="Stretch">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{Binding CurrentQuoteText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                    <TextBlock
                        Classes="NumberLarge"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding !IsQuoteProcessing}"
                        Text="{Binding QuoteListenCountdown}" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsQuoteProcessing}"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Ellipse
                            Fill="{DynamicResource BrushStatusIdle}"
                            Height="10"
                            Width="10" />
                        <TextBlock Classes="BodySmall" Text="{l:Tr 'One moment — I am considering what was said.'}" />
                    </StackPanel>
                    <TextBlock
                        Classes="Caption"
                        HorizontalAlignment="Center"
                        Text="{Binding QuoteAttemptsRemainingText}" />
                </StackPanel>
                <StackPanel Classes="cameraText" IsVisible="{Binding IsQuoteTypingActive}">
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{l:Tr 'The microphone is not to be found. You will write it instead.'}"
                        TextAlignment="Center" />
                    <TextBlock
                        Classes="Body"
                        HorizontalAlignment="Center"
                        Text="{Binding PopupQuestion}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border Classes="statCard" HorizontalAlignment="Stretch">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{Binding CurrentQuoteText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                    <TextBox
                        Classes="underline"
                        PlaceholderText="{l:Tr 'Type the quotation here'}"
                        Text="{Binding QuoteTypedAnswer}" />
                    <TextBlock
                        Classes="Caption"
                        HorizontalAlignment="Center"
                        Text="{Binding QuoteAttemptsRemainingText}" />
                    <Button
                        Classes="Ghost"
                        Command="{Binding SubmitQuoteTypedAnswerCommand}"
                        Content="{l:Tr 'Submit'}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                </StackPanel>
                <Grid IsVisible="{Binding IsKneelFramingActive}" RowDefinitions="*,Auto">
                    <controls:WebcamPreviewControl Classes="cameraMedia" Service="{Binding Webcam}" />
                    <StackPanel Classes="cameraText" Grid.Row="1">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding Webcam.HasMultipleCameras}"
                            ItemsSource="{Binding Webcam.AvailableCameras}"
                            SelectedItem="{Binding Webcam.SelectedCamera}" />
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{l:Tr 'Position the camera to frame where you shall kneel.'}"
                            TextAlignment="Center" />
                        <Button
                            Classes="Ghost"
                            Command="{Binding ConfirmKneelFramingCommand}"
                            Content="{l:Tr 'Position confirmed'}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
                <StackPanel Classes="cameraText" IsVisible="{Binding IsKneelActive}">
                    <TextBlock
                        Classes="EmployerVoice"
                        HorizontalAlignment="Center"
                        Text="{Binding PopupQuestion}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="NumberDisplay"
                        HorizontalAlignment="Center"
                        Text="{Binding KneelCountdown}" />
                </StackPanel>
                <Grid IsVisible="{Binding IsShowingPopupOutcome}" RowDefinitions="*,Auto">
                    <Image
                        Classes="cameraMedia"
                        IsVisible="{Binding CapturedPosePhoto, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Source="{Binding CapturedPosePhoto}"
                        Stretch="Uniform" />
                    <StackPanel Classes="cameraText" Grid.Row="1">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{Binding PopupOutcomeMessage}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>
    </Panel>
</UserControl>
