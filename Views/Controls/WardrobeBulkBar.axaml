<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.Controls.WardrobeBulkBar">

    <Border Background="{DynamicResource PrimaryTextBrush}"
            MinHeight="44">
        <Grid ColumnDefinitions="*,Auto"
              VerticalAlignment="Center"
              Margin="16,0">

            <TextBlock Grid.Column="0"
                       Text="{Binding WardrobeSelectedCount, StringFormat='{}{0} items selected'}"
                       Foreground="{DynamicResource PageBackgroundBrush}"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Classes="danger compact"
                    Content="Delete selected"
                    Command="{Binding DeleteSelectedWardrobeItemsCommand}"
                    VerticalAlignment="Center" />

        </Grid>
    </Border>

</UserControl>
