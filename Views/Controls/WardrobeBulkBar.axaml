<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:conv="using:ChastiMaid.Views.Converters"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.Controls.WardrobeBulkBar">

    <Border Background="{DynamicResource TextPrimary}"
            MinHeight="44">
        <Grid ColumnDefinitions="*,Auto"
              VerticalAlignment="Center"
              Margin="16,0">

            <TextBlock Grid.Column="0"
                       Text="{Binding WardrobeSelectedCount, StringFormat={conv:Tr WardrobeBulkSelectedFormat}}"
                       Foreground="{DynamicResource BrushWindowBackground}"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Classes="Danger compact"
                    Content="{conv:Tr WardrobeBulkDeleteSelected}"
                    Command="{Binding DeleteSelectedWardrobeItemsCommand}"
                    VerticalAlignment="Center" />

        </Grid>
    </Border>

</UserControl>