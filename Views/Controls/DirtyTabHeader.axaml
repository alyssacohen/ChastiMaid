<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChastiMaid.Views.Controls.DirtyTabHeader"
             x:Name="Root">

    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Classes="Body" Text="{Binding #Root.Text}"
                   IsVisible="{Binding !#Root.IsDirty}" />
        <TextBlock Classes="Body" Text="{Binding #Root.Text}"
                   Foreground="{DynamicResource BrushAmber}"
                   IsVisible="{Binding #Root.IsDirty}" />
        <Ellipse Width="6" Height="6"
                 Fill="{DynamicResource BrushAmber}"
                 VerticalAlignment="Center"
                 IsVisible="{Binding #Root.IsDirty}" />
    </StackPanel>

</UserControl>
