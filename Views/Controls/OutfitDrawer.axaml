<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:conv="using:ChastiMaid.Views.Converters"
             x:Class="ChastiMaid.Views.Controls.OutfitDrawer"
             x:Name="DrawerRoot">

    <Panel>

        <!-- Scrim: tapping it closes the drawer -->
        <Button Click="OnScrimClick"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="0"
                CornerRadius="0">
            <Button.Template>
                <ControlTemplate>
                    <Panel Background="#47000000"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Drawer panel: 290px, right-anchored -->
        <Border Width="290"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{DynamicResource BrushWindowBackground}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="1,0,0,0">

            <DockPanel>

                <!-- Header -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource BrushSurfaceBase}"
                        Height="52"
                        Padding="16,0,12,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Classes="SectionTitle"
                                   Text="{conv:Tr OutfitDrawerTitle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Click="OnScrimClick"
                                Width="32" Height="32"
                                Padding="0"
                                CornerRadius="16"
                                Classes="Ghost"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{conv:Tr OutfitDrawerCloseTooltip}">
                            <TextBlock Text="✕" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Layer list -->
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding #DrawerRoot.Layers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OutfitLayerViewModel">
                                <StackPanel>
                                    <StackPanel Spacing="2" Margin="16,12">

                                        <TextBlock Classes="LabelUI"
                                                   Text="{Binding LayerLabel, Converter={x:Static conv:UpperCaseConverter.Instance}}"
                                                   Opacity="0.7" />

                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      IsVisible="{Binding HasItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OutfitLayerItem">
                                                    <StackPanel Margin="0,0,0,4">
                                                        <TextBlock Classes="Body"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock Classes="Caption"
                                                                   Text="{Binding ZonesDisplay}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Classes="Caption"
                                                   Text="{conv:Tr OutfitDrawerNoneLabel}"
                                                   IsVisible="{Binding !HasItems}" />

                                    </StackPanel>

                                    <Border Height="0.5"
                                            Background="{DynamicResource BrushBorderSubtle}"
                                            Margin="16,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>

    </Panel>

</UserControl>