<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:controls="using:ChastiMaid.Views.Controls"
             x:Class="ChastiMaid.Views.Controls.OutfitDrawer"
             x:Name="DrawerRoot">

    <!-- Full-size overlay panel -->
    <Panel>

        <!-- Scrim: tapping it closes the drawer -->
        <Button Click="OnScrimClick"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="0"
                CornerRadius="0">
            <Button.Template>
                <ControlTemplate>
                    <Panel Background="#47000000"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Drawer panel: 290px, right-anchored -->
        <Border Width="290"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{DynamicResource PageBackgroundBrush}"
                BorderBrush="{DynamicResource BorderWarmBrush}"
                BorderThickness="1,0,0,0">

            <DockPanel>

                <!-- Header -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource SurfaceBrush}"
                        Height="52"
                        Padding="16,0,12,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="Current Outfit"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontStyle="Italic"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Click="OnScrimClick"
                                Width="32" Height="32"
                                Padding="0"
                                CornerRadius="16"
                                Classes="secondary"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Close drawer">
                            <TextBlock Text="✕" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Layer list -->
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding #DrawerRoot.Layers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OutfitLayerViewModel">
                                <StackPanel>
                                    <StackPanel Spacing="2" Margin="16,12">

                                        <!-- Layer label -->
                                        <TextBlock Text="{Binding LayerLabel}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextHintBrush}"
                                                   Opacity="0.7" />

                                        <!-- Item name when present -->
                                        <TextBlock Text="{Binding ItemName}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   IsVisible="{Binding HasItem}" />

                                        <!-- "(none)" placeholder when absent -->
                                        <TextBlock Text="(none)"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource TextHintBrush}"
                                                   IsVisible="{Binding !HasItem}" />

                                        <!-- Item detail -->
                                        <TextBlock Text="{Binding ItemDetail}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextHintBrush}"
                                                   IsVisible="{Binding HasItem}" />
                                    </StackPanel>

                                    <!-- Row divider -->
                                    <Border Height="0.5"
                                            Background="{DynamicResource BorderBrush}"
                                            Margin="16,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>

    </Panel>

</UserControl>
