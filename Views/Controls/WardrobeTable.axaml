    <UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:controls="using:ChastiMaid.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:tagInput="clr-namespace:ChastiMaid.Controls.TagInput"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.Controls.WardrobeTable">

    <Grid RowDefinitions="Auto,1,*,Auto">

        <!-- ── Sticky header ──────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceBase}" Padding="0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          x:Name="SelectAllCheckBox"
                          MinWidth="44" MinHeight="44"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="NAME"
                           Classes="LabelUI"
                           VerticalAlignment="Center"
                           Margin="4,0" />
                <TextBlock Grid.Column="2" Text="LAYERS"
                           Classes="LabelUI"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="SLOTS"
                           Classes="LabelUI"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="TAGS"
                           Classes="LabelUI"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ── Separator ──────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{DynamicResource BrushBorderSubtle}" />

        <!-- ── Scrollable data rows ───────────────────────────────────── -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding FilteredWardrobeItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WardrobeEditViewModel">
                        <StackPanel>

                            <!-- Part A: always-visible row -->
                            <Border Classes.even="{Binding IsEvenRow}"
                                    MinHeight="44"
                                    Padding="12, 0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              MinWidth="44" MinHeight="44"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Classes="Body"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Margin="4,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Layer chips -->
                                    <ItemsControl Grid.Column="2"
                                                  ItemsSource="{Binding Layers}"
                                                  IsVisible="{Binding !IsExpanded}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="{DynamicResource BrushChipDefault}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,2,4,0">
                                                    <TextBlock Classes="BodySmall"
                                                               Text="{Binding}"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Slot chips -->
                                    <ItemsControl Grid.Column="3"
                                                  ItemsSource="{Binding Slots}"
                                                  IsVisible="{Binding !IsExpanded}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="{DynamicResource BrushChipDefault}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,2,4,0">
                                                    <TextBlock Classes="BodySmall"
                                                               Text="{Binding}"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Tag chips -->
                                    <ItemsControl Grid.Column="4"
                                                  ItemsSource="{Binding Tags}"
                                                  IsVisible="{Binding !IsExpanded}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="{DynamicResource BrushChipDefault}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,2,4,0">
                                                    <TextBlock Classes="BodySmall"
                                                               Text="{Binding}"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Expand/collapse chevron -->
                                    <Button Grid.Column="5"
                                            Command="{Binding ToggleExpandedCommand}"
                                            Width="44" Height="44"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center">
                                        <Panel>
                                            <ic:SymbolIcon Symbol="Edit"
                                                           FontSize="14"
                                                           IsVisible="{Binding !IsExpanded}" />
                                            <ic:SymbolIcon Symbol="ChevronDown"
                                                           FontSize="14"
                                                           IsVisible="{Binding IsExpanded}" />
                                        </Panel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Part B: expanded detail panel -->
                            <Border IsVisible="{Binding IsExpanded}"
                                    Background="{DynamicResource BrushSurfaceSubtle}"
                                    Padding="40,8,8,8">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="LabelUI" Text="NAME" />
                                        <TextBox Text="{Binding Name}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="120,120">
                                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                            <TextBlock Classes="LabelUI" Text="MULTIPLIER" />
                                            <NumericUpDown Value="{Binding Multiplier}"
                                                           FormatString="0.0"
                                                           Increment="0.1"
                                                           Minimum="0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Classes="LabelUI" Text="WEIGHT" />
                                            <NumericUpDown Value="{Binding Weight}"
                                                           FormatString="0.0"
                                                           Increment="0.1"
                                                           Minimum="0" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="LabelUI" Text="LAYERS" />
                                        <tagInput:TagInput Tags="{Binding Layers}"
                                                           Suggestions="{Binding LayerSuggestions}"
                                                           Placeholder="aggiungi layer..."/>
                                    </StackPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="LabelUI" Text="SLOTS" />
                                        <tagInput:TagInput Tags="{Binding Slots}"
                                                           Suggestions="{Binding SlotSuggestions}"
                                                           Placeholder="aggiungi slot..."/>
                                    </StackPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="LabelUI" Text="TAGS" />
                                        <tagInput:TagInput Tags="{Binding Tags}"
                                                           Suggestions="{Binding TagSuggestions}"
                                                           Placeholder="aggiungi tag..."/>
                                    </StackPanel>

                                    <Button Classes="Danger compact"
                                            Content="Delete item"
                                            Command="{Binding DeleteCommand}"
                                            HorizontalAlignment="Right" />
                                    <TextBlock Classes="Caption"
                                               FontStyle="Italic"
                                               Text="Multiplier and weight affect outfit scoring. Tags are used by outfit rules." />
                                </StackPanel>
                            </Border>

                            <Border Height="1"
                                    Background="{DynamicResource BrushBorderSubtle}"
                                    Opacity="0.3" />

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── New-item row ────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource BrushSurfaceSubtle}"
                Margin="0,0,0,0">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="1"
                         Text="{Binding NewItemName}"
                         PlaceholderText="New item name…"
                         MinHeight="44"
                         VerticalContentAlignment="Center" />

                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding NewItemLayerToggles}"
                              VerticalAlignment="Center"
                              Margin="8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:LayerToggleVm">
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsChecked}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox Grid.Column="3"
                         Text="{Binding NewItemSlots}"
                         PlaceholderText="torso, legs…"
                         MinHeight="44"
                         VerticalContentAlignment="Center"
                         Margin="4,0" />

                <!-- Column 4 (TAGS): added after creation via expand -->

                <Button Grid.Column="5"
                        Content="↵"
                        Command="{Binding AddWardrobeItemCommand}"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

            </Grid>
        </Border>

    </Grid>

</UserControl>
