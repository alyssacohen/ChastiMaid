<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:tagInput="clr-namespace:ChastiMaid.Views.Controls.TagInput"
             xmlns:conv="using:ChastiMaid.Converters"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.Controls.WardrobeTable">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CollapseExpandedWardrobeItemCommand}" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,1,*,Auto">

        <!-- ── Sticky header ──────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceBase}" Padding="0,4">
            <Grid Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          x:Name="SelectAllCheckBox"
                          MinWidth="44" MinHeight="44"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{conv:UpperCase {l:Tr 'Name'}}"
                           Classes="LabelUI"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{conv:UpperCase {l:Tr 'Layers'}}"
                           Classes="LabelUI"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{conv:UpperCase {l:Tr 'Slots'}}"
                           Classes="LabelUI"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{conv:UpperCase {l:Tr 'Tags'}}"
                           Classes="LabelUI"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ── Separator ──────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{DynamicResource BrushBorderSubtle}" />

        <!-- ── Scrollable data rows ───────────────────────────────────── -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding FilteredWardrobeItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WardrobeEditViewModel">
                        <StackPanel>

                            <!-- Part A: always-visible row -->
                            <Button Classes="tableRowExpander"
                                    Command="{Binding ToggleExpandedCommand}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              MinWidth="44" MinHeight="44"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Classes="Body"
                                               Text="{Binding Name}"
                                               IsVisible="{Binding !IsExpanded}"
                                               VerticalAlignment="Center"
                                               Margin="4,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="1"
                                                Spacing="2"
                                                IsVisible="{Binding IsExpanded}"
                                                VerticalAlignment="Center"
                                                Margin="4,4">
                                        <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Name'}}" />
                                        <TextBox Classes="underline"
                                                 Text="{Binding Name}" />
                                    </StackPanel>

                                    <!-- Layer chips -->
                                    <ItemsControl Grid.Column="2"
                                                  ItemsSource="{Binding LayerDisplayNames}"
                                                  IsVisible="{Binding !IsExpanded}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="{DynamicResource BrushChipDefault}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,2,4,0">
                                                    <TextBlock Classes="BodySmall"
                                                               Text="{Binding}"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Multiplier + Weight inline (expanded only) -->
                                    <StackPanel Grid.Column="3" Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Spacing="12"
                                                IsVisible="{Binding IsExpanded}"
                                                Margin="0,4">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Multiplier'}}" />
                                            <NumericUpDown Classes="underline stacked-spinner"
                                                           Value="{Binding Multiplier, Converter={x:Static conv:NullableNumericConverter.Instance}, ConverterParameter=0, Mode=TwoWay}"
                                                           FormatString="0.0"
                                                           Increment="0.1"
                                                           Minimum="0"
                                                           Width="110" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Weight'}}" />
                                            <NumericUpDown Classes="underline stacked-spinner"
                                                           Value="{Binding Weight, Converter={x:Static conv:NullableNumericConverter.Instance}, ConverterParameter=0, Mode=TwoWay}"
                                                           FormatString="0.0"
                                                           Increment="0.1"
                                                           Minimum="0"
                                                           Width="110" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Slot chips -->
                                    <ItemsControl Grid.Column="3"
                                                  ItemsSource="{Binding Slots}"
                                                  IsVisible="{Binding !IsExpanded}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="{DynamicResource BrushChipDefault}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,2,4,0">
                                                    <TextBlock Classes="BodySmall"
                                                               Text="{Binding}"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Tag chips -->
                                    <ItemsControl Grid.Column="4"
                                                  ItemsSource="{Binding Tags}"
                                                  IsVisible="{Binding !IsExpanded}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="{DynamicResource BrushChipDefault}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,2,4,0">
                                                    <TextBlock Classes="BodySmall"
                                                               Text="{Binding}"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Expand/collapse chevron -->
                                    <ic:SymbolIcon Grid.Column="5"
                                                   Symbol="ChevronRight"
                                                   FontSize="14"
                                                   IsVisible="{Binding !IsExpanded}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    <ic:SymbolIcon Grid.Column="5"
                                                   Symbol="ChevronDown"
                                                   FontSize="14"
                                                   IsVisible="{Binding IsExpanded}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Part B: expanded detail panel -->
                            <Border IsVisible="{Binding IsExpanded}"
                                    Background="{DynamicResource BrushSurfaceSubtle}"
                                    Padding="40,8,8,8">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Layers'}}" />
                                        <ItemsControl ItemsSource="{Binding LayerToggles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LayerToggleVm">
                                                    <ToggleButton Classes="filterChip"
                                                                  Content="{Binding DisplayName}"
                                                                  IsChecked="{Binding IsChecked}"
                                                                  Margin="0,0,4,4" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Slots'}}" />
                                        <tagInput:TagInput Tags="{Binding Slots}"
                                                           Suggestions="{Binding SlotSuggestions}"
                                                           Placeholder="{l:Tr 'add slot...'}" />
                                    </StackPanel>

                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Tags'}}" />
                                        <tagInput:TagInput Tags="{Binding Tags}"
                                                           Suggestions="{Binding TagSuggestions}"
                                                           Placeholder="{l:Tr 'add tag...'}" />
                                    </StackPanel>

                                    <Button Classes="Danger compact"
                                            Command="{Binding DeleteCommand}"
                                            HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ic:SymbolIcon Symbol="Delete" IconVariant="Regular" FontSize="16" />
                                            <TextBlock Text="{l:Tr 'Delete item'}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Classes="Caption"
                                               FontStyle="Italic"
                                               Text="{l:Tr 'Multiplier and weight affect outfit scoring. Tags are used by outfit rules.'}" />
                                </StackPanel>
                            </Border>

                            <Border Height="1"
                                    Background="{DynamicResource BrushBorderSubtle}"
                                    Opacity="0.3" />

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Add-item footer ────────────────────────────────────────── -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource BrushSurfaceSubtle}">
            <StackPanel>

                <!-- Trigger button — visible when panel is closed -->
                <Button Classes="Ghost compact"
                        Content="{l:Tr '+ Add Item'}"
                        Command="{Binding ShowAddItemPanelCommand}"
                        IsVisible="{Binding !IsAddingNewItem}"
                        Margin="12,6"
                        HorizontalAlignment="Left" />

                <!-- Detail panel — mirrors expanded row (Part B) -->
                <Border IsVisible="{Binding IsAddingNewItem}"
                        Padding="40,8,8,8">
                    <StackPanel Spacing="10">
                        <!-- Name + Multiplier/Weight inline — mirrors Part A expanded row -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                                <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Name'}}" />
                                <TextBox Classes="underline"
                                         Text="{Binding NewItemName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="12" VerticalAlignment="Bottom">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Multiplier'}}" />
                                    <NumericUpDown Classes="underline stacked-spinner"
                                                   Value="{Binding NewItemMultiplier, Converter={x:Static conv:NullableNumericConverter.Instance}, ConverterParameter=0, Mode=TwoWay}"
                                                   FormatString="0.0"
                                                   Increment="0.1"
                                                   Minimum="0"
                                                   Width="110" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Weight'}}" />
                                    <NumericUpDown Classes="underline stacked-spinner"
                                                   Value="{Binding NewItemWeight, Converter={x:Static conv:NullableNumericConverter.Instance}, ConverterParameter=0, Mode=TwoWay}"
                                                   FormatString="0.0"
                                                   Increment="0.1"
                                                   Minimum="0"
                                                   Width="110" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Layers'}}" />
                            <ItemsControl ItemsSource="{Binding NewItemLayerToggles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LayerToggleVm">
                                        <ToggleButton Classes="filterChip"
                                                      Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsChecked}"
                                                      Margin="0,0,4,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Slots'}}" />
                            <tagInput:TagInput Tags="{Binding NewItemSlots}"
                                               Suggestions="{Binding NewItemSlotSuggestions}"
                                               Placeholder="{l:Tr 'add slot...'}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="LabelUI" Text="{conv:UpperCase {l:Tr 'Tags'}}" />
                            <tagInput:TagInput Tags="{Binding NewItemTags}"
                                               Suggestions="{Binding NewItemTagSuggestions}"
                                               Placeholder="{l:Tr 'add tag...'}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="Ghost compact"
                                    Content="{l:Tr 'Cancel'}"
                                    Command="{Binding CancelAddItemCommand}" />
                            <Button Classes="Primary compact"
                                    Content="{l:Tr 'Add Item'}"
                                    Command="{Binding AddWardrobeItemCommand}" />
                        </StackPanel>
                        <TextBlock Classes="Caption"
                                   FontStyle="Italic"
                                   Text="{l:Tr 'Multiplier affects outfit scoring, Weight is the probability a clothing item is chosen.'}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

    </Grid>

</UserControl>