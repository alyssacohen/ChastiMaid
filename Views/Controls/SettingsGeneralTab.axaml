<UserControl
    x:Class="ChastiMaid.Views.Controls.SettingsGeneralTab"
    x:DataType="vm:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="using:ChastiMaid.Converters"
    xmlns:vm="using:ChastiMaid.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ChastiMaid.Localization">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,0,32,24" Spacing="0">
            <TextBlock
                Classes="SectionTitle"
                Margin="0,20,0,8"
                Text="{l:Tr 'General'}" />
            <Border
                Background="{DynamicResource BrushBorderSubtle}"
                Height="1"
                Margin="0,0,0,16" />

            <!--  Player  -->
            <TextBlock
                Classes="Heading"
                Margin="0,0,0,8"
                Text="{l:Tr 'Player'}" />
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="160,*">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Name'}"
                            VerticalAlignment="Center" />
                        <TextBox
                            Classes="underline"
                            Grid.Column="1"
                            Text="{Binding PlayerName}" />
                    </Grid>
                    <Grid ColumnDefinitions="160,*">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Appellatives'}"
                            VerticalAlignment="Center" />
                        <TextBox
                            Classes="underline"
                            Grid.Column="1"
                            Text="{Binding Appellatives}" />
                    </Grid>
                    <TextBlock
                        Classes="Caption"
                        Text="{l:Tr 'Comma-separated. One is picked at random, along with the name, for popup summons.'}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="Caption"
                        Foreground="{DynamicResource BrushEmergencyText}"
                        IsVisible="{Binding AppellativesWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Text="{Binding AppellativesWarning}"
                        TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Auto-save (minutes)'}"
                            VerticalAlignment="Center" />
                        <NumericUpDown
                            Classes="underline stacked-spinner compact"
                            FormatString="0"
                            Grid.Column="1"
                            Maximum="60"
                            Minimum="1"
                            Value="{Binding AutoSaveInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Game Balance  -->
            <TextBlock
                Classes="Heading"
                Margin="0,8,0,8"
                Text="{l:Tr 'Game Balance'}" />
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Min debt (£)'}"
                            VerticalAlignment="Center" />
                        <NumericUpDown
                            Classes="underline stacked-spinner compact"
                            FormatString="0"
                            Grid.Column="1"
                            Increment="50"
                            Minimum="0"
                            Value="{Binding MinDebt, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Max debt (£)'}"
                            VerticalAlignment="Center" />
                        <NumericUpDown
                            Classes="underline stacked-spinner compact"
                            FormatString="0"
                            Grid.Column="1"
                            Increment="50"
                            Minimum="0"
                            Value="{Binding MaxDebt, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Daily interest rate'}"
                            VerticalAlignment="Center" />
                        <NumericUpDown
                            Classes="underline stacked-spinner compact"
                            FormatString="0.0"
                            Grid.Column="1"
                            Increment="0.5"
                            Maximum="10.0"
                            Minimum="0.5"
                            Value="{Binding DailyInterestRatePercent, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0.5}" />
                        <TextBlock Classes="BodySmall unitSuffix" Grid.Column="2" Text="%" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Idle wage amount (£)'}"
                            VerticalAlignment="Center" />
                        <NumericUpDown
                            Classes="underline stacked-spinner compact"
                            FormatString="0"
                            Grid.Column="1"
                            Increment="1"
                            Minimum="0"
                            Value="{Binding IdleWageAmount, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Wage interval (minutes)'}"
                            VerticalAlignment="Center" />
                        <NumericUpDown
                            Classes="underline stacked-spinner compact"
                            FormatString="0"
                            Grid.Column="1"
                            Maximum="120"
                            Minimum="1"
                            Value="{Binding IdleWageInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Diaper Play  -->
            <TextBlock
                Classes="Heading"
                Margin="0,8,0,8"
                Text="{l:Tr 'Diaper Play'}" />
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock
                        Classes="EmployerVoice"
                        Text="{l:Tr 'When the outfit includes one of the marked items, toilet requests are refused and hydration reminders come twice as often.'}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        IsChecked="{Binding DiaperPlayEnabled}"
                        OffContent="{l:Tr 'Disabled'}"
                        OnContent="{l:Tr 'Enabled'}" />

                    <ItemsControl ItemsSource="{Binding DiaperPlayItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiaperPlayItemEditViewModel">
                                <ToggleButton
                                    Classes="filterChip"
                                    Content="{Binding Name}"
                                    IsChecked="{Binding IsEligible}"
                                    Margin="0,0,4,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  Chastity Device  -->
            <TextBlock
                Classes="Heading"
                Margin="0,8,0,8"
                Text="{l:Tr 'Chastity Device'}" />
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock
                        Classes="EmployerVoice"
                        Text="{l:Tr 'Each session one of the marked items is chosen at random and must be worn. It can only be changed while the safe is open.'}"
                        TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding ChastityDeviceItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChastityDeviceItemEditViewModel">
                                <ToggleButton
                                    Classes="filterChip"
                                    Content="{Binding Name}"
                                    IsChecked="{Binding IsEligible}"
                                    Margin="0,0,4,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  Plug & Play  -->
            <TextBlock
                Classes="Heading"
                Margin="0,8,0,8"
                Text="{l:Tr 'Plug &amp; Play'}" />
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock
                        Classes="EmployerVoice"
                        Text="{l:Tr 'Selected accessories must be worn for a random duration before they can be removed.'}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        IsChecked="{Binding PlugAndPlayEnabled}"
                        OffContent="{l:Tr 'Disabled'}"
                        OnContent="{l:Tr 'Enabled'}" />

                    <ItemsControl ItemsSource="{Binding PlugAndPlayItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlugAndPlayItemEditViewModel">
                                <ToggleButton
                                    Classes="filterChip"
                                    Content="{Binding Name}"
                                    IsChecked="{Binding IsEligible}"
                                    Margin="0,0,4,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding PlugAndPlayItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlugAndPlayItemEditViewModel">
                                <Grid
                                    ColumnDefinitions="*,100,100"
                                    IsVisible="{Binding IsEligible}"
                                    Margin="0,4">
                                    <TextBlock
                                        Classes="Body"
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Text="{Binding Name}"
                                        VerticalAlignment="Center" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        Spacing="2">
                                        <TextBlock Classes="Caption" Text="{l:Tr 'Minimum minutes'}" />
                                        <NumericUpDown
                                            Classes="underline stacked-spinner"
                                            FormatString="0"
                                            Minimum="1"
                                            Value="{Binding MinDurationMinutes, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Classes="Caption" Text="{l:Tr 'Maximum minutes'}" />
                                        <NumericUpDown
                                            Classes="underline stacked-spinner"
                                            FormatString="0"
                                            Minimum="1"
                                            Value="{Binding MaxDurationMinutes, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  Language  -->
            <TextBlock
                Classes="Heading"
                Margin="0,8,0,8"
                Text="{l:Tr 'Language'}" />
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="160,*">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Language'}"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding AvailableLanguages}"
                            SelectedItem="{Binding SelectedLanguage}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Webcam & Speech Recognition  -->
            <TextBlock
                Classes="Heading"
                Margin="0,8,0,8"
                Text="{l:Tr 'Webcam &amp; Speech Recognition'}" />
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="160,*">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Speech recognition'}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Classes="BodySmall"
                            Grid.Column="1"
                            Text="{Binding SpeechRecognitionStatusDisplay}"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="160,*">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Webcam'}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Classes="BodySmall"
                            Grid.Column="1"
                            Text="{Binding WebcamStatusDisplay}"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="160,*">
                        <TextBlock
                            Classes="BodySmall"
                            Text="{l:Tr 'Detected cameras'}"
                            VerticalAlignment="Top" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding AvailableCameras}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Classes="BodySmall" Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Contract Import/Export  -->
            <TextBlock
                Classes="Heading"
                Margin="0,8,0,8"
                Text="{l:Tr 'Contract'}" />
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock
                        Classes="Caption"
                        Text="{l:Tr 'Export every game setting as a single contract file — including the wardrobe, outfit rules, tasks, punishments and permissions — or load one to replace your current terms outright. Your name, language, camera and autosave settings are never included.'}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                        <Button
                            Classes="Ghost"
                            Command="{Binding ExportContractCommand}"
                            Content="{l:Tr 'Export Contract'}" />
                        <Button
                            Classes="Ghost"
                            Command="{Binding ImportContractCommand}"
                            Content="{l:Tr 'Import Contract'}" />
                    </StackPanel>
                    <TextBlock
                        Classes="BodySmall"
                        IsVisible="{Binding ContentActionStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Text="{Binding ContentActionStatusMessage}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
