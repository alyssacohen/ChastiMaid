<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:conv="using:ChastiMaid.Converters"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.Controls.SettingsTestOutfitOverlay">

    <Panel Classes="dialogOverlay"
           IsVisible="{Binding TestOutfitDialog, Converter={x:Static ObjectConverters.IsNotNull}}"
           PointerPressed="OnOverlayPointerPressed">
        <Border Classes="dialogBox"
                MaxWidth="640"
                MaxHeight="600"
                PointerPressed="OnDialogBoxPointerPressed">
            <StackPanel DataContext="{Binding TestOutfitDialog}" Spacing="{StaticResource SpacingMd}">
                <TextBlock Classes="Heading"
                           HorizontalAlignment="Center"
                           Text="{l:Tr 'Outfit Preview'}" />

                <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding OutfitVm.Layers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource SpacingMd}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OutfitLayerViewModel">
                                <Border Background="{StaticResource BrushSurfaceBase}"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="{StaticResource SpacingMdThickness}">
                                    <Grid ColumnDefinitions="160,*">
                                        <StackPanel Grid.Column="0"
                                                    Spacing="{StaticResource SpacingXs}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0">
                                            <TextBlock Classes="LabelUI"
                                                       Text="{Binding LayerLabel, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
                                            <TextBlock Classes="BodySmall"
                                                       Text="{Binding LayerIndex}"
                                                       Foreground="{StaticResource TextAccent}" />
                                        </StackPanel>
                                        <ItemsControl Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OutfitLayerItem">
                                                    <Border Classes="chip info"
                                                            Background="{StaticResource BrushSurfaceMuted}"
                                                            BorderBrush="{StaticResource BrushBorderSubtle}">
                                                        <StackPanel Spacing="{StaticResource SpacingXs}">
                                                            <TextBlock Classes="chip-label"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       Text="{Binding Name}" />
                                                            <TextBlock Classes="BodySmall"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       Text="{Binding ZonesDisplay}"
                                                                       IsVisible="{Binding ZonesDisplay,
                                                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Classes="Ghost"
                            Command="{Binding RegenerateCommand}"
                            Content="{l:Tr 'Regenerate'}" />
                    <Button Classes="Primary"
                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).CloseTestOutfitDialogCommand}"
                            Content="{l:Tr 'Close'}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
