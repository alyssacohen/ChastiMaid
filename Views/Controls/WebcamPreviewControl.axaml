<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:ChastiMaid.Converters"
             x:Class="ChastiMaid.Views.Controls.WebcamPreviewControl"
             x:Name="Root">

    <Border Background="{DynamicResource PageBackgroundBrush}" CornerRadius="4" ClipToBounds="True">
        <Panel>
            <Image x:Name="PreviewImage" Stretch="{Binding #Root.Stretch}" />
            <TextBlock Text="{conv:Tr WebcamNoSignal}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.4"
                       x:Name="NoSignalText" />
        </Panel>
    </Border>

</UserControl>