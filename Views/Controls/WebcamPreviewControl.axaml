<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChastiMaid.Views.Controls.WebcamPreviewControl">

    <Border Background="{DynamicResource PageBackgroundBrush}" CornerRadius="4" ClipToBounds="True">
        <Panel>
            <Image x:Name="PreviewImage" Stretch="Uniform" />
            <TextBlock Text="No webcam signal"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.4"
                       x:Name="NoSignalText" />
        </Panel>
    </Border>

</UserControl>