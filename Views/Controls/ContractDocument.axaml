<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:contracts="using:ChastiMaid.Services.Contracts"
             x:Class="ChastiMaid.Views.Controls.ContractDocument">

    <!-- The contract sheet: title, preamble, clauses and closing. DataContext is the clause list. -->
    <Border Classes="contractPaper">
        <StackPanel Spacing="{StaticResource SpacingXl}">

            <TextBlock Classes="PageTitle"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{l:Tr 'Contract of Service'}" />

            <TextBlock Classes="EmployerVoice"
                       TextWrapping="Wrap"
                       Text="{l:Tr 'It is hereby agreed between the Lady of the House and the newest member of her staff — hereafter, with some optimism, “the Maid” — that the following terms shall govern the period of service. Kindly read them attentively. They will not be read aloud.'}" />

            <ItemsControl ItemsSource="{ReflectionBinding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource SpacingXl}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="contracts:ContractClause">
                        <StackPanel Spacing="{StaticResource SpacingSm}">
                            <TextBlock Classes="SectionTitle"
                                       TextWrapping="Wrap"
                                       Text="{Binding Heading}" />
                            <ItemsControl ItemsSource="{Binding Paragraphs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{StaticResource SpacingSm}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="Body"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="EmployerVoice"
                       TextWrapping="Wrap"
                       Text="{l:Tr 'Should any of this displease you, the door remains where it has always been. It does tend to stick.'}" />

        </StackPanel>
    </Border>

</UserControl>
