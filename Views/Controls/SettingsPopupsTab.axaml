<UserControl
    x:Class="ChastiMaid.Views.Controls.SettingsPopupsTab"
    x:DataType="vm:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="using:ChastiMaid.Converters"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:vm="using:ChastiMaid.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ChastiMaid.Localization">

    <Grid Margin="0,0,0,16" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="24,0,32,0">
            <TextBlock
                Classes="SectionTitle"
                Margin="0,20,0,8"
                Text="{l:Tr 'Popups'}" />
            <Border
                Background="{DynamicResource BrushBorderSubtle}"
                Height="1"
                Margin="0,0,0,8" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Name="PopupsScroll">
            <StackPanel Margin="24,0,32,0" Spacing="16">
                <!--  Frequency & Timeout  -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="Heading" Text="{l:Tr 'Popup Frequency &amp; Timeout'}" />
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Popup minimum (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Increment="10"
                                    Minimum="10"
                                    Value="{Binding PopupMinInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=10}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Popup maximum (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Increment="10"
                                    Minimum="10"
                                    Value="{Binding PopupMaxInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=10}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Popup timeout (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Maximum="60"
                                    Minimum="5"
                                    Value="{Binding PopupTimeout, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=5}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Hydration Reminders  -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="Heading" Text="{l:Tr 'Hydration Reminders'}" />
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Classes="EmployerVoice"
                                Text="{l:Tr 'Periodic reminders to drink water.'}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                IsChecked="{Binding HydrationEnabled}"
                                OffContent="{l:Tr 'Disabled'}"
                                OnContent="{l:Tr 'Enabled'}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Minimum hydration interval (minutes)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding HydrationMinInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Curtsy Video  -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="Heading" Text="{l:Tr 'Curtsy Video'}" />
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Classes="EmployerVoice"
                                Text="{l:Tr 'Asks for a curtsy, recorded on video.'}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                IsChecked="{Binding CurtsyEnabled}"
                                OffContent="{l:Tr 'Disabled'}"
                                OnContent="{l:Tr 'Enabled'}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Curtsy video duration (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Maximum="30"
                                    Minimum="2"
                                    Value="{Binding CurtsyVideoDuration, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=2}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Quote Reading  -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="Heading" Text="{l:Tr 'Quote Reading'}" />
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Classes="EmployerVoice"
                                Text="{l:Tr 'Read a phrase aloud; speech recognition compares it with the text.'}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                IsChecked="{Binding QuoteReadingEnabled}"
                                OffContent="{l:Tr 'Disabled'}"
                                OnContent="{l:Tr 'Enabled'}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Quote listening window (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Maximum="120"
                                    Minimum="5"
                                    Value="{Binding QuoteListenTimeout, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=5}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Quote recognition sensitivity'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Maximum="100"
                                    Minimum="1"
                                    Value="{Binding QuoteMatchMinSimilarityPercent, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <TextBlock
                                Classes="BodySmall"
                                Text="{l:Tr 'Test speech recognition by reading this phrase:'}"
                                TextWrapping="Wrap" />
                            <Border Classes="statCard" HorizontalAlignment="Stretch">
                                <TextBlock
                                    Classes="EmployerVoice"
                                    HorizontalAlignment="Center"
                                    Text="{Binding TestQuotePhrase}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Classes="Ghost compact"
                                    Command="{Binding StartTestQuoteListeningCommand}"
                                    Content="{l:Tr 'Start'}"
                                    ToolTip.Tip="{Binding TestQuoteUnavailableTooltip}" />
                                <Button
                                    Classes="Ghost compact"
                                    Command="{Binding StopTestQuoteListeningCommand}"
                                    Content="{l:Tr 'Stop'}" />
                            </StackPanel>
                            <StackPanel
                                IsVisible="{Binding IsTestQuoteListening}"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Ellipse
                                    Fill="{DynamicResource BrushStatusIdle}"
                                    Height="10"
                                    Width="10" />
                                <TextBlock Classes="BodySmall" Text="{l:Tr 'Listening…'}" />
                            </StackPanel>
                            <TextBlock
                                Classes="BodySmall"
                                IsVisible="{Binding ShowTestQuotePassResult}"
                                Text="{Binding TestQuoteResultText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="BodySmall"
                                Foreground="{DynamicResource BrushEmergencyText}"
                                IsVisible="{Binding ShowTestQuoteFailResult}"
                                Text="{Binding TestQuoteResultText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Kneel  -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="Heading" Text="{l:Tr 'Kneel'}" />
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Classes="EmployerVoice"
                                Text="{l:Tr 'Kneel for a random duration while the camera takes photos.'}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                IsChecked="{Binding KneelEnabled}"
                                OffContent="{l:Tr 'Disabled'}"
                                OnContent="{l:Tr 'Enabled'}" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Grid.Column="0"
                                    Text="{l:Tr 'Duration minimum/maximum (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    Minimum="1"
                                    Value="{Binding KneelMinDuration, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="2"
                                    Minimum="1"
                                    Value="{Binding KneelMaxDuration, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Grid.Column="0"
                                    Text="{l:Tr 'Photo interval minimum/maximum (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    Minimum="1"
                                    Value="{Binding KneelPhotoMinInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="2"
                                    Minimum="1"
                                    Value="{Binding KneelPhotoMaxInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
