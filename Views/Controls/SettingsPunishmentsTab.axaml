<UserControl
    x:Class="ChastiMaid.Views.Controls.SettingsPunishmentsTab"
    x:DataType="vm:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="using:ChastiMaid.Converters"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:vm="using:ChastiMaid.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ChastiMaid.Localization">

    <Grid Margin="0,0,0,16" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="24,0,32,0">
            <TextBlock
                Classes="SectionTitle"
                Margin="0,20,0,8"
                Text="{l:Tr 'Punishments'}" />
            <Border
                Background="{DynamicResource BrushBorderSubtle}"
                Height="1"
                Margin="0,0,0,8" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Name="PunishmentsScroll">
            <StackPanel Margin="24,0,32,0" Spacing="16">
                <!--  Fine — always active  -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="Heading" Text="{l:Tr 'Fine', Context='punishment'}" />
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Classes="EmployerVoice"
                                Text="{l:Tr 'A sum, added to the debt at once. Always in effect — there is no toggle for consequence.'}"
                                TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Pounds (£) per severity'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0.00"
                                    Grid.Column="1"
                                    Increment="0.5"
                                    Minimum="0.5"
                                    Value="{Binding FineSeverityValue, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0.5}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Cornertime  -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="Heading" Text="{l:Tr 'Cornertime'}" />
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Classes="EmployerVoice"
                                Text="{l:Tr 'A period of stillness, in a corner of your choosing, observed by the camera.'}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                IsChecked="{Binding CornertimeEnabled}"
                                OffContent="{l:Tr 'Disabled'}"
                                OnContent="{l:Tr 'Enabled'}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Seconds required per severity'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding CornertimeSeverityValue, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Required duration — minimum (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="10"
                                    Value="{Binding CornertimeMinRequiredSeconds, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=10}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Grace time before failure (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="10"
                                    Value="{Binding CornertimeMaxOverrunSeconds, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=10}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Required duration — maximum (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="10"
                                    Value="{Binding CornertimeMaxRequiredSeconds, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=10}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Minimum seconds between penalties'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding CornertimeMovementCooldownMinSeconds, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Maximum seconds between penalties'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding CornertimeMovementCooldownMaxSeconds, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Movement sensitivity (%)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Maximum="100"
                                    Minimum="1"
                                    Value="{Binding CornertimeMovementSensitivityPercent, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Minimum movement penalty (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding CornertimeMovementPenaltyMinSeconds, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Maximum movement penalty (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding CornertimeMovementPenaltyMaxSeconds, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="BodySmall" Text="{l:Tr 'Voice narration'}" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsChecked="{Binding CornertimeVoiceEnabled}"
                                    OffContent="{l:Tr 'Disabled'}"
                                    OnContent="{l:Tr 'Enabled'}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Writing Lines  -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="Heading" Text="{l:Tr 'Writing Lines'}" />
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Classes="EmployerVoice"
                                Text="{l:Tr 'A line, copied faithfully, as many times as the occasion warrants.'}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                IsChecked="{Binding WritingLinesEnabled}"
                                OffContent="{l:Tr 'Disabled'}"
                                OnContent="{l:Tr 'Enabled'}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Lines per severity'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding WritingLinesSeverityValue, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Penalty lines per mistake'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding WritingLinesPenaltyLinesPerMistake, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Minimum lines'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding WritingLinesMinLines, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Maximum lines'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding WritingLinesMaxLines, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>

                            <TextBlock Classes="LabelUI" Text="{l:Tr 'No Idle'}" />
                            <TextBlock
                                Classes="EmployerVoice"
                                Text="{l:Tr 'Idle hands earn extra lines.'}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                IsChecked="{Binding WritingLinesNoIdleEnabled}"
                                OffContent="{l:Tr 'Disabled'}"
                                OnContent="{l:Tr 'Enabled'}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Idle timeout (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding WritingLinesNoIdleTimeoutSeconds, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Lines added per timeout'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding WritingLinesNoIdleLinesToAdd, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>

                            <TextBlock Classes="LabelUI" Text="{l:Tr 'Interruptions'}" />
                            <TextBlock
                                Classes="EmployerVoice"
                                Text="{l:Tr 'Occasional reminders, delivered without warning.'}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                IsChecked="{Binding WritingLinesInterruptionsEnabled}"
                                OffContent="{l:Tr 'Disabled'}"
                                OnContent="{l:Tr 'Enabled'}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Minimum interval (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding WritingLinesInterruptionMinIntervalSeconds, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Maximum interval (seconds)'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Value="{Binding WritingLinesInterruptionMaxIntervalSeconds, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Forced Outfit  -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="Heading" Text="{l:Tr 'Forced Outfit'}" />
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Classes="EmployerVoice"
                                Text="{l:Tr 'The chosen garments become mandatory, unbidden, for a number of subsequent sessions.'}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                IsChecked="{Binding ForcedOutfitEnabled}"
                                OffContent="{l:Tr 'Disabled'}"
                                OnContent="{l:Tr 'Enabled'}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="BodySmall"
                                    Text="{l:Tr 'Max hours'}"
                                    VerticalAlignment="Center" />
                                <NumericUpDown
                                    Classes="underline stacked-spinner compact"
                                    FormatString="0.0"
                                    Grid.Column="1"
                                    Minimum="0.5"
                                    Increment="0.5"
                                    Value="{Binding ForcedOutfitMaxHours, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0.5}" />
                            </Grid>
                            <TextBlock Classes="LabelUI" Text="{converters:UpperCase {l:Tr 'Configured outfits'}}" />
                            <ItemsControl ItemsSource="{Binding ForcedOutfitPresets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ForcedOutfitPresetSummaryViewModel">
                                        <Border Classes="card">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <StackPanel
                                                    Grid.Column="0"
                                                    Spacing="2"
                                                    VerticalAlignment="Center">
                                                    <TextBlock Classes="Body" Text="{Binding Name}" />
                                                    <TextBlock Classes="Caption" Text="{Binding SummaryLabel}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    Grid.Column="1"
                                                    IsChecked="{Binding IsEnabled}"
                                                    Margin="8,0"
                                                    VerticalAlignment="Center" />
                                                <Button
                                                    AutomationProperties.Name="{l:Tr 'Edit preset'}"
                                                    Classes="Edit"
                                                    Command="{Binding EditCommand}"
                                                    Grid.Column="2"
                                                    Margin="4,0"
                                                    ToolTip.Tip="{l:Tr 'Edit preset'}"
                                                    VerticalAlignment="Center">
                                                    <ic:SymbolIcon
                                                        FontSize="18"
                                                        IconVariant="Regular"
                                                        Symbol="Edit" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="{l:Tr 'Delete preset'}"
                                                    Classes="Danger"
                                                    Command="{Binding DeleteCommand}"
                                                    Grid.Column="3"
                                                    ToolTip.Tip="{l:Tr 'Delete preset'}"
                                                    VerticalAlignment="Center">
                                                    <ic:SymbolIcon
                                                        FontSize="18"
                                                        IconVariant="Regular"
                                                        Symbol="Delete" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="Add" Command="{Binding AddForcedOutfitPresetCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:SymbolIcon
                                        FontSize="18"
                                        IconVariant="Regular"
                                        Symbol="Add" />
                                    <TextBlock Text="{l:Tr 'Add Outfit'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
