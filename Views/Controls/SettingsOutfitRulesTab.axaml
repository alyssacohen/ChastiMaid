<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:converters="using:ChastiMaid.Views.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.Controls.SettingsOutfitRulesTab">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,0,32,16">
        <StackPanel Grid.Row="0">
            <TextBlock Classes="SectionTitle" Text="{converters:Tr SettingsTabOutfitRules}" Margin="0,20,0,8" />
            <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,8" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Name="RulesScroll">
            <ItemsControl ItemsSource="{Binding OutfitRules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutfitRuleEditViewModel">
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto,*,Auto">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableItems}"
                                          SelectedItem="{Binding Item}"
                                          PlaceholderText="{converters:Tr SettingsSelectItemPlaceholder}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Static vm:OutfitRuleEditViewModel.RelationOptions}"
                                          SelectedItem="{Binding Relation}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          Margin="8,0" />
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding AvailableItems}"
                                          SelectedItem="{Binding RelatedItem}"
                                          PlaceholderText="{converters:Tr SettingsSelectItemPlaceholder}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                                <Button Grid.Column="3"
                                        Command="{Binding DeleteCommand}"
                                        Classes="Delete"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="2" Command="{Binding AddOutfitRuleCommand}" Classes="Add">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:SymbolIcon Symbol="Add" IconVariant="Regular" FontSize="18" />
                <TextBlock Text="{converters:Tr SettingsAddRule}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>

</UserControl>
