<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:converters="using:ChastiMaid.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.Controls.SettingsOutfitRulesTab">

    <Grid RowDefinitions="Auto,*,Auto" Margin="0,0,0,16">
        <StackPanel Grid.Row="0" Margin="24,0,32,0">
            <TextBlock Classes="SectionTitle" Text="{l:Tr 'Outfit Rules'}" Margin="0,20,0,8" />
            <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,8" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Name="RulesScroll">
            <ItemsControl ItemsSource="{Binding OutfitRules}" Margin="24,0,32,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutfitRuleEditViewModel">
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <Grid Grid.Column="0" ColumnDefinitions="*,160,*">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {l:Tr 'Tag'}}" />
                                        <ComboBox ItemsSource="{Binding TagSuggestions}"
                                                  IsEditable="True"
                                                  Text="{Binding SourceTag, Mode=TwoWay}"
                                                  SelectionChanged="OnSourceTagSelectionChanged"
                                                  PlaceholderText="{l:Tr 'Select tag'}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,8,0">
                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {l:Tr 'Relation'}}" />
                                        <ComboBox ItemsSource="{Binding RelationOptions}"
                                                  SelectedItem="{Binding RelationOption}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {l:Tr 'Related tag'}}" />
                                        <ComboBox ItemsSource="{Binding TagSuggestions}"
                                                  IsEditable="True"
                                                  Text="{Binding RelatedTag, Mode=TwoWay}"
                                                  SelectionChanged="OnRelatedTagSelectionChanged"
                                                  PlaceholderText="{l:Tr 'Select tag'}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                                <Button Grid.Column="1"
                                        Command="{Binding DeleteCommand}"
                                        Classes="Danger"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0"
                                        ToolTip.Tip="{l:Tr 'Delete'}"
                                        AutomationProperties.Name="{l:Tr 'Delete'}">
                                    <ic:SymbolIcon Symbol="Delete" IconVariant="Regular" FontSize="18" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="24,8,32,0">
            <Button Command="{Binding AddOutfitRuleCommand}" Classes="Add">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="Add" IconVariant="Regular" FontSize="18" />
                    <TextBlock Text="{l:Tr 'Add Rule'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding TestRulesCommand}" Classes="Ghost">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="Play" IconVariant="Regular" FontSize="18" />
                    <TextBlock Text="{l:Tr 'Test Rules'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>

</UserControl>
