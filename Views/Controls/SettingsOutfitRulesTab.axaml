<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:converters="using:ChastiMaid.Views.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.Controls.SettingsOutfitRulesTab">

    <Grid RowDefinitions="Auto,*,Auto" Margin="0,0,0,16">
        <StackPanel Grid.Row="0" Margin="24,0,32,0">
            <TextBlock Classes="SectionTitle" Text="{converters:Tr SettingsTabOutfitRules}" Margin="0,20,0,8" />
            <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,8" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Name="RulesScroll">
            <ItemsControl ItemsSource="{Binding OutfitRules}" Margin="24,0,32,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutfitRuleEditViewModel">
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <Grid Grid.Column="0" ColumnDefinitions="*,160,*">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {converters:Tr SettingsFieldItem}}" />
                                        <ComboBox ItemsSource="{Binding AvailableItems}"
                                                  SelectedItem="{Binding Item}"
                                                  PlaceholderText="{converters:Tr SettingsSelectItemPlaceholder}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,8,0">
                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {converters:Tr SettingsFieldRelation}}" />
                                        <ComboBox ItemsSource="{x:Static vm:OutfitRuleEditViewModel.RelationOptions}"
                                                  SelectedItem="{Binding RelationOption}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {converters:Tr SettingsFieldRelatedItem}}" />
                                        <ComboBox ItemsSource="{Binding AvailableItems}"
                                                  SelectedItem="{Binding RelatedItem}"
                                                  PlaceholderText="{converters:Tr SettingsSelectItemPlaceholder}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                                <Button Grid.Column="1"
                                        Command="{Binding DeleteCommand}"
                                        Classes="Danger"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0"
                                        ToolTip.Tip="{converters:Tr Delete}"
                                        AutomationProperties.Name="{converters:Tr Delete}">
                                    <ic:SymbolIcon Symbol="Delete" IconVariant="Regular" FontSize="18" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="2" Command="{Binding AddOutfitRuleCommand}" Classes="Add" Margin="24,8,32,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:SymbolIcon Symbol="Add" IconVariant="Regular" FontSize="18" />
                <TextBlock Text="{converters:Tr SettingsAddRule}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>

</UserControl>
