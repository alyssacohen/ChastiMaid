<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:ChastiMaid.Views.Converters"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="ChastiMaid.Views.Dialogs.PunishmentListDialog"
        x:CompileBindings="False"
        WindowDecorations="None"
        SizeToContent="Height"
        Width="380"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        CanResize="False">

    <Border Background="{DynamicResource BrushWindowBackground}"
            CornerRadius="8"
            BoxShadow="0 8 32 0 #40000000">

        <DockPanel>

            <!-- ── Header (amber) ── -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource BrushAmberBackground}"
                    CornerRadius="8,8,0,0"
                    Padding="20,0,12,0"
                    Height="52">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="SectionTitle"
                               Text="{conv:Tr PendingPunishments}"
                               Foreground="{DynamicResource BrushAmberText}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Click="OnDismissClick"
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="16"
                            Classes="Ghost compact"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{conv:Tr Close}">
                        <ic:SymbolIcon Symbol="Dismiss" IconVariant="Regular" FontSize="14"
                                       Foreground="{DynamicResource BrushAmberText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- ── Footer ── -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Button Content="{conv:Tr Close}"
                        Click="OnDismissClick"
                        Classes="Ghost"
                        HorizontalAlignment="Center"
                        MinWidth="100" />
            </Border>

            <!-- ── Content: punishment rows ── -->
            <ScrollViewer MaxHeight="400">
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto"
                                      MinHeight="56"
                                      Margin="20,0">
                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock Classes="Body"
                                                   Text="{Binding Name}" />
                                        <TextBlock Classes="Caption"
                                                   Text="{Binding AssignedLabel}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{conv:Tr Start}"
                                            Click="StartButton_Click"
                                            Classes="Primary compact"
                                            MinHeight="44"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0" />
                                </Grid>
                                <Border Height="0.5"
                                        Background="{DynamicResource BrushBorderSubtle}"
                                        Margin="20,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border>

</Window>