<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:v="using:ChastiMaid.Views.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:conv="using:ChastiMaid.Views.Converters"
             x:DataType="vm:WebcamCaptureDialogViewModel"
             x:Class="ChastiMaid.Views.Dialogs.WebcamCaptureDialog">

    <Panel Classes="dialogOverlay">
        <Border Classes="dialogBox" MaxWidth="560">
            <StackPanel Spacing="{StaticResource SpacingMd}">

                <!-- Preview: webcam + Capture/Record -->
                <StackPanel Spacing="{StaticResource SpacingMd}"
                            IsVisible="{Binding IsPreviewing}"
                            HorizontalAlignment="Center">
                    <TextBlock Classes="Caption"
                               Text="{Binding PreviewMessage}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <v:WebcamPreviewControl Service="{Binding Webcam}" Width="480" Height="360" />
                    <Button Classes="Primary"
                            Command="{Binding CaptureCommand}"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="{Binding CaptureIcon}" IconVariant="Regular" FontSize="16" />
                            <TextBlock Text="{Binding CaptureLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Ghost"
                            Content="{Binding SkipLabel}"
                            Command="{Binding SkipCommand}"
                            HorizontalAlignment="Center"
                            Opacity="0.6" />
                </StackPanel>

                <!-- Recording state: countdown + live preview -->
                <StackPanel Spacing="{StaticResource SpacingMd}"
                            IsVisible="{Binding IsRecording}"
                            HorizontalAlignment="Center">
                    <TextBlock Classes="Body"
                               Text="{conv:Tr WebcamRecordingLabel}"
                               HorizontalAlignment="Center" />
                    <v:WebcamPreviewControl Service="{Binding Webcam}" Width="480" Height="360" />
                    <TextBlock Classes="NumberLarge"
                               Text="{Binding Countdown, StringFormat={}{0}s}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- No webcam state -->
                <StackPanel Spacing="{StaticResource SpacingMd}"
                            IsVisible="{Binding NoWebcam}"
                            HorizontalAlignment="Center">
                    <TextBlock Classes="Body"
                               Text="{conv:Tr WebcamNotDetected}"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="Caption"
                               Text="{Binding NoWebcamMessage}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Button Classes="Primary"
                            Content="{Binding SkipLabel}"
                            Command="{Binding SkipCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Panel>

</UserControl>
