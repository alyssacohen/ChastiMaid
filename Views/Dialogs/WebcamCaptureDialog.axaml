<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:v="using:ChastiMaid.Views.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:WebcamCaptureDialogViewModel"
             x:Class="ChastiMaid.Views.Dialogs.WebcamCaptureDialog">

    <Panel Classes="dialogOverlay">
        <Border Classes="dialogBox fit" Margin="{StaticResource SpacingXxlThickness}">
            <Panel>

                <!-- Preview: webcam + Capture/Record -->
                <Grid IsVisible="{Binding IsPreviewing}" RowDefinitions="Auto,*,Auto">
                    <StackPanel Classes="cameraText">
                        <TextBlock Classes="Caption"
                                   Text="{Binding PreviewMessage}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <v:WebcamPreviewControl Classes="cameraMedia between" Grid.Row="1" Service="{Binding Webcam}" />
                    <StackPanel Classes="cameraText" Grid.Row="2">
                        <ComboBox IsVisible="{Binding Webcam.HasMultipleCameras}"
                                  ItemsSource="{Binding Webcam.AvailableCameras}"
                                  SelectedItem="{Binding Webcam.SelectedCamera}"
                                  HorizontalAlignment="Stretch" />
                        <Button Classes="Primary"
                                Command="{Binding CaptureCommand}"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="{Binding CaptureIcon}" IconVariant="Regular" FontSize="16" />
                                <TextBlock Text="{Binding CaptureLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="Ghost"
                                Content="{Binding SkipLabel}"
                                Command="{Binding SkipCommand}"
                                HorizontalAlignment="Center"
                                Opacity="0.6" />
                    </StackPanel>
                </Grid>

                <!-- Recording state: countdown + live preview -->
                <Grid IsVisible="{Binding IsRecording}" RowDefinitions="Auto,*,Auto">
                    <TextBlock Classes="Body"
                               Text="{l:Tr 'Recording... Strike a pose.'}"
                               HorizontalAlignment="Center" />
                    <v:WebcamPreviewControl Classes="cameraMedia between" Grid.Row="1" Service="{Binding Webcam}" />
                    <StackPanel Classes="cameraText" Grid.Row="2">
                        <ComboBox IsVisible="{Binding Webcam.HasMultipleCameras}"
                                  IsEnabled="False"
                                  ItemsSource="{Binding Webcam.AvailableCameras}"
                                  SelectedItem="{Binding Webcam.SelectedCamera}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Classes="NumberLarge"
                                   Text="{Binding Countdown, StringFormat={}{0}s}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- No webcam state -->
                <StackPanel Classes="cameraText" IsVisible="{Binding NoWebcam}">
                    <TextBlock Classes="Body"
                               Text="{l:Tr 'No webcam detected.'}"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="Caption"
                               Text="{Binding NoWebcamMessage}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Button Classes="Primary"
                            Content="{Binding SkipLabel}"
                            Command="{Binding SkipCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>

            </Panel>
        </Border>
    </Panel>

</UserControl>
