<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:ConfirmDialogViewModel"
             x:Class="ChastiMaid.Views.Dialogs.ConfirmDialog">

    <Panel Classes="dialogOverlay">
        <Border Classes="dialogBox">
            <StackPanel Spacing="16">

                <TextBlock Classes="Heading"
                           Text="{Binding Title}"
                           HorizontalAlignment="Center" />

                <TextBlock Classes="Body"
                           Text="{Binding Message}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="0,8,0,0">
                    <Button Content="{Binding ConfirmLabel}"
                            Command="{Binding ConfirmCommand}"
                            Classes="Primary" />
                    <Button Content="{Binding CancelLabel}"
                            Command="{Binding CancelCommand}"
                            Classes="Ghost"
                            IsVisible="{Binding HasCancel}" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Panel>

</UserControl>