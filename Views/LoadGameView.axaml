<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views"
             x:DataType="vm:LoadGameViewModel"
             x:Class="ChastiMaid.Views.LoadGameView">

    <Panel>

        <StackPanel Classes="pageContent" MaxWidth="900">

            <TextBlock Text="Load Game" Classes="pageTitle" />

            <!-- Slot cards -->
            <ScrollViewer MaxHeight="520">
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SlotCardViewModel">
                            <Button Command="{Binding LoadCommand}"
                                    Classes="slotCard"
                                    HorizontalContentAlignment="Stretch"
                                    CornerRadius="4"
                                    Padding="20,16"
                                    Margin="0,0,0,8"
                                    Opacity="{Binding CardOpacity}">

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="0">
                                        <TextBlock Text="{Binding SlotName}" />
                                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding SavedAt}" Classes="small muted" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding DebtDisplay}" Classes="small" Opacity="0.85" />
                                            <TextBlock Text="{Binding SafeStatus}" Classes="small" Opacity="0.85" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding CompletedLabel}"
                                                   IsVisible="{Binding IsCompleted}"
                                                   Classes="small muted"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>

                                    <!-- Delete button -->
                                    <Button Grid.Column="1"
                                            Command="{Binding DeleteCommand}"
                                            Classes="delete"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No saved games found."
                       HorizontalAlignment="Center"
                       Classes="muted"
                       IsVisible="{Binding !HasSlots}" />

            <Button Content="Back"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Center" />

        </StackPanel>

        <views:ConfirmDialog DataContext="{Binding ActiveDialog}"
                             IsVisible="{Binding $parent[UserControl].((vm:LoadGameViewModel)DataContext).ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />

    </Panel>

</UserControl>
