<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views.Dialogs"
             xmlns:ic="using:ChastiMaid.Views"
             xmlns:controls="using:ChastiMaid.Views.Controls"
             xmlns:conv="using:ChastiMaid.Converters"
             xmlns:l="using:ChastiMaid.Localization"
             x:DataType="vm:LoadGameViewModel"
             x:Class="ChastiMaid.Views.LoadGameView">

    <Panel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="40"
                    Spacing="16">

            <TextBlock Classes="PageTitle"
                       Text="{l:Tr 'Load Game'}"
                       HorizontalAlignment="Center" />

            <ItemsControl ItemsSource="{Binding Slots}" Width="600">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlotCardViewModel">
                        <Grid Margin="0,0,0,8">

                            <!-- Card (clickable to load) -->
                            <Button Command="{Binding LoadCommand}"
                                    Classes="SlotCard"
                                    IsEnabled="{Binding !IsEmpty}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="20,16,68,16">

                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- Slot number -->
                                    <TextBlock Classes="NumberLarge"
                                               Text="{Binding SlotNumber}"
                                               VerticalAlignment="Center"
                                               Opacity="0.8"
                                               Margin="0,0,24,0"
                                               MinWidth="40"
                                               TextAlignment="Center" />

                                    <!-- Save data / empty label; MinHeight keeps every slot the same size -->
                                    <Panel Grid.Column="1"
                                           MinHeight="72"
                                           VerticalAlignment="Center">
                                        <StackPanel Spacing="0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsEmpty}">
                                            <TextBlock Classes="Body"
                                                       Text="{Binding SlotName}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="16"
                                                        Margin="0,6,0,0">
                                                <TextBlock Classes="Caption"
                                                           Text="{Binding SavedAt}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="16"
                                                        Margin="0,4,0,0">
                                                <TextBlock Classes="BodySmall"
                                                           Text="{Binding BalanceLabel}"
                                                           Foreground="{Binding CurrentDebt, Converter={x:Static conv:BalanceBrushConverter.Instance}}"
                                                           Opacity="0.85" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Classes="icon small" Text="{Binding SafeIcon}" />
                                                    <TextBlock Classes="BodySmall"
                                                               Text="{Binding SafeStatus}"
                                                               Opacity="0.85" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4"
                                                        IsVisible="{Binding IsCompleted}"
                                                        Margin="0,6,0,0">
                                                <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.Check}" />
                                                <TextBlock Classes="Caption" Text="{Binding CompletedLabel}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- translators: label of a save slot with no game in it -->
                                        <TextBlock Classes="Caption"
                                                   Text="{l:Tr 'Empty', Context='save slot'}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding IsEmpty}" />
                                    </Panel>
                                </Grid>
                            </Button>

                            <!-- Info (read-only contract) and Delete, stacked and overlaid on top of the card -->
                            <StackPanel HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,20,0"
                                        Spacing="{StaticResource SpacingSm}"
                                        ZIndex="1"
                                        IsVisible="{Binding !IsEmpty}">
                                <Button Command="{Binding InfoCommand}"
                                        Classes="Ghost"
                                        ToolTip.Tip="{l:Tr 'Contract'}"
                                        AutomationProperties.Name="{l:Tr 'Contract'}">
                                    <TextBlock Classes="icon large" Text="{x:Static ic:LucideIcon.Info}" />
                                </Button>
                                <Button Command="{Binding DeleteCommand}"
                                        Classes="Danger"
                                        ToolTip.Tip="{l:Tr 'Delete'}"
                                        AutomationProperties.Name="{l:Tr 'Delete'}">
                                    <TextBlock Classes="icon large" Text="{x:Static ic:LucideIcon.Trash}" />
                                </Button>
                            </StackPanel>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button
                    Command="{Binding BackCommand}"
                    Classes="Ghost"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.ArrowLeft}" />
                    <TextBlock Text="{l:Tr 'Back'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

        </StackPanel>

        <!-- Read-only contract of a save: the New Game sheet with a single Close action -->
        <Panel Classes="dialogOverlay"
               IsVisible="{Binding ContractClauses, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0">
                    <controls:ContractDocument DataContext="{Binding ContractClauses}" />
                </ScrollViewer>
                <Border Grid.Row="1" Classes="contractActionBar">
                    <Button Classes="Primary"
                            HorizontalAlignment="Center"
                            Content="{l:Tr 'Close'}"
                            Command="{Binding CloseContractCommand}" />
                </Border>
            </Grid>
        </Panel>

        <views:ConfirmDialog DataContext="{Binding ActiveDialog}"
                             IsVisible="{Binding $parent[UserControl].((vm:LoadGameViewModel)DataContext).ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />

    </Panel>

</UserControl>