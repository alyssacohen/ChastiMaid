<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views.Dialogs"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:LoadGameViewModel"
             x:Class="ChastiMaid.Views.LoadGameView">

    <Panel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="40"
                    Spacing="16">

            <TextBlock Classes="PageTitle"
                       Text="Load Game"
                       HorizontalAlignment="Center" />

            <ItemsControl ItemsSource="{Binding Slots}" Width="600">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlotCardViewModel">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">

                            <!-- Card (clickable to load) -->
                            <Button Grid.Column="0"
                                    Command="{Binding LoadCommand}"
                                    Classes="SlotCard"
                                    IsEnabled="{Binding !IsEmpty}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="20,16">

                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- Slot number -->
                                    <TextBlock Classes="NumberLarge"
                                               Text="{Binding SlotNumber}"
                                               VerticalAlignment="Center"
                                               Opacity="0.8"
                                               Margin="0,0,24,0"
                                               MinWidth="40"
                                               TextAlignment="Center" />

                                    <!-- Save data -->
                                    <StackPanel Grid.Column="1"
                                                Spacing="0"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding !IsEmpty}">
                                        <TextBlock Classes="Body"
                                                   Text="{Binding SlotName}" />
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="16"
                                                    Margin="0,6,0,0">
                                            <TextBlock Classes="Caption"
                                                       Text="{Binding SavedAt}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="16"
                                                    Margin="0,4,0,0">
                                            <TextBlock Classes="BodySmall"
                                                       Text="{Binding DebtDisplay}"
                                                       Opacity="0.85" />
                                            <TextBlock Classes="BodySmall"
                                                       Text="{Binding SafeStatus}"
                                                       Opacity="0.85" />
                                        </StackPanel>
                                        <TextBlock Classes="Caption"
                                                   Text="{Binding CompletedLabel}"
                                                   IsVisible="{Binding IsCompleted}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>

                                    <!-- Empty slot label -->
                                    <TextBlock Grid.Column="1"
                                               Classes="Caption"
                                               Text="Empty"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsEmpty}" />
                                </Grid>
                            </Button>

                            <!-- Delete button -->
                            <Button Grid.Column="1"
                                    Command="{Binding DeleteCommand}"
                                    Classes="Delete"
                                    Margin="8,0,0,0"
                                    IsVisible="{Binding !IsEmpty}"
                                    Padding="16,12">
                                <ic:SymbolIcon Symbol="Delete" IconVariant="Regular" FontSize="27" />
                            </Button>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Back"
                    Command="{Binding BackCommand}"
                    Classes="Ghost"
                    HorizontalAlignment="Center" />

        </StackPanel>

        <views:ConfirmDialog DataContext="{Binding ActiveDialog}"
                             IsVisible="{Binding $parent[UserControl].((vm:LoadGameViewModel)DataContext).ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />

    </Panel>

</UserControl>
