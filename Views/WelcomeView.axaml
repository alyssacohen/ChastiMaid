<UserControl xmlns:ic="using:ChastiMaid.Views" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views.Dialogs"
             xmlns:l="using:ChastiMaid.Localization"
             x:DataType="vm:WelcomeViewModel"
             x:Class="ChastiMaid.Views.WelcomeView">

    <Panel>

        <StackPanel Margin="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="360"
                    Spacing="0">

            <TextBlock Classes="PageTitle"
                       HorizontalAlignment="Center"
                       Text="ChastiMaid" />

            <Border Height="1"
                    Background="{DynamicResource BrushBorderSubtle}"
                    Margin="0,12,0,16" />

            <TextBlock Classes="EmployerVoice"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,32"
                       Text="{l:Tr 'Please, come in. The door is unlocked. It always is... at first.'}" />

            <Button Classes="Primary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ContinueCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.Play}" />
                    <TextBlock Text="{l:Tr 'Continue'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Classes="Primary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,12,0,0"
                    Command="{Binding NewGameCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.ScrollText}" />
                    <TextBlock Text="{l:Tr 'New Game'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Height="1"
                    Background="{DynamicResource BrushBorderSubtle}"
                    Margin="0,20,0,20" />

            <Button Classes="Ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding LoadGameCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.FolderOpen}" />
                    <TextBlock Text="{l:Tr 'Load Game'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Classes="Ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,12,0,0"
                    Command="{Binding SettingsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.Settings}" />
                    <TextBlock Text="{l:Tr 'Settings'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Name="ExitLabel"
                       Classes="BodySmall"
                       Text="{l:Tr 'Exit'}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       Cursor="Hand">
                <TextBlock.Styles>
                    <Style Selector="TextBlock:pointerover">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    </Style>
                </TextBlock.Styles>
            </TextBlock>

        </StackPanel>

        <views:PlayerIntroDialog
            DataContext="{Binding IntroDialog}"
            IsVisible="{Binding $parent[UserControl].((vm:WelcomeViewModel)DataContext).IntroDialog,
                    Converter={x:Static ObjectConverters.IsNotNull},
                    FallbackValue=False}" />

        <views:ConfirmDialog
            DataContext="{Binding ActiveDialog}"
            IsVisible="{Binding $parent[UserControl].((vm:WelcomeViewModel)DataContext).ActiveDialog,
                    Converter={x:Static ObjectConverters.IsNotNull},
                    FallbackValue=False}" />

    </Panel>

</UserControl>