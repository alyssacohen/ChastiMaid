<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views.Dialogs"
             xmlns:conv="using:ChastiMaid.Views.Converters"
             x:DataType="vm:WelcomeViewModel"
             x:Class="ChastiMaid.Views.WelcomeView">

    <Panel>

        <StackPanel Margin="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="360"
                    Spacing="0">

            <TextBlock Classes="PageTitle"
                       HorizontalAlignment="Center"
                       Text="ChastiMaid" />

            <Border Height="1"
                    Background="{DynamicResource BrushBorderSubtle}"
                    Margin="0,12,0,16" />

            <TextBlock Classes="EmployerVoice"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,32"
                       Text="{conv:Tr WelcomeQuote}" />

            <Button Classes="Primary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{conv:Tr WelcomeContinue}"
                    Command="{Binding ContinueCommand}" />

            <Button Classes="Primary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,12,0,0"
                    Content="{conv:Tr WelcomeNewGame}"
                    Command="{Binding NewGameCommand}" />

            <Border Height="1"
                    Background="{DynamicResource BrushBorderSubtle}"
                    Margin="0,20,0,20" />

            <Button Classes="Ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{conv:Tr WelcomeLoadGame}"
                    Command="{Binding LoadGameCommand}" />

            <Button Classes="Ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,12,0,0"
                    Content="{conv:Tr WelcomeSettings}"
                    Command="{Binding SettingsCommand}" />

            <TextBlock Name="ExitLabel"
                       Classes="BodySmall"
                       Text="{conv:Tr WelcomeExit}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       Cursor="Hand">
                <TextBlock.Styles>
                    <Style Selector="TextBlock:pointerover">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    </Style>
                </TextBlock.Styles>
            </TextBlock>

        </StackPanel>

        <views:ConfirmDialog
            DataContext="{Binding ActiveDialog}"
            IsVisible="{Binding $parent[UserControl].((vm:WelcomeViewModel)DataContext).ActiveDialog,
                    Converter={x:Static ObjectConverters.IsNotNull},
                    FallbackValue=False}" />

    </Panel>

</UserControl>