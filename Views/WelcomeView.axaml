<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:WelcomeViewModel"
             x:Class="ChastiMaid.Views.WelcomeView">

    <Panel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <TextBlock Text="Welcome to ChastiMaid!"
                       Classes="h1"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />
            <TextBlock Text="Do come in. The door is unlocked. It always is... at first."
                       FontSize="{DynamicResource FontSizeBody}"
                       HorizontalAlignment="Center"
                       TextWrapping="WrapWithOverflow" />

            <Button Content="Continue"
                    Command="{Binding ContinueCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="24,12" />
            <Button Content="Load Game"
                    Command="{Binding LoadGameCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="24,12" />
            <Button Content="New Game"
                    Command="{Binding NewGameCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="24,12" />
            <Button Content="Settings"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="24,12" />
            <Button Content="Exit"
                    Command="{Binding ExitCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="24,12" />
        </StackPanel>

        <views:ConfirmDialog DataContext="{Binding ActiveDialog}"
                             IsVisible="{Binding $parent[UserControl].((vm:WelcomeViewModel)DataContext).ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}" />

    </Panel>

</UserControl>
