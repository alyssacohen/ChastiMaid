<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views"
             x:DataType="vm:WelcomeViewModel"
             x:Class="ChastiMaid.Views.WelcomeView">

    <Panel>
        <StackPanel HorizontalAlignment="Center" Spacing="12">
            <TextBlock Text="Welcome to ChastiMaid!" Classes="pageTitle"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Do come in. The door is unlocked. It always is... at first."
                       Classes="subtitle"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Width="400">

            <Button Content="Continue"
                    Command="{Binding ContinueCommand}"
                    Classes="secondary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button Content="Load Game"
                    Command="{Binding LoadGameCommand}"
                    Classes="secondary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button Content="New Game"
                    Command="{Binding NewGameCommand}"
                    Classes="secondary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button Content="Settings"
                    Command="{Binding SettingsCommand}"
                    Classes="secondary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button Content="Exit"
                    Command="{Binding ExitCommand}"
                    Classes="secondary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />

            <!-- Time travel (test mode only) -->
            <Border IsVisible="{Binding IsTestMode}"
                    BorderBrush="{DynamicResource EmergencyBrush}" BorderThickness="1" CornerRadius="4"
                    Padding="12" Margin="0,12,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="⏩ TEST MODE — Time Travel" HorizontalAlignment="Center"
                               Foreground="{DynamicResource EmergencyTextBrush}" Classes="small" />
                    <TextBlock Text="{Binding ClockOffset}" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextHintBrush}" Classes="small muted" />
                    <StackPanel Classes="buttonBar" Margin="0">
                        <Button Content="+1 day" Command="{Binding TimeTravelCommand}" CommandParameter="1" Classes="compact secondary" />
                        <Button Content="+3 days" Command="{Binding TimeTravelCommand}" CommandParameter="3" Classes="compact secondary" />
                        <Button Content="+7 days" Command="{Binding TimeTravelCommand}" CommandParameter="7" Classes="compact secondary" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <views:ConfirmDialog DataContext="{Binding ActiveDialog}"
                             IsVisible="{Binding $parent[UserControl].((vm:WelcomeViewModel)DataContext).ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />

    </Panel>

</UserControl>
