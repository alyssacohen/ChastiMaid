<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views.Dialogs"
             xmlns:conv="using:ChastiMaid.Views.Converters"
             x:DataType="vm:WelcomeViewModel"
             x:Class="ChastiMaid.Views.WelcomeView">

    <Panel>

        <Grid Margin="40"
              ColumnDefinitions="60*,40*">

            <!-- ── LEFT COLUMN ── -->
            <Grid Grid.Column="0"
                  RowDefinitions="*,Auto">

                <!-- Row 0: title + quote -->
                <StackPanel Grid.Row="0"
                            VerticalAlignment="Top"
                            Spacing="0">

                    <TextBlock Classes="PageTitle"
                               Text="ChastiMaid" />

                    <Border Height="1"
                            Background="{DynamicResource BrushBorderSubtle}"
                            Margin="0,12,80,16" />

                    <TextBlock Classes="EmployerVoice"
                               TextWrapping="Wrap"
                               Text="{conv:Tr WelcomeQuote}" />

                </StackPanel>

                <!-- Row 1: test mode panel (auto-height, bottom-anchored) -->
                <StackPanel Grid.Row="1"
                            IsVisible="{Binding IsTestMode}">

                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{StaticResource SpacingLgThickness}"
                            Margin="0,0,80,0">
                        <StackPanel Spacing="8">

                            <TextBlock Classes="LabelUI"
                                       HorizontalAlignment="Center"
                                       Text="{conv:UpperCase {conv:Tr WelcomeTestModeLabel}}" />

                            <TextBlock Classes="Caption"
                                       HorizontalAlignment="Center"
                                       Text="{Binding ClockOffset}" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="8">
                                <Button Classes="SmallGhost"
                                        Content="{conv:Tr WelcomePlusOneDay}"
                                        Command="{Binding TimeTravelCommand}"
                                        CommandParameter="1" />
                                <Button Classes="SmallGhost"
                                        Content="{conv:Tr WelcomePlusThreeDays}"
                                        Command="{Binding TimeTravelCommand}"
                                        CommandParameter="3" />
                                <Button Classes="SmallGhost"
                                        Content="{conv:Tr WelcomePlusSevenDays}"
                                        Command="{Binding TimeTravelCommand}"
                                        CommandParameter="7" />
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>

            <!-- ── RIGHT COLUMN ── -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="0">

                <Button Classes="Primary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Content="{conv:Tr WelcomeContinue}"
                        Command="{Binding ContinueCommand}" />

                <Button Classes="Primary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        FontSize="15"
                        Margin="0,12,0,0"
                        Content="{conv:Tr WelcomeNewGame}"
                        Command="{Binding NewGameCommand}" />

                <Border Height="1"
                        Background="{DynamicResource BrushBorderSubtle}"
                        Margin="0,20,0,20" />

                <Button Classes="Ghost"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Content="{conv:Tr WelcomeLoadGame}"
                        Command="{Binding LoadGameCommand}" />

                <Button Classes="Ghost"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,12,0,0"
                        Content="{conv:Tr WelcomeSettings}"
                        Command="{Binding SettingsCommand}" />

                <TextBlock Name="ExitLabel"
                           Classes="Caption"
                           Text="{conv:Tr WelcomeExit}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           Cursor="Hand">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock:pointerover">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>

            </StackPanel>

        </Grid>

        <views:ConfirmDialog
            DataContext="{Binding ActiveDialog}"
            IsVisible="{Binding $parent[UserControl].((vm:WelcomeViewModel)DataContext).ActiveDialog,
                    Converter={x:Static ObjectConverters.IsNotNull},
                    FallbackValue=False}" />

    </Panel>

</UserControl>