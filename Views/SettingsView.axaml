<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views.Controls"
             xmlns:converters="using:ChastiMaid.Views.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.SettingsView">

    <Panel>

        <!-- ══ Root grid: nav column | content column ══════════════ -->
        <Grid ColumnDefinitions="240,*">

            <!-- ── LEFT NAV PANEL ─────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSurfaceMuted}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Nav header -->
                    <StackPanel Grid.Row="0" Margin="0,20,0,0">
                        <TextBlock Classes="PageTitle"
                                   Text="{converters:Tr SettingsPageTitle}"
                                   Margin="16,0,16,12" />
                        <Border Height="1"
                                Background="{DynamicResource BrushBorderSubtle}"
                                Margin="12,0,12,8" />
                    </StackPanel>

                    <!-- Nav items -->
                    <StackPanel Grid.Row="1" Spacing="0">
                        <RadioButton Classes="navItem"
                                     Command="{Binding SetTabCommand}"
                                     CommandParameter="0"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=0, Mode=OneWay}">
                            <views:DirtyTabHeader Text="{converters:Tr SettingsTabGeneral}" IsDirty="{Binding IsGeneralDirty}" />
                        </RadioButton>
                        <RadioButton Classes="navItem"
                                     Command="{Binding SetTabCommand}"
                                     CommandParameter="1"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=1, Mode=OneWay}">
                            <views:DirtyTabHeader Text="{converters:Tr SettingsTabChores}" IsDirty="{Binding IsChoresDirty}" />
                        </RadioButton>
                        <RadioButton Classes="navItem"
                                     Command="{Binding SetTabCommand}"
                                     CommandParameter="2"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=2, Mode=OneWay}">
                            <views:DirtyTabHeader Text="{converters:Tr SettingsTabPunishments}" IsDirty="{Binding IsPunishmentsDirty}" />
                        </RadioButton>
                        <RadioButton Classes="navItem"
                                     Command="{Binding SetTabCommand}"
                                     CommandParameter="3"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=3, Mode=OneWay}">
                            <views:DirtyTabHeader Text="{converters:Tr SettingsTabWardrobe}" IsDirty="{Binding IsWardrobeDirty}" />
                        </RadioButton>
                        <RadioButton Classes="navItem"
                                     Command="{Binding SetTabCommand}"
                                     CommandParameter="4"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=4, Mode=OneWay}">
                            <views:DirtyTabHeader Text="{converters:Tr SettingsTabOutfitRules}" IsDirty="{Binding IsRulesDirty}" />
                        </RadioButton>
                    </StackPanel>

                    <!-- Save / Back at bottom of nav -->
                    <StackPanel Grid.Row="2" Margin="12,0,12,20" Spacing="8">
                        <Border Height="1"
                                Background="{DynamicResource BrushBorderSubtle}"
                                Margin="0,0,0,4" />
                        <Button Command="{Binding SaveCommand}"
                                Classes="Primary"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ic:SymbolIcon Symbol="Save" IconVariant="Regular" FontSize="16" />
                                <TextBlock Text="{converters:Tr Save}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="{converters:Tr Back}"
                                Command="{Binding BackCommand}"
                                Classes="Ghost"
                                HorizontalContentAlignment="Center"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ── CONTENT AREA ───────────────────────────────────── -->
            <Panel Grid.Column="1">

                <!-- ==================== GENERAL ==================== -->
                <ScrollViewer
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=0}"
                    Padding="24,0,32,0"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="0" Margin="0,0,0,24">
                        <TextBlock Classes="SectionTitle" Text="{converters:Tr SettingsTabGeneral}" Margin="0,20,0,8" />
                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,16" />

                        <!-- Player -->
                        <TextBlock Classes="Heading" Text="{converters:Tr SettingsHeadingPlayer}" Margin="0,0,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsFieldName}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Classes="underline" Text="{Binding PlayerName}" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsAutoSaveMin}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding AutoSaveInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}"
                                                   Minimum="1" Maximum="60" FormatString="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Game Balance -->
                        <TextBlock Classes="Heading" Text="{converters:Tr SettingsHeadingGameBalance}" Margin="0,8,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsMinDebt}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding MinDebt, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0}"
                                                   Minimum="0" Increment="50" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsMaxDebt}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding MaxDebt, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0}"
                                                   Minimum="0" Increment="50" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsDailyInterestRate}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding DailyInterestRate, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0}"
                                                   Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Session Timing -->
                        <TextBlock Classes="Heading" Text="{converters:Tr SettingsHeadingSessionTiming}" Margin="0,8,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsIdleWageAmount}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding IdleWageAmount, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0}"
                                                   Minimum="0" Increment="1" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsWageInterval}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding IdleWageInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}"
                                                   Minimum="1" Maximum="120" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsPopupMin}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding PopupMinInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=10}"
                                                   Minimum="10" Increment="10" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsPopupMax}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding PopupMaxInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=10}"
                                                   Minimum="10" Increment="10" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsPopupTimeout}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding PopupTimeout, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=5}"
                                                   Minimum="5" Maximum="60" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsHydrationMinInterval}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding HydrationMinInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}"
                                                   Minimum="1" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsCurtsyVideoDuration}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding CurtsyVideoDuration, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=2}"
                                                   Minimum="2" Maximum="30" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsQuoteListenTimeout}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding QuoteListenTimeout, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=5}"
                                                   Minimum="5" Maximum="120" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsQuoteRecognitionSensitivity}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding QuoteRecognitionSensitivity, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0.6}"
                                                   Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsWebcamStatus}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="BodySmall" Text="{Binding WebcamStatusDisplay}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsSpeechRecognitionStatus}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="BodySmall" Text="{Binding SpeechRecognitionStatusDisplay}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Capture -->
                        <TextBlock Classes="Heading" Text="{converters:Tr SettingsHeadingCapture}" Margin="0,8,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsCaptureMin}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding CaptureMinInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}"
                                                   Minimum="1" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsCaptureMax}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Classes="underline stacked-spinner"
                                                   Value="{Binding CaptureMaxInterval, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=1}"
                                                   Minimum="1" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr SettingsCamera}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableCameras}"
                                              SelectedItem="{Binding SelectedCameraIndex}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Language -->
                        <TextBlock Classes="Heading" Text="{converters:Tr LanguageHeading}" Margin="0,8,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Classes="BodySmall" Text="{converters:Tr LanguageFieldLabel}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>
                                <TextBlock Classes="Caption" Text="{converters:Tr LanguageRestartNotice}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== CHORES ==================== -->
                <Grid
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=1}"
                    RowDefinitions="Auto,*,Auto" Margin="24,0,32,16">
                    <StackPanel Grid.Row="0">
                        <TextBlock Classes="SectionTitle" Text="{converters:Tr SettingsTabChores}" Margin="0,20,0,8" />
                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,8" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Name="ChoresScroll">
                        <ItemsControl ItemsSource="{Binding Chores}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChoreEditViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="8">
                                                <Grid ColumnDefinitions="*,100,100,100">
                                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {converters:Tr SettingsFieldName}}" />
                                                        <TextBox Classes="underline" Text="{Binding Name}" PlaceholderText="{converters:Tr SettingsChoreNamePlaceholder}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {converters:Tr SettingsFieldValue}}" />
                                                        <TextBox Classes="underline"
                                                                 Text="{Binding Value, Converter={x:Static converters:NumericTextConverter.Instance}, ConverterParameter=0}"
                                                                 PlaceholderText="{converters:Tr SettingsPlaceholderZero}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {converters:Tr SettingsFieldFreqDays}}" />
                                                        <TextBox Classes="underline"
                                                                 Text="{Binding FrequencyDays, Converter={x:Static converters:NumericTextConverter.Instance}, ConverterParameter=1}"
                                                                 PlaceholderText="{converters:Tr SettingsPlaceholderZero}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Spacing="2">
                                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {converters:Tr SettingsFieldMinCompletionMinutes}}" />
                                                        <TextBox Classes="underline"
                                                                 Text="{Binding MinCompletionMinutes, Converter={x:Static converters:NumericTextConverter.Instance}, ConverterParameter=0}"
                                                                 PlaceholderText="{converters:Tr SettingsPlaceholderZero}" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="LabelUI" Text="{converters:UpperCase {converters:Tr SettingsFieldDescription}}" />
                                                    <TextBox Classes="underline" Text="{Binding Description}"
                                                             PlaceholderText="{converters:Tr SettingsOptionalDescriptionPlaceholder}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding DeleteCommand}" Classes="Delete"
                                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Command="{Binding AddChoreCommand}" Classes="Add">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Add" IconVariant="Regular" FontSize="18" />
                            <TextBlock Text="{converters:Tr SettingsAddChore}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ==================== PUNISHMENTS ==================== -->
                <Grid
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=2}"
                    RowDefinitions="Auto,*,Auto" Margin="24,0,32,16">
                    <StackPanel Grid.Row="0">
                        <TextBlock Classes="SectionTitle" Text="{converters:Tr SettingsTabPunishments}" Margin="0,20,0,8" />
                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,8" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Name="PunishmentsScroll">
                        <ItemsControl ItemsSource="{Binding Punishments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PunishmentEditViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="LabelUI" Text="{converters:UpperCase {converters:Tr SettingsFieldName}}" />
                                                    <TextBox Classes="underline" Text="{Binding Name}" PlaceholderText="{converters:Tr SettingsPunishmentNamePlaceholder}" />
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,*">
                                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {converters:Tr SettingsFieldDebtIncrease}}" />
                                                        <NumericUpDown Classes="underline stacked-spinner"
                                                                       Value="{Binding DebtIncrease, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0}"
                                                                       Minimum="0" FormatString="0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Classes="LabelUI" Text="{converters:UpperCase {converters:Tr SettingsFieldRequiredChores}}" />
                                                        <NumericUpDown Classes="underline stacked-spinner"
                                                                       Value="{Binding RequiredChoreCount, Converter={x:Static converters:NullableNumericConverter.Instance}, ConverterParameter=0}"
                                                                       Minimum="0" FormatString="0" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding DeleteCommand}" Classes="Delete"
                                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Command="{Binding AddPunishmentCommand}" Classes="Add">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Add" IconVariant="Regular" FontSize="18" />
                            <TextBlock Text="{converters:Tr SettingsAddPunishment}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ==================== WARDROBE ==================== -->
                <Grid
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=3}"
                    RowDefinitions="Auto,Auto,*,Auto" Margin="16,0,16,8">
                    <StackPanel Grid.Row="0">
                        <TextBlock Classes="SectionTitle" Text="{converters:Tr SettingsTabWardrobe}" Margin="0,20,0,8" />
                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,8" />
                    </StackPanel>
                    <views:WardrobeToolbar Grid.Row="1" Margin="0,0,0,8" />
                    <views:WardrobeTable Grid.Row="2" />
                    <views:WardrobeBulkBar Grid.Row="3" Margin="0,8,0,0" />
                </Grid>

                <!-- ==================== OUTFIT RULES ==================== -->
                <Grid
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=4}"
                    RowDefinitions="Auto,*,Auto" Margin="24,0,32,16">
                    <StackPanel Grid.Row="0">
                        <TextBlock Classes="SectionTitle" Text="{converters:Tr SettingsTabOutfitRules}" Margin="0,20,0,8" />
                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,8" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Name="RulesScroll">
                        <ItemsControl ItemsSource="{Binding OutfitRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OutfitRuleEditViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto,*,Auto">
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding AvailableItems}"
                                                      SelectedItem="{Binding Item}"
                                                      PlaceholderText="{converters:Tr SettingsSelectItemPlaceholder}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{x:Static vm:OutfitRuleEditViewModel.RelationOptions}"
                                                      SelectedItem="{Binding Relation}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0" />
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding AvailableItems}"
                                                      SelectedItem="{Binding RelatedItem}"
                                                      PlaceholderText="{converters:Tr SettingsSelectItemPlaceholder}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center" />
                                            <Button Grid.Column="3"
                                                    Command="{Binding DeleteCommand}"
                                                    Classes="Delete"
                                                    Margin="8,0,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Command="{Binding AddOutfitRuleCommand}" Classes="Add">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Add" IconVariant="Regular" FontSize="18" />
                            <TextBlock Text="{converters:Tr SettingsAddRule}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

            </Panel>

        </Grid>

        <!-- Dialog overlay (floats above everything) -->
        <Panel IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}"
               Classes="dialogOverlay">
            <Border Classes="dialogBox">
                <StackPanel Spacing="16" DataContext="{Binding ActiveDialog}">
                    <TextBlock Classes="Heading"
                               Text="{Binding (vm:SaveDialogViewModel).Title, FallbackValue=''}"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="Body"
                               Text="{Binding (vm:SaveDialogViewModel).Message, FallbackValue=''}"
                               TextAlignment="Center"
                               Opacity="0.85"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <Button Content="{converters:Tr SettingsDiscard}" Command="{Binding (vm:SaveDialogViewModel).DiscardCommand}"
                                Classes="Ghost" />
                        <Button Command="{Binding (vm:SaveDialogViewModel).SaveCommand}" Classes="Primary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="Save" IconVariant="Regular" FontSize="18" />
                                <TextBlock Text="{converters:Tr Save}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="{converters:Tr Cancel}" Command="{Binding (vm:SaveDialogViewModel).CancelCommand}"
                                Classes="Ghost" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

    </Panel>

</UserControl>