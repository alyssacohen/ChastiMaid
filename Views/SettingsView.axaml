<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.SettingsView">

    <Panel>
    <Grid RowDefinitions="Auto,*,Auto" Margin="48,24">

        <TextBlock Grid.Row="0" Text="Settings" Classes="display"
                   HorizontalAlignment="Center" Margin="0,0,0,16" />

        <TabControl Grid.Row="1" Margin="0,0,0,8" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ==================== GENERAL ==================== -->
            <TabItem>
                <TabItem.Header>
                    <views:DirtyTabHeader Text="General" IsDirty="{Binding IsGeneralDirty}" />
                </TabItem.Header>
                <ScrollViewer Padding="16,8,24,8" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="0" Margin="0,0,0,16">

                        <!-- Player -->
                        <TextBlock Text="Player" Classes="heading" Margin="0,0,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Name" Classes="small" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding PlayerName}" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Auto-save (min)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding AutoSaveInterval}" Minimum="1" Maximum="60" FormatString="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Game Balance -->
                        <TextBlock Text="Game Balance" Classes="heading" Margin="0,8,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Min debt" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding MinDebt}" Minimum="0" Increment="50" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Max debt" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding MaxDebt}" Minimum="0" Increment="50" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Daily interest rate" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding DailyInterestRate}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Session Timing -->
                        <TextBlock Text="Session Timing" Classes="heading" Margin="0,8,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Idle wage amount" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding IdleWageAmount}" Minimum="0" Increment="1" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Wage interval (min)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding IdleWageInterval}" Minimum="1" Maximum="120" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Popup min (sec)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding PopupMinInterval}" Minimum="10" Increment="10" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Popup max (sec)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding PopupMaxInterval}" Minimum="10" Increment="10" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Popup timeout (sec)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding PopupTimeout}" Minimum="5" Maximum="60" FormatString="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Capture -->
                        <TextBlock Text="Capture" Classes="heading" Margin="0,8,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Capture min (sec)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding CaptureMinInterval}" Minimum="1" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Capture max (sec)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding CaptureMaxInterval}" Minimum="1" FormatString="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== CHORES ==================== -->
            <TabItem>
                <TabItem.Header>
                    <views:DirtyTabHeader Text="Chores" IsDirty="{Binding IsChoresDirty}" />
                </TabItem.Header>
                <Grid RowDefinitions="*,Auto" Margin="16,16,24,16">
                    <ScrollViewer Grid.Row="0">
                        <ItemsControl ItemsSource="{Binding Chores}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChoreEditViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- Content -->
                                            <StackPanel Grid.Column="0" Spacing="8">
                                                <!-- Row 0: Name, Value, Frequency — all with labels -->
                                                <Grid ColumnDefinitions="*,100,100">
                                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Text="Name" Classes="small" Opacity="0.6" />
                                                        <TextBox Text="{Binding Name}" PlaceholderText="Chore name" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Text="Value" Classes="small" Opacity="0.6" />
                                                        <TextBox Text="{Binding Value}" PlaceholderText="0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="2">
                                                        <TextBlock Text="Freq. (days)" Classes="small" Opacity="0.6" />
                                                        <TextBox Text="{Binding FrequencyDays}" PlaceholderText="0" />
                                                    </StackPanel>
                                                </Grid>
                                                <!-- Row 1: Description -->
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Description" Classes="small" Opacity="0.6" />
                                                    <TextBox Text="{Binding Description}" PlaceholderText="Optional description" />
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Delete button -->
                                            <Button Grid.Column="1" Content="✕" Command="{Binding DeleteCommand}"
                                                    Classes="compact warning" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Content="+ Add Chore" Command="{Binding AddChoreCommand}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <!-- ==================== PUNISHMENTS ==================== -->
            <TabItem>
                <TabItem.Header>
                    <views:DirtyTabHeader Text="Punishments" IsDirty="{Binding IsPunishmentsDirty}" />
                </TabItem.Header>
                <Grid RowDefinitions="*,Auto" Margin="16,16,24,16">
                    <ScrollViewer Grid.Row="0">
                        <ItemsControl ItemsSource="{Binding Punishments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PunishmentEditViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- Content -->
                                            <StackPanel Grid.Column="0" Spacing="8">
                                                <!-- Row 0: Name -->
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Name" Classes="small" Opacity="0.6" />
                                                    <TextBox Text="{Binding Name}" PlaceholderText="Punishment name" />
                                                </StackPanel>
                                                <!-- Row 1: Effects -->
                                                <Grid ColumnDefinitions="*,*">
                                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Text="Debt increase" Classes="small" Opacity="0.6" />
                                                        <NumericUpDown Value="{Binding DebtIncrease}" FormatString="0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="Required chores" Classes="small" Opacity="0.6" />
                                                        <NumericUpDown Value="{Binding RequiredChoreCount}" FormatString="0" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <!-- Delete button -->
                                            <Button Grid.Column="1" Content="✕" Command="{Binding DeleteCommand}"
                                                    Classes="compact warning" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Content="+ Add Punishment" Command="{Binding AddPunishmentCommand}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <!-- ==================== WARDROBE ==================== -->
            <TabItem>
                <TabItem.Header>
                    <views:DirtyTabHeader Text="Wardrobe" IsDirty="{Binding IsWardrobeDirty}" />
                </TabItem.Header>
                <Grid RowDefinitions="*,Auto" Margin="16,16,24,16">
                    <ScrollViewer Grid.Row="0">
                        <ItemsControl ItemsSource="{Binding WardrobeItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WardrobeEditViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- Content -->
                                            <StackPanel Grid.Column="0" Spacing="8">
                                                <!-- Row 1: Name, Multiplier, Weight -->
                                                <Grid ColumnDefinitions="*,120,120">
                                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Text="Name" Classes="small" Opacity="0.6" />
                                                        <TextBox Text="{Binding Name}" PlaceholderText="Item name" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Text="Multiplier" Classes="small" Opacity="0.6" />
                                                        <NumericUpDown Value="{Binding Multiplier}" FormatString="0.0" Increment="0.1" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="2">
                                                        <TextBlock Text="Weight" Classes="small" Opacity="0.6" />
                                                        <NumericUpDown Value="{Binding Weight}" FormatString="0.0" Increment="0.1" />
                                                    </StackPanel>
                                                </Grid>
                                                <!-- Row 2: Layers, Slots, Tags -->
                                                <Grid ColumnDefinitions="*,*,*">
                                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Text="Layers" Classes="small" Opacity="0.6" />
                                                        <WrapPanel>
                                                            <CheckBox Content="undies" IsChecked="{Binding LayerUndies}" FontSize="{DynamicResource FontSizeSmall}" Padding="4,0" />
                                                            <CheckBox Content="base" IsChecked="{Binding LayerBase}" FontSize="{DynamicResource FontSizeSmall}" Padding="4,0" />
                                                            <CheckBox Content="extra" IsChecked="{Binding LayerExtra}" FontSize="{DynamicResource FontSizeSmall}" Padding="4,0" />
                                                            <CheckBox Content="outer" IsChecked="{Binding LayerOuter}" FontSize="{DynamicResource FontSizeSmall}" Padding="4,0" />
                                                            <CheckBox Content="gears" IsChecked="{Binding LayerGears}" FontSize="{DynamicResource FontSizeSmall}" Padding="4,0" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Text="Slots" Classes="small" Opacity="0.6" />
                                                        <TextBox Text="{Binding Slots}" PlaceholderText="torso, legs, feet..." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="2">
                                                        <TextBlock Text="Tags" Classes="small" Opacity="0.6" />
                                                        <TextBox Text="{Binding Tags}" PlaceholderText="maid, elegant..." />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <!-- Delete button -->
                                            <Button Grid.Column="1" Content="✕" Command="{Binding DeleteCommand}"
                                                    Classes="compact warning" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Content="+ Add Item" Command="{Binding AddWardrobeItemCommand}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <!-- ==================== OUTFIT RULES ==================== -->
            <TabItem>
                <TabItem.Header>
                    <views:DirtyTabHeader Text="Outfit Rules" IsDirty="{Binding IsRulesDirty}" />
                </TabItem.Header>
                <Grid RowDefinitions="*,Auto" Margin="16,16,24,16">
                    <Grid.Styles>
                        <Style Selector="ComboBox">
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="MaxHeight" Value="32" />
                        </Style>
                        <Style Selector="ComboBox TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                        </Style>
                    </Grid.Styles>
                    <ScrollViewer Grid.Row="0">
                        <ItemsControl ItemsSource="{Binding OutfitRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OutfitRuleEditViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto,*,Auto">
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding AvailableItems}"
                                                      SelectedItem="{Binding Item}"
                                                      PlaceholderText="Select item"
                                                      HorizontalAlignment="Stretch" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{x:Static vm:OutfitRuleEditViewModel.RelationOptions}"
                                                      SelectedItem="{Binding Relation}"
                                                      Margin="8,0" />
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding AvailableItems}"
                                                      SelectedItem="{Binding RelatedItem}"
                                                      PlaceholderText="Select item"
                                                      HorizontalAlignment="Stretch" />
                                            <Button Grid.Column="3" Content="✕" Command="{Binding DeleteCommand}"
                                                    Classes="compact warning" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Content="+ Add Rule" Command="{Binding AddOutfitRuleCommand}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" />
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,8,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Classes="primary" />
            <Button Content="Back" Command="{Binding BackCommand}" />
        </StackPanel>

    </Grid>

    <!-- Dialog overlay -->
    <Panel IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Panel Background="#AA000000">
            <Border Background="{DynamicResource SystemChromeMediumColor}"
                    CornerRadius="4" Padding="32,24" MaxWidth="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" DataContext="{Binding ActiveDialog}" x:DataType="vm:SaveDialogViewModel">
                    <TextBlock Text="{Binding Title}" Classes="heading" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Message}" TextAlignment="Center" Opacity="0.85" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                        <Button Content="Discard" Command="{Binding DiscardCommand}" />
                        <Button Content="Save" Command="{Binding SaveCommand}" Classes="primary" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>

    </Panel>

</UserControl>
