<UserControl
    x:Class="ChastiMaid.Views.SettingsView"
    x:DataType="vm:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="using:ChastiMaid.Converters"
    xmlns:dialogs="using:ChastiMaid.Views.Dialogs"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:views="using:ChastiMaid.Views.Controls"
    xmlns:vm="using:ChastiMaid.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ChastiMaid.Localization">

    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding QuickSaveCommand}" Gesture="Ctrl+S" />
    </UserControl.KeyBindings>

    <Panel>

        <!--  ══ Root grid: nav column | content column ══════════════  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource NavPanelWidthGridLength}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ── LEFT NAV PANEL ───────────────────────────────────  -->
            <Border
                Background="{DynamicResource BrushSurfaceMuted}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,1,0"
                Grid.Column="0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!--  Nav header  -->
                    <StackPanel Grid.Row="0" Margin="0,20,0,0">
                        <TextBlock
                            Classes="PageTitle"
                            Margin="16,0,16,12"
                            Text="{l:Tr 'Settings'}" />
                        <Border
                            Background="{DynamicResource BrushBorderSubtle}"
                            Height="1"
                            Margin="12,0,12,8" />
                    </StackPanel>

                    <!--  Nav items  -->
                    <StackPanel Grid.Row="1" Spacing="0">
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="0"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=0, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsGeneralDirty}" Text="{l:Tr 'General'}" />
                        </RadioButton>
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="1"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=1, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsChoresDirty}" Text="{l:Tr 'Chores'}" />
                        </RadioButton>
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="2"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=2, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsPopupsDirty}" Text="{l:Tr 'Popups'}" />
                        </RadioButton>
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="3"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=3, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsPunishmentsDirty}" Text="{l:Tr 'Punishments'}" />
                        </RadioButton>
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="4"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=4, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsWardrobeDirty}" Text="{l:Tr 'Wardrobe'}" />
                        </RadioButton>
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="5"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=5, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsRulesDirty}" Text="{l:Tr 'Outfit Rules'}" />
                        </RadioButton>
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="6"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=6, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsPermissionsDirty}" Text="{l:Tr 'Permissions'}" />
                        </RadioButton>
                    </StackPanel>

                    <!--  Save / Back at bottom of nav  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="12,0,12,20"
                        Spacing="8">
                        <Border
                            Background="{DynamicResource BrushBorderSubtle}"
                            Height="1"
                            Margin="0,0,0,4" />
                        <Button
                            Classes="Ghost"
                            Command="{Binding QuickSaveCommand}"
                            HorizontalAlignment="Stretch">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ic:SymbolIcon
                                    FontSize="16"
                                    IconVariant="Regular"
                                    Symbol="Save" />
                                <TextBlock Text="{l:Tr 'Save'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Classes="Primary"
                            Command="{Binding SaveCommand}"
                            HorizontalAlignment="Stretch">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ic:SymbolIcon
                                    FontSize="16"
                                    IconVariant="Regular"
                                    Symbol="Save" />
                                <TextBlock Text="{l:Tr 'Save &amp; Back'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Classes="Ghost"
                            Command="{Binding BackCommand}"
                            Content="{l:Tr 'Back'}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    </StackPanel>

                </Grid>
            </Border>

            <!--  ── CONTENT AREA ─────────────────────────────────────  -->
            <Panel Grid.Column="1">

                <!--  ==================== GENERAL ====================  -->
                <views:SettingsGeneralTab IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=0}" />

                <!--  ==================== CHORES ====================  -->
                <views:SettingsChoresTab IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=1}" />

                <!--  ==================== POPUPS ====================  -->
                <views:SettingsPopupsTab IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=2}" />

                <!--  ==================== PUNISHMENTS ====================  -->
                <views:SettingsPunishmentsTab IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=3}" />

                <!--  ==================== WARDROBE ====================  -->
                <!--  Wrapped so the visibility binding still reads SettingsViewModel, not the tab's own DataContext  -->
                <Panel IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=4}">
                    <views:SettingsWardrobeTab DataContext="{Binding Wardrobe}" />
                </Panel>

                <!--  ==================== OUTFIT RULES ====================  -->
                <views:SettingsOutfitRulesTab IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=5}" />

                <!--  ==================== PERMISSIONS ====================  -->
                <views:SettingsPermissionsTab IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=6}" />

            </Panel>

        </Grid>

        <!--  Dialog overlay (floats above everything)  -->
        <Panel Classes="dialogOverlay" IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Classes="dialogBox">
                <StackPanel DataContext="{Binding ActiveDialog}" Spacing="16">
                    <TextBlock
                        Classes="Heading"
                        HorizontalAlignment="Center"
                        Text="{Binding (vm:SaveDialogViewModel).Title, FallbackValue=''}" />
                    <TextBlock
                        Classes="Body"
                        Opacity="0.85"
                        Text="{Binding (vm:SaveDialogViewModel).Message, FallbackValue=''}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Classes="Ghost"
                            Command="{Binding (vm:SaveDialogViewModel).DiscardCommand}"
                            Content="{l:Tr 'Discard'}" />
                        <Button Classes="Primary" Command="{Binding (vm:SaveDialogViewModel).SaveCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon
                                    FontSize="18"
                                    IconVariant="Regular"
                                    Symbol="Save" />
                                <TextBlock Text="{l:Tr 'Save'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Classes="Ghost"
                            Command="{Binding (vm:SaveDialogViewModel).CancelCommand}"
                            Content="{l:Tr 'Cancel'}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!--  Contract import replace-confirmation  -->
        <dialogs:ConfirmDialog
            DataContext="{Binding ContractDialog}"
            IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ContractDialog, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />

        <views:SettingsTestOutfitOverlay />

    </Panel>

</UserControl>