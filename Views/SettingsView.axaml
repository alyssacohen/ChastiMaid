<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views.Controls"
             xmlns:converters="using:ChastiMaid.Views.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.SettingsView">

    <Panel>

        <!-- ══ Root grid: nav column | content column ══════════════ -->
        <Grid ColumnDefinitions="240,*">

            <!-- ── LEFT NAV PANEL ─────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSurfaceMuted}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Nav header -->
                    <StackPanel Grid.Row="0" Margin="0,20,0,0">
                        <TextBlock Classes="PageTitle"
                                   Text="{converters:Tr SettingsPageTitle}"
                                   Margin="16,0,16,12" />
                        <Border Height="1"
                                Background="{DynamicResource BrushBorderSubtle}"
                                Margin="12,0,12,8" />
                    </StackPanel>

                    <!-- Nav items -->
                    <StackPanel Grid.Row="1" Spacing="0">
                        <RadioButton Classes="navItem"
                                     Command="{Binding SetTabCommand}"
                                     CommandParameter="0"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=0, Mode=OneWay}">
                            <views:DirtyTabHeader Text="{converters:Tr SettingsTabGeneral}" IsDirty="{Binding IsGeneralDirty}" />
                        </RadioButton>
                        <RadioButton Classes="navItem"
                                     Command="{Binding SetTabCommand}"
                                     CommandParameter="1"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=1, Mode=OneWay}">
                            <views:DirtyTabHeader Text="{converters:Tr SettingsTabChores}" IsDirty="{Binding IsChoresDirty}" />
                        </RadioButton>
                        <RadioButton Classes="navItem"
                                     Command="{Binding SetTabCommand}"
                                     CommandParameter="2"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=2, Mode=OneWay}">
                            <views:DirtyTabHeader Text="{converters:Tr SettingsTabPunishments}" IsDirty="{Binding IsPunishmentsDirty}" />
                        </RadioButton>
                        <RadioButton Classes="navItem"
                                     Command="{Binding SetTabCommand}"
                                     CommandParameter="3"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=3, Mode=OneWay}">
                            <views:DirtyTabHeader Text="{converters:Tr SettingsTabWardrobe}" IsDirty="{Binding IsWardrobeDirty}" />
                        </RadioButton>
                        <RadioButton Classes="navItem"
                                     Command="{Binding SetTabCommand}"
                                     CommandParameter="4"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=4, Mode=OneWay}">
                            <views:DirtyTabHeader Text="{converters:Tr SettingsTabOutfitRules}" IsDirty="{Binding IsRulesDirty}" />
                        </RadioButton>
                    </StackPanel>

                    <!-- Save / Back at bottom of nav -->
                    <StackPanel Grid.Row="2" Margin="12,0,12,20" Spacing="8">
                        <Border Height="1"
                                Background="{DynamicResource BrushBorderSubtle}"
                                Margin="0,0,0,4" />
                        <Button Command="{Binding SaveCommand}"
                                Classes="Primary"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ic:SymbolIcon Symbol="Save" IconVariant="Regular" FontSize="16" />
                                <TextBlock Text="{converters:Tr Save}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="{converters:Tr Back}"
                                Command="{Binding BackCommand}"
                                Classes="Ghost"
                                HorizontalContentAlignment="Center"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ── CONTENT AREA ───────────────────────────────────── -->
            <Panel Grid.Column="1">

                <!-- ==================== GENERAL ==================== -->
                <views:SettingsGeneralTab
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=0}" />

                <!-- ==================== CHORES ==================== -->
                <views:SettingsChoresTab
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=1}" />

                <!-- ==================== POPUP & PUNISHMENTS ==================== -->
                <views:SettingsPunishmentsTab
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=2}" />

                <!-- ==================== WARDROBE ==================== -->
                <Grid
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=3}"
                    RowDefinitions="Auto,Auto,*,Auto" Margin="16,0,16,8">
                    <StackPanel Grid.Row="0">
                        <TextBlock Classes="SectionTitle" Text="{converters:Tr SettingsTabWardrobe}" Margin="0,20,0,8" />
                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,8" />
                    </StackPanel>
                    <views:WardrobeToolbar Grid.Row="1" Margin="0,0,0,8" />
                    <views:WardrobeTable Grid.Row="2" />
                    <views:WardrobeBulkBar Grid.Row="3" Margin="0,8,0,0" />
                </Grid>

                <!-- ==================== OUTFIT RULES ==================== -->
                <views:SettingsOutfitRulesTab
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=4}" />

            </Panel>

        </Grid>

        <!-- Dialog overlay (floats above everything) -->
        <Panel IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}"
               Classes="dialogOverlay">
            <Border Classes="dialogBox">
                <StackPanel Spacing="16" DataContext="{Binding ActiveDialog}">
                    <TextBlock Classes="Heading"
                               Text="{Binding (vm:SaveDialogViewModel).Title, FallbackValue=''}"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="Body"
                               Text="{Binding (vm:SaveDialogViewModel).Message, FallbackValue=''}"
                               TextAlignment="Center"
                               Opacity="0.85"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <Button Content="{converters:Tr SettingsDiscard}" Command="{Binding (vm:SaveDialogViewModel).DiscardCommand}"
                                Classes="Ghost" />
                        <Button Command="{Binding (vm:SaveDialogViewModel).SaveCommand}" Classes="Primary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="Save" IconVariant="Regular" FontSize="18" />
                                <TextBlock Text="{converters:Tr Save}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="{converters:Tr Cancel}" Command="{Binding (vm:SaveDialogViewModel).CancelCommand}"
                                Classes="Ghost" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

    </Panel>

</UserControl>