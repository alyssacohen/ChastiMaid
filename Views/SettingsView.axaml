<UserControl
    x:Class="ChastiMaid.Views.SettingsView"
    x:DataType="vm:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="using:ChastiMaid.Converters"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:views="using:ChastiMaid.Views.Controls"
    xmlns:vm="using:ChastiMaid.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding QuickSaveCommand}" Gesture="Ctrl+S" />
    </UserControl.KeyBindings>

    <Panel>

        <!--  ══ Root grid: nav column | content column ══════════════  -->
        <Grid ColumnDefinitions="320,*">

            <!--  ── LEFT NAV PANEL ───────────────────────────────────  -->
            <Border
                Background="{DynamicResource BrushSurfaceMuted}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,1,0"
                Grid.Column="0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!--  Nav header  -->
                    <StackPanel Grid.Row="0" Margin="0,20,0,0">
                        <TextBlock
                            Classes="PageTitle"
                            Margin="16,0,16,12"
                            Text="{converters:Tr SettingsPageTitle}" />
                        <Border
                            Background="{DynamicResource BrushBorderSubtle}"
                            Height="1"
                            Margin="12,0,12,8" />
                    </StackPanel>

                    <!--  Nav items  -->
                    <StackPanel Grid.Row="1" Spacing="0">
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="0"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=0, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsGeneralDirty}" Text="{converters:Tr SettingsTabGeneral}" />
                        </RadioButton>
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="1"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=1, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsChoresDirty}" Text="{converters:Tr SettingsTabChores}" />
                        </RadioButton>
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="2"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=2, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsPunishmentsDirty}" Text="{converters:Tr SettingsTabPunishments}" />
                        </RadioButton>
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="3"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=3, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsWardrobeDirty}" Text="{converters:Tr SettingsTabWardrobe}" />
                        </RadioButton>
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="4"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=4, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsRulesDirty}" Text="{converters:Tr SettingsTabOutfitRules}" />
                        </RadioButton>
                        <RadioButton
                            Classes="navItem"
                            Command="{Binding SetTabCommand}"
                            CommandParameter="5"
                            IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=5, Mode=OneWay}">
                            <views:DirtyTabHeader IsDirty="{Binding IsPermissionsDirty}" Text="{converters:Tr SettingsTabPermissions}" />
                        </RadioButton>
                    </StackPanel>

                    <!--  Save / Back at bottom of nav  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="12,0,12,20"
                        Spacing="8">
                        <Border
                            Background="{DynamicResource BrushBorderSubtle}"
                            Height="1"
                            Margin="0,0,0,4" />
                        <Button
                            Classes="Primary"
                            Command="{Binding SaveCommand}"
                            HorizontalAlignment="Stretch">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ic:SymbolIcon
                                    FontSize="16"
                                    IconVariant="Regular"
                                    Symbol="Save" />
                                <TextBlock Text="{converters:Tr SettingsSaveAndBack}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Classes="Ghost"
                            Command="{Binding BackCommand}"
                            Content="{converters:Tr Back}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    </StackPanel>

                </Grid>
            </Border>

            <!--  ── CONTENT AREA ─────────────────────────────────────  -->
            <Panel Grid.Column="1">

                <!--  ==================== GENERAL ====================  -->
                <views:SettingsGeneralTab IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=0}" />

                <!--  ==================== CHORES ====================  -->
                <views:SettingsChoresTab IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=1}" />

                <!--  ==================== POPUP & PUNISHMENTS ====================  -->
                <views:SettingsPunishmentsTab IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=2}" />

                <!--  ==================== WARDROBE ====================  -->
                <Grid
                    IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=3}"
                    Margin="0,0,0,8"
                    RowDefinitions="Auto,Auto,*,Auto">
                    <StackPanel Grid.Row="0" Margin="16,0,16,0">
                        <TextBlock
                            Classes="SectionTitle"
                            Margin="0,20,0,8"
                            Text="{converters:Tr SettingsTabWardrobe}" />
                        <Border
                            Background="{DynamicResource BrushBorderSubtle}"
                            Height="1"
                            Margin="0,0,0,8" />
                    </StackPanel>
                    <views:WardrobeToolbar Grid.Row="1" Margin="16,0,16,8" />
                    <views:WardrobeTable Grid.Row="2" />
                    <views:WardrobeBulkBar Grid.Row="3" Margin="16,8,16,0" />
                </Grid>

                <!--  ==================== OUTFIT RULES ====================  -->
                <views:SettingsOutfitRulesTab IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=4}" />

                <!--  ==================== PERMISSIONS ====================  -->
                <views:SettingsPermissionsTab IsVisible="{Binding SelectedTabIndex, Converter={x:Static converters:IntEqualityConverter.Instance}, ConverterParameter=5}" />

            </Panel>

        </Grid>

        <!--  Dialog overlay (floats above everything)  -->
        <Panel Classes="dialogOverlay" IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Classes="dialogBox">
                <StackPanel DataContext="{Binding ActiveDialog}" Spacing="16">
                    <TextBlock
                        Classes="Heading"
                        HorizontalAlignment="Center"
                        Text="{Binding (vm:SaveDialogViewModel).Title, FallbackValue=''}" />
                    <TextBlock
                        Classes="Body"
                        Opacity="0.85"
                        Text="{Binding (vm:SaveDialogViewModel).Message, FallbackValue=''}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Classes="Ghost"
                            Command="{Binding (vm:SaveDialogViewModel).DiscardCommand}"
                            Content="{converters:Tr SettingsDiscard}" />
                        <Button Classes="Primary" Command="{Binding (vm:SaveDialogViewModel).SaveCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon
                                    FontSize="18"
                                    IconVariant="Regular"
                                    Symbol="Save" />
                                <TextBlock Text="{converters:Tr Save}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Classes="Ghost"
                            Command="{Binding (vm:SaveDialogViewModel).CancelCommand}"
                            Content="{converters:Tr Cancel}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

    </Panel>

</UserControl>