<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:views="using:ChastiMaid.Views.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:SettingsViewModel"
             x:Class="ChastiMaid.Views.SettingsView">

    <Panel>
    <Grid RowDefinitions="Auto,*,Auto" Margin="48,24">

        <TextBlock Grid.Row="0" Text="Settings" Classes="display"
                   HorizontalAlignment="Center" Margin="0,0,0,16" />

        <TabControl Grid.Row="1" Margin="0,0,0,8" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ==================== GENERAL ==================== -->
            <TabItem>
                <TabItem.Header>
                    <views:DirtyTabHeader Text="General" IsDirty="{Binding IsGeneralDirty}" />
                </TabItem.Header>
                <ScrollViewer Padding="16,8,24,8" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="0" Margin="0,0,0,16">

                        <!-- Player -->
                        <TextBlock Text="Player" Classes="heading" Margin="0,0,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Name" Classes="small" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding PlayerName}" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Auto-save (min)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding AutoSaveInterval}" Minimum="1" Maximum="60" FormatString="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Game Balance -->
                        <TextBlock Text="Game Balance" Classes="heading" Margin="0,8,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Min debt" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding MinDebt}" Minimum="0" Increment="50" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Max debt" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding MaxDebt}" Minimum="0" Increment="50" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Daily interest rate" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding DailyInterestRate}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.00" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Session Timing -->
                        <TextBlock Text="Session Timing" Classes="heading" Margin="0,8,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Idle wage amount" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding IdleWageAmount}" Minimum="0" Increment="1" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Wage interval (min)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding IdleWageInterval}" Minimum="1" Maximum="120" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Popup min (sec)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding PopupMinInterval}" Minimum="10" Increment="10" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Popup max (sec)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding PopupMaxInterval}" Minimum="10" Increment="10" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Popup timeout (sec)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding PopupTimeout}" Minimum="5" Maximum="60" FormatString="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Capture -->
                        <TextBlock Text="Capture" Classes="heading" Margin="0,8,0,8" />
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Capture min (sec)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding CaptureMinInterval}" Minimum="1" FormatString="0" />
                                </Grid>
                                <Grid ColumnDefinitions="160,*">
                                    <TextBlock Text="Capture max (sec)" Classes="small" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding CaptureMaxInterval}" Minimum="1" FormatString="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== CHORES ==================== -->
            <TabItem>
                <TabItem.Header>
                    <views:DirtyTabHeader Text="Chores" IsDirty="{Binding IsChoresDirty}" />
                </TabItem.Header>
                <Grid RowDefinitions="*,Auto" Margin="16,16,24,16">
                    <ScrollViewer Grid.Row="0" Name="ChoresScroll">
                        <ItemsControl ItemsSource="{Binding Chores}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChoreEditViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- Content -->
                                            <StackPanel Grid.Column="0" Spacing="8">
                                                <!-- Row 0: Name, Value, Frequency — all with labels -->
                                                <Grid ColumnDefinitions="*,100,100">
                                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Text="Name" Classes="fieldLabel" />
                                                        <TextBox Text="{Binding Name}" PlaceholderText="Chore name" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Text="Value" Classes="fieldLabel" />
                                                        <TextBox Text="{Binding Value}" PlaceholderText="0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="2">
                                                        <TextBlock Text="Freq. (days)" Classes="fieldLabel" />
                                                        <TextBox Text="{Binding FrequencyDays}" PlaceholderText="0" />
                                                    </StackPanel>
                                                </Grid>
                                                <!-- Row 1: Description -->
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Description" Classes="fieldLabel" />
                                                    <TextBox Text="{Binding Description}" PlaceholderText="Optional description" />
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Delete button -->
                                            <Button Grid.Column="1" Command="{Binding DeleteCommand}"
                                                    Classes="delete" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Command="{Binding AddChoreCommand}" Classes="add">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Add" IconVariant="Regular" FontSize="18" />
                            <TextBlock Text="Add Chore" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <!-- ==================== PUNISHMENTS ==================== -->
            <TabItem>
                <TabItem.Header>
                    <views:DirtyTabHeader Text="Punishments" IsDirty="{Binding IsPunishmentsDirty}" />
                </TabItem.Header>
                <Grid RowDefinitions="*,Auto" Margin="16,16,24,16">
                    <ScrollViewer Grid.Row="0" Name="PunishmentsScroll">
                        <ItemsControl ItemsSource="{Binding Punishments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PunishmentEditViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- Content -->
                                            <StackPanel Grid.Column="0" Spacing="8">
                                                <!-- Row 0: Name -->
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Name" Classes="fieldLabel" />
                                                    <TextBox Text="{Binding Name}" PlaceholderText="Punishment name" />
                                                </StackPanel>
                                                <!-- Row 1: Effects -->
                                                <Grid ColumnDefinitions="*,*">
                                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                        <TextBlock Text="Debt increase" Classes="fieldLabel" />
                                                        <NumericUpDown Value="{Binding DebtIncrease}" FormatString="0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="Required chores" Classes="fieldLabel" />
                                                        <NumericUpDown Value="{Binding RequiredChoreCount}" FormatString="0" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <!-- Delete button -->
                                            <Button Grid.Column="1" Command="{Binding DeleteCommand}"
                                                    Classes="delete" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Command="{Binding AddPunishmentCommand}" Classes="add">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Add" IconVariant="Regular" FontSize="18" />
                            <TextBlock Text="Add Punishment" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <!-- ==================== WARDROBE ==================== -->
            <TabItem>
                <TabItem.Header>
                    <views:DirtyTabHeader Text="Wardrobe" IsDirty="{Binding IsWardrobeDirty}" />
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*,Auto" Margin="16,8,16,8">
                    <views:WardrobeToolbar Grid.Row="0" Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1" Name="WardrobeScroll">
                        <views:WardrobeTable />
                    </ScrollViewer>
                    <views:WardrobeBulkBar Grid.Row="2" Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <!-- ==================== OUTFIT RULES ==================== -->
            <TabItem>
                <TabItem.Header>
                    <views:DirtyTabHeader Text="Outfit Rules" IsDirty="{Binding IsRulesDirty}" />
                </TabItem.Header>
                <Grid RowDefinitions="*,Auto" Margin="16,16,24,16">
                    <ScrollViewer Grid.Row="0" Name="RulesScroll">
                        <ItemsControl ItemsSource="{Binding OutfitRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OutfitRuleEditViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto,*,Auto">
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding AvailableItems}"
                                                      SelectedItem="{Binding Item}"
                                                      PlaceholderText="Select item"
                                                      HorizontalAlignment="Stretch" 
                                                      VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{x:Static vm:OutfitRuleEditViewModel.RelationOptions}"
                                                      SelectedItem="{Binding Relation}"
                                                      HorizontalAlignment="Stretch" 
                                                      VerticalAlignment="Center"
                                                      Margin="8,0" />
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding AvailableItems}"
                                                      SelectedItem="{Binding RelatedItem}"
                                                      PlaceholderText="Select item"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Command="{Binding DeleteCommand}"
                                                    Classes="delete" Margin="8,0,0,0" 
                                                    HorizontalAlignment="Stretch" 
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Command="{Binding AddOutfitRuleCommand}" Classes="add">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Add" IconVariant="Regular" FontSize="18" />
                            <TextBlock Text="Add Rule" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="2" Classes="buttonBar" Margin="0,8,0,0">
            <Button Command="{Binding SaveCommand}" Classes="primary">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="Save" IconVariant="Regular" FontSize="18" />
                    <TextBlock Text="Save" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Content="Back" Command="{Binding BackCommand}" Classes="secondary" />
        </StackPanel>

    </Grid>

    <!-- Dialog overlay -->
    <Panel IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}"
           Classes="dialogOverlay">
        <Border Classes="dialogBox">
            <StackPanel Spacing="16" DataContext="{Binding ActiveDialog}" x:DataType="vm:SaveDialogViewModel">
                <TextBlock Text="{Binding Title}" Classes="heading" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Message}" TextAlignment="Center" Opacity="0.85" TextWrapping="Wrap" />
                <StackPanel Classes="buttonBar" Margin="0,8,0,0">
                    <Button Content="Discard" Command="{Binding DiscardCommand}" Classes="secondary" />
                    <Button Command="{Binding SaveCommand}" Classes="primary">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Save" IconVariant="Regular" FontSize="18" />
                            <TextBlock Text="Save" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="secondary" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>

    </Panel>

</UserControl>
