<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:conv="using:ChastiMaid.Views.Converters"
             x:DataType="vm:WritingLinesPunishmentViewModel"
             x:Class="ChastiMaid.Views.WritingLinesPunishmentView"
             Background="{DynamicResource BrushWindowBackground}">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="600"
                Margin="40"
                Spacing="16">

        <!-- Active -->
        <StackPanel IsVisible="{Binding !IsResult}" Spacing="16">
            <TextBlock Classes="Caption"
                       Text="{Binding CompletedLines, StringFormat={conv:Tr WritingLinesProgressFormat}}"
                       HorizontalAlignment="Center" />
            <TextBlock Classes="EmployerVoice"
                       Text="{Binding SentenceText}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBox Text="{Binding TypedText}"
                     PlaceholderText="{conv:Tr WritingLinesTypeHereWatermark}"
                     HorizontalAlignment="Stretch" />
            <TextBlock Classes="Caption"
                       Text="{Binding MistakeCount, StringFormat={conv:Tr WritingLinesMistakeCountFormat}}"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding HasMistakes}" />
            <Button Content="{conv:Tr CornertimeAbandon}"
                    Command="{Binding AbandonCommand}"
                    Classes="Danger compact"
                    HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Result -->
        <StackPanel IsVisible="{Binding IsResult}" Spacing="16">
            <TextBlock Classes="EmployerVoice"
                       Text="{Binding ResultMessage}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Content="{conv:Tr PunishmentDone}"
                    Command="{Binding DoneCommand}"
                    Classes="Primary"
                    HorizontalAlignment="Center" />
        </StackPanel>

    </StackPanel>

</UserControl>
