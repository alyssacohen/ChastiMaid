<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:models="using:ChastiMaid.Models"
             x:DataType="vm:WritingLinesPunishmentViewModel"
             x:Class="ChastiMaid.Views.WritingLinesPunishmentView"
             Background="{DynamicResource BrushWindowBackground}">

    <Grid>

        <!-- Active -->
        <ScrollViewer IsVisible="{Binding !IsResult}">
            <StackPanel HorizontalAlignment="Center"
                        MaxWidth="640"
                        Margin="40"
                        Spacing="16">

                <TextBlock Classes="SectionTitle"
                           Text="{l:Tr 'Writing Lines'}"
                           HorizontalAlignment="Center" />

                <!-- Target phrase — static, always shown in full -->
                <TextBlock Classes="LabelUI" Text="{l:Tr 'The line to copy'}" />
                <Border Classes="card">
                    <TextBlock Classes="Typewriter" Text="{Binding SentenceText}" TextWrapping="Wrap" />
                </Border>

                <!-- Live typing field: a real TextBox with its own native caret. Text is bound one-way from
                     TypedText (always a valid correct prefix — see ViewModel), so what's on screen is
                     always shown in the "correct" color; PlaceholderText shows the muted target phrase
                     through the same control so its font/size/position can never drift out of alignment
                     with the typed text. Keystrokes are intercepted in code-behind (Tunnel
                     TextInput/KeyDown) and routed into the ViewModel exactly as before — the TextBox never
                     inserts characters itself. -->
                <TextBlock Classes="LabelUI" Text="{l:Tr 'Your writing'}" />
                <Border Classes="card" Background="{DynamicResource BrushSurfaceMuted}">
                    <TextBox x:Name="CaptureBox"
                             Classes="typewriterInput"
                             IsUndoEnabled="False"
                             Text="{Binding TypedText, Mode=OneWay}"
                             PlaceholderText="{Binding SentenceText}" />
                </Border>
                <TextBlock Classes="Caption"
                           Text="{Binding MistakeCountText}"
                           IsVisible="{Binding HasMistakes}" />

                <!-- History — most recent attempt on top; scrolls internally so it never pushes the stats
                     row and the abandon button off screen as it grows. -->
                <TextBlock Classes="LabelUI" Text="{l:Tr 'Previous lines'}" />
                <Border Classes="card">
                    <ScrollViewer MaxHeight="180">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WritingLineHistoryEntry">
                                    <TextBlock Classes="TypewriterSmall" TextWrapping="Wrap">
                                        <Run Text="{Binding CorrectPart}" Foreground="{DynamicResource BrushTypingCorrect}" />
                                        <Run Text="{Binding ErrorChar}" Foreground="{DynamicResource BrushButtonDanger}" FontWeight="Bold" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Live performance stats -->
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Classes="statCard">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Classes="LabelUI" Text="{l:Tr 'Progress'}" HorizontalAlignment="Center" />
                            <TextBlock Classes="NumberLarge" Text="{Binding ProgressPercentText}" HorizontalAlignment="Center" />
                            <TextBlock Classes="Caption" Text="{Binding ProgressHintText}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="statCard">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Classes="LabelUI" Text="{l:Tr 'CPM'}" HorizontalAlignment="Center" />
                            <TextBlock Classes="NumberLarge" Text="{Binding CpmText}" HorizontalAlignment="Center" />
                            <TextBlock Classes="Caption" Text="{l:Tr 'Char/min'}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="statCard">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Classes="LabelUI" Text="{l:Tr 'Accuracy'}" HorizontalAlignment="Center" />
                            <TextBlock Classes="NumberLarge" Text="{Binding AccuracyText}" HorizontalAlignment="Center" />
                            <TextBlock Classes="Caption" Text="{l:Tr 'Precision'}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="statCard">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Classes="LabelUI" Text="{l:Tr 'Errors'}" HorizontalAlignment="Center" />
                            <TextBlock Classes="NumberLarge" Text="{Binding MistakeCount}" HorizontalAlignment="Center" />
                            <TextBlock Classes="Caption" Text="{l:Tr 'Mistypes'}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Classes="statCard">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Classes="LabelUI" Text="{l:Tr 'Time'}" HorizontalAlignment="Center" />
                            <TextBlock Classes="NumberLarge" Text="{Binding TimeText}" HorizontalAlignment="Center" />
                            <TextBlock Classes="Caption" Text="{l:Tr 'Elapsed'}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Button Content="{l:Tr 'Set Down the Pen'}"
                        Command="{Binding AbandonCommand}"
                        Classes="Danger compact"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <!-- Result -->
        <StackPanel IsVisible="{Binding IsResult}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600"
                    Margin="40"
                    Spacing="16">
            <TextBlock Classes="EmployerVoice"
                       Text="{Binding ResultMessage}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Content="{l:Tr 'Done'}"
                    Command="{Binding DoneCommand}"
                    Classes="Primary"
                    HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Interruption overlay — non-interactive, self-closes after a couple of seconds -->
        <Panel Classes="dialogOverlay" IsVisible="{Binding IsInterruptionVisible}">
            <Border Classes="dialogBox">
                <TextBlock Classes="EmployerVoice"
                           Text="{Binding InterruptionMessage}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
            </Border>
        </Panel>

    </Grid>

</UserControl>
