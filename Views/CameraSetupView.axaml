<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:v="using:ChastiMaid.Views.Controls"
             x:DataType="vm:CameraSetupViewModel"
             x:Class="ChastiMaid.Views.CameraSetupView">

    <StackPanel Classes="pageContent" MaxWidth="600">

        <TextBlock Text="Position the camera" Classes="pageTitle" />

        <TextBlock Text="{Binding ChoreName, StringFormat='Frame your work area for: {0}'}"
                   Classes="subtitle" />

        <v:WebcamPreviewControl Service="{Binding Webcam}" Width="480" Height="360" />

        <StackPanel Classes="buttonBar">
            <Button Content="Confirm" Command="{Binding ConfirmCommand}" Classes="primary" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="secondary" />
        </StackPanel>

    </StackPanel>

</UserControl>
