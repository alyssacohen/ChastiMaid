<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:v="using:ChastiMaid.Views.Controls"
             xmlns:conv="using:ChastiMaid.Converters"
             x:DataType="vm:CameraSetupViewModel"
             x:Class="ChastiMaid.Views.CameraSetupView">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="600"
                Margin="40"
                Spacing="16">

        <TextBlock Classes="PageTitle"
                   Text="{conv:Tr CameraSetupTitle}"
                   HorizontalAlignment="Center" />

        <TextBlock Classes="Body"
                   Text="{Binding ChoreName, StringFormat={conv:Tr CameraSetupFrameFormat}}"
                   HorizontalAlignment="Center" />

        <v:WebcamPreviewControl Service="{Binding Webcam}"
                                Width="480" Height="360"
                                HorizontalAlignment="Center" />

        <ComboBox IsVisible="{Binding Webcam.HasMultipleCameras}"
                  ItemsSource="{Binding Webcam.AvailableCameras}"
                  SelectedItem="{Binding Webcam.SelectedCamera}"
                  HorizontalAlignment="Center"
                  MinWidth="240" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <Button Content="{conv:Tr Confirm}"
                    Command="{Binding ConfirmCommand}"
                    Classes="Primary" />
            <Button Content="{conv:Tr Cancel}"
                    Command="{Binding CancelCommand}"
                    Classes="Ghost" />
        </StackPanel>

    </StackPanel>

</UserControl>