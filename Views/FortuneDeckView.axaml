<UserControl xmlns:ic="using:ChastiMaid.Views" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:conv="using:ChastiMaid.Converters"
             x:DataType="vm:FortuneDeckViewModel"
             x:Class="ChastiMaid.Views.FortuneDeckView">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <Button Grid.Column="0"
                    Command="{Binding BackCommand}"
                    Classes="Ghost">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.ArrowLeft}" />
                    <TextBlock Text="{l:Tr 'Back'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Classes="PageTitle"
                       Text="{l:Tr 'Il Ventaglio della Sorte'}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <TextBlock Classes="LabelUI"
                           Text="{Binding DebtLabel, Converter={x:Static conv:UpperCaseConverter.Instance}}"
                           VerticalAlignment="Center" />
                <TextBlock Classes="NumberLarge"
                           Text="{Binding CurrentDebtDisplay}"
                           Foreground="{Binding CurrentDebt, Converter={x:Static conv:BalanceBrushConverter.Instance}}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Draw area: cosmetic ribbon + reveal panel -->
        <Grid Grid.Row="1" x:Name="DrawArea">
            <!--  Fills the whole cell; card poses are anchored to this canvas's own measured center
                  (FortuneDeckViewModel.AnchorX/AnchorY), not to (0,0) — see SetContainerSize.  -->
            <ItemsControl ItemsSource="{Binding CosmeticCards}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FortuneDeckCardViewModel">
                        <!--  Standard 2:3 card proportions (width:height), so the ribbon reads as
                              playing cards at a glance rather than generic tiles. Width/Height grow for the
                              reveal (not a RenderTransform scale) so text lays out at its real font size
                              instead of being visually stretched along with the frame.  -->
                        <Panel Width="{Binding CardWidth}" Height="{Binding CardHeight}"
                               ZIndex="{Binding ZIndex}"
                               RenderTransformOrigin="0,0"
                               RenderTransform="{Binding Transform}">
                            <!--  A single bound Transform (rather than a TransformGroup of separately-bound
                                  sub-transforms) is the Avalonia idiom that reliably animates via
                                  TransformOperationsTransition — see FortuneDeckCardViewModel.SetPose.  -->
                            <Panel.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut" />
                                    <DoubleTransition Property="Width" Duration="0:0:0.32" Easing="CubicEaseOut" />
                                    <DoubleTransition Property="Height" Duration="0:0:0.32" Easing="CubicEaseOut" />
                                </Transitions>
                            </Panel.Transitions>
                            <!--  Rasterized instead of live SVG — Svg.Controls.Skia.Avalonia doesn't render
                                  <pattern> fills (the diamond motif came through fully transparent), so this
                                  is exported once via Inkscape from Assets/Cards/deck-rear.svg at 3× the
                                  largest on-screen size (172×258 at LiftScale) for crisp upscaling.  -->
                            <Image Source="avares://ChastiMaid/Assets/Cards/deck-rear.png" Stretch="Uniform"
                                   IsVisible="{Binding !IsRevealed}" />
                            <!--  Front face: same card family as the Shop's own tiles (ShopView.axaml) — same
                                  Border.card chrome, same Subheading/BodySmall typography, same title +
                                  description content — just without the owned count and buy button, which
                                  don't apply to a drawn card.  -->
                            <Border Classes="card" Padding="{StaticResource SpacingSmThickness}"
                                    IsVisible="{Binding IsRevealed}">
                                <!--  Faded in separately from the card frame (TextOpacity, set only once the
                                      Width/Height regrow has settled — see RunFlipAsync) so the text never
                                      visibly reflows while the card is still resizing.  -->
                                <StackPanel Spacing="8" Opacity="{Binding TextOpacity}">
                                    <StackPanel.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
                                        </Transitions>
                                    </StackPanel.Transitions>
                                    <TextBlock Classes="Subheading" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Classes="BodySmall"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Footer -->
        <Button Grid.Row="2"
                Command="{Binding DrawCommand}"
                Classes="Amber"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                MinWidth="200"
                Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.Dices}" />
                <TextBlock Text="{Binding DrawButtonLabel}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

    </Grid>

</UserControl>
