<UserControl xmlns:ic="using:ChastiMaid.Views" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:conv="using:ChastiMaid.Converters"
             x:DataType="vm:ShopViewModel"
             x:Class="ChastiMaid.Views.ShopView">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <Button Grid.Column="0"
                    Command="{Binding BackCommand}"
                    Classes="Ghost">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.ArrowLeft}" />
                    <TextBlock Text="{l:Tr 'Back'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Classes="PageTitle"
                       Text="{l:Tr 'The Shop'}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <TextBlock Classes="LabelUI"
                           Text="{Binding DebtLabel, Converter={x:Static conv:UpperCaseConverter.Instance}}"
                           VerticalAlignment="Center" />
                <TextBlock Classes="NumberLarge"
                           Text="{Binding CurrentDebtDisplay}"
                           Foreground="{Binding CurrentDebt, Converter={x:Static conv:BalanceBrushConverter.Instance}}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Card catalogue -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShopCardItemViewModel">
                        <!--  Same 2:3 playing-card proportions as the Fortune Deck's reveal card
                              (172×258, i.e. the 80×120 ribbon card at LiftScale) — one card family
                              across both screens.  -->
                        <Border Classes="card" Width="172" Height="258" Margin="0,0,12,12">
                            <Grid RowDefinitions="*,Auto">
                                <StackPanel Grid.Row="0" Spacing="8">
                                    <TextBlock Classes="Subheading" Text="{Binding Name}" TextWrapping="Wrap" />
                                    <TextBlock Classes="BodySmall"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Classes="Caption" Text="{Binding OwnedDisplay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Classes="Body"
                                                   Text="{Binding PriceDisplay}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Command="{Binding BuyCommand}"
                                                IsEnabled="{Binding CanBuy}"
                                                Classes="Primary compact">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                                <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.ShoppingBag}" />
                                                <TextBlock Text="{l:Tr 'Buy'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Classes="Caption"
                                               Text="{l:Tr 'None left'}"
                                               Foreground="{DynamicResource BrushEmergencyText}"
                                               IsVisible="{Binding !CanBuy}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Fortune Deck entry -->
        <Border Grid.Row="2" Classes="card" Margin="0,16,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="SectionTitle" Text="{l:Tr 'Il Ventaglio della Sorte'}" />
                    <TextBlock Classes="BodySmall"
                               Text="{l:Tr 'You wager, I collect. Do sit down — it will take but a moment.'}"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding OpenFortuneDeckCommand}"
                        Classes="Amber"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                        <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.Dices}" />
                        <TextBlock Text="{Binding FortuneDrawButtonLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>

</UserControl>
