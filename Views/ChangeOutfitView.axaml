<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:ChangeOutfitViewModel"
             x:Class="ChastiMaid.Views.ChangeOutfitView"
             Background="{DynamicResource PageBackgroundBrush}">

    <Grid RowDefinitions="*,Auto">

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="48,36,48,24" MaxWidth="660">

                <!-- Title -->
                <TextBlock Text="Compose an outfit"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="{StaticResource FontSizeDisplay}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Left" />

                <!-- Legend -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">

                    <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,28">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderWarmBrush}" BorderThickness="1"
                                    CornerRadius="2" Padding="8,4,12,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="item" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="selected" FontSize="{DynamicResource FontSizeSmall}" Classes="muted" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AmberBackgroundBrush}"
                                    BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1"
                                    CornerRadius="2" Padding="8,4,12,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AmberBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="item" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource AmberTextBrush}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="required" FontSize="{DynamicResource FontSizeSmall}" Classes="muted" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Opacity="0.28">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="2" Padding="8,4,12,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextHintBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="item" FontSize="{DynamicResource FontSizeSmall}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="unavailable" FontSize="{DynamicResource FontSizeSmall}" Classes="muted" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Layer groups -->
                <ItemsControl ItemsSource="{Binding Layers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LayerGroupViewModel">
                            <StackPanel Margin="0,0,0,28">
                                <!-- Layer header -->
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="0,0,0,8" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="{StaticResource FontSizeBody}" FontStyle="Italic"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="{StaticResource FontSizeSmall}" Classes="muted"
                                                   VerticalAlignment="Bottom"
                                                   Margin="8,0,0,1" />
                                    </StackPanel>
                                </Border>
                                <!-- Chips -->
                                <ItemsControl ItemsSource="{Binding Chips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChipViewModel">
                                            <Button Command="{Binding ToggleCommand}"
                                                    Margin="0,0,8,8"
                                                    Classes.chip="True"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Classes.required="{Binding IsRequired}"
                                                    Classes.disabled="{Binding IsDisabled}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Ellipse Width="5" Height="5"
                                                             Fill="{Binding $parent[Button].Foreground}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky footer: status panel + action bar -->
        <StackPanel Grid.Row="1" Background="{DynamicResource SurfaceBrush}">

            <!-- Status panel (conditional) -->
            <Border IsVisible="{Binding HasWarning}"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="48,12">
                <Grid ColumnDefinitions="Auto,*">
                    <ic:SymbolIcon Grid.Column="0" Symbol="Info" IconVariant="Regular"
                                   FontSize="14" Margin="0,1,10,0"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextHintBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               IsVisible="{Binding IsViolation}"
                               FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap"
                               Foreground="{DynamicResource AmberTextBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               IsVisible="{Binding !IsViolation}"
                               FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextHintBrush}" />
                </Grid>
            </Border>

            <!-- Action bar -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="48,16">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCount}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="{DynamicResource FontSizeBody}" FontStyle="Italic"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="items selected" Classes="small muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Clear" Command="{Binding ClearCommand}" Classes="compact secondary" />
                        <Button Content="Back" Command="{Binding BackCommand}" Classes="compact secondary" />
                        <Button Content="Integrate" Command="{Binding IntegrateCommand}"
                                Classes="primary" IsEnabled="{Binding CanFinalize}" />
                        <Button Content="Save outfit" Command="{Binding SaveOutfitCommand}"
                                Classes="primary" IsEnabled="{Binding CanFinalize}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>

    </Grid>

</UserControl>
