<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:ChangeOutfitViewModel"
             x:Class="ChastiMaid.Views.ChangeOutfitView"
             Background="{DynamicResource BrushWindowBackground}">

    <Grid RowDefinitions="*,Auto">

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="48,36,48,24" MaxWidth="660">

                <TextBlock Classes="PageTitle"
                           Text="Compose an outfit"
                           HorizontalAlignment="Left" />

                <!-- Legend -->
                <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,28">

                        <!-- Selected state -->
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border Background="{DynamicResource BrushSurfaceBase}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1"
                                    CornerRadius="2" Padding="8,4,12,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="5" Height="5"
                                             Fill="{DynamicResource TextSecondary}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Classes="BodySmall" Text="item" />
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="Caption" Text="selected" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Required state -->
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border Background="{DynamicResource BrushAmberBackground}"
                                    BorderBrush="{DynamicResource BrushAmber}" BorderThickness="1"
                                    CornerRadius="2" Padding="8,4,12,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="5" Height="5"
                                             Fill="{DynamicResource BrushAmber}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Classes="BodySmall"
                                               Text="item"
                                               Foreground="{DynamicResource BrushAmberText}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="Caption" Text="required" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Unavailable state -->
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Opacity="0.28">
                            <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1"
                                    CornerRadius="2" Padding="8,4,12,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="5" Height="5"
                                             Fill="{DynamicResource TextMuted}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Classes="BodySmall" Text="item" />
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="Caption" Text="unavailable" VerticalAlignment="Center" />
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Layer groups -->
                <ItemsControl ItemsSource="{Binding Layers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LayerGroupViewModel">
                            <StackPanel Margin="0,0,0,28">
                                <!-- Layer header -->
                                <Border BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,0,0,8" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="SectionTitle"
                                                   Text="{Binding DisplayName}" />
                                        <TextBlock Classes="Caption"
                                                   Text="{Binding Description}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="8,0,0,2" />
                                    </StackPanel>
                                </Border>
                                <!-- Chips -->
                                <ItemsControl ItemsSource="{Binding Chips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChipViewModel">
                                            <Button Command="{Binding ToggleCommand}"
                                                    Margin="0,0,8,8"
                                                    Classes.chip="True"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Classes.required="{Binding IsRequired}"
                                                    Classes.disabled="{Binding IsDisabled}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Ellipse Width="5" Height="5"
                                                             Fill="{Binding $parent[Button].Foreground}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky footer: status panel + action bar -->
        <StackPanel Grid.Row="1" Background="{DynamicResource BrushSurfaceBase}">

            <!-- Status panel (conditional) -->
            <Border IsVisible="{Binding HasWarning}"
                    Background="{DynamicResource BrushSurfaceBase}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="48,12">
                <Grid ColumnDefinitions="Auto,*">
                    <ic:SymbolIcon Grid.Column="0" Symbol="Info" IconVariant="Regular"
                                   FontSize="14" Margin="0,1,10,0"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Grid.Column="1"
                               Classes="BodySmall"
                               Text="{Binding StatusMessage}"
                               IsVisible="{Binding IsViolation}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushAmberText}" />
                    <TextBlock Grid.Column="1"
                               Classes="BodySmall"
                               Text="{Binding StatusMessage}"
                               IsVisible="{Binding !IsViolation}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Action bar -->
            <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="48,16">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="SectionTitle"
                                   Text="{Binding SelectedCount}"
                                   FontStyle="Italic" />
                        <TextBlock Classes="Caption"
                                   Text="items selected"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Clear" Command="{Binding ClearCommand}"
                                Classes="Ghost compact" />
                        <Button Content="Back" Command="{Binding BackCommand}"
                                Classes="Ghost compact" />
                        <Button Content="Integrate" Command="{Binding IntegrateCommand}"
                                Classes="Primary" IsEnabled="{Binding CanFinalize}" />
                        <Button Content="Save outfit" Command="{Binding SaveOutfitCommand}"
                                Classes="Primary" IsEnabled="{Binding CanFinalize}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>

    </Grid>

</UserControl>