<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:ChangeOutfitViewModel"
             x:Class="ChastiMaid.Views.ChangeOutfitView">

    <UserControl.Styles>
        <!-- Chip base -->
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="6,6,14,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#15FFFFFF" />
        </Style>

        <!-- Chip selected -->
        <Style Selector="Button.chip.selected">
            <Setter Property="Background" Value="#F1EFE8" />
            <Setter Property="BorderBrush" Value="#888780" />
            <Setter Property="Foreground" Value="#2C2C2A" />
        </Style>

        <!-- Chip required -->
        <Style Selector="Button.chip.required">
            <Setter Property="Background" Value="#FAEEDA" />
            <Setter Property="BorderBrush" Value="#BA7517" />
            <Setter Property="Foreground" Value="#633806" />
        </Style>

        <!-- Chip disabled -->
        <Style Selector="Button.chip.disabled">
            <Setter Property="Opacity" Value="0.32" />
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,32" MaxWidth="660">

            <!-- Title -->
            <TextBlock Text="Compose an outfit" Classes="pageTitle" />
            <TextBlock Text="SELECT ITEMS BY LAYER" Classes="small muted"
                       Margin="0,0,0,24" LetterSpacing="3" />

            <!-- Legend -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Background="#F1EFE8" BorderBrush="#888780" BorderThickness="1"
                            CornerRadius="2" Padding="6,3">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="5" Height="5" Fill="#5F5E5A" />
                            <TextBlock Text="item" FontSize="11" Foreground="#2C2C2A" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="selected" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Background="#FAEEDA" BorderBrush="#BA7517" BorderThickness="1"
                            CornerRadius="2" Padding="6,3">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="5" Height="5" Fill="#BA7517" />
                            <TextBlock Text="item" FontSize="11" Foreground="#633806" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="required" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border BorderBrush="#40FFFFFF" BorderThickness="1"
                            CornerRadius="2" Padding="6,3" Opacity="0.4">
                        <TextBlock Text="item" FontSize="11" />
                    </Border>
                    <TextBlock Text="unavailable" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Layer groups -->
            <ItemsControl ItemsSource="{Binding Layers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LayerGroupViewModel">
                        <StackPanel Margin="0,0,0,24">
                            <!-- Layer header -->
                            <Border BorderBrush="#25FFFFFF" BorderThickness="0,0,0,1"
                                    Padding="0,0,0,8" Margin="0,0,0,10">
                                <TextBlock Text="{Binding LayerName}"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="15" FontStyle="Italic"
                                           Classes="muted" />
                            </Border>
                            <!-- Chips -->
                            <ItemsControl ItemsSource="{Binding Chips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChipViewModel">
                                        <Button Command="{Binding ToggleCommand}"
                                                Margin="0,0,7,7"
                                                Classes.chip="True"
                                                Classes.selected="{Binding IsSelected}"
                                                Classes.required="{Binding IsRequired}"
                                                Classes.disabled="{Binding IsDisabled}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="5" Height="5"
                                                         Fill="{Binding $parent[Button].Foreground}" />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Status block -->
            <Border IsVisible="{Binding HasWarning}"
                    BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="2"
                    Padding="14,14" Margin="0,4,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="13" TextWrapping="Wrap"
                           Foreground="#BA7517" />
            </Border>

            <!-- Action bar -->
            <Border BorderBrush="#25FFFFFF" BorderThickness="0,1,0,0"
                    Padding="0,20,0,0" Margin="0,24,0,0">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Left: count -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCount}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="22" FontStyle="Italic" />
                        <TextBlock Text="items selected" Classes="small muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Right: buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Clear" Command="{Binding ClearCommand}" Classes="compact" />
                        <Button Content="Integrate" Command="{Binding IntegrateCommand}"
                                Classes="primary" IsEnabled="{Binding CanFinalize}" />
                        <Button Content="Save outfit" Command="{Binding SaveOutfitCommand}"
                                Classes="primary" IsEnabled="{Binding CanFinalize}" />
                        <Button Content="Back" Command="{Binding BackCommand}" Classes="compact" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
