<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:ChangeOutfitViewModel"
             x:Class="ChastiMaid.Views.ChangeOutfitView"
             Background="#1F1F1E">

    <UserControl.Styles>
        <!-- Chip base -->
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="8,6,14,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#18FFFFFF" />
        </Style>

        <!-- Chip selected -->
        <Style Selector="Button.chip.selected">
            <Setter Property="Background" Value="#F1EFE8" />
            <Setter Property="BorderBrush" Value="#888780" />
            <Setter Property="Foreground" Value="#2C2C2A" />
        </Style>
        <Style Selector="Button.chip.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E4E2DB" />
        </Style>

        <!-- Chip required -->
        <Style Selector="Button.chip.required">
            <Setter Property="Background" Value="#FAEEDA" />
            <Setter Property="BorderBrush" Value="#BA7517" />
            <Setter Property="Foreground" Value="#633806" />
        </Style>
        <Style Selector="Button.chip.required:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F5E4C8" />
        </Style>

        <!-- Chip disabled: dimmed, no hover, cursor arrow -->
        <Style Selector="Button.chip.disabled">
            <Setter Property="Opacity" Value="0.28" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.chip.disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="48,36,48,24" MaxWidth="660">

                <!-- Title -->
                    <TextBlock Text="Compose an outfit"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="{StaticResource FontSizeDisplay}"
                           HorizontalAlignment="Left" />

                <!-- Legend -->
            <Border BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1">

                <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Border Background="#F1EFE8" BorderBrush="#888780" BorderThickness="1"
                                CornerRadius="2" Padding="8,4,12,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="5" Height="5" Fill="#5F5E5A" VerticalAlignment="Center" />
                                <TextBlock Text="item" FontSize="11" Foreground="#2C2C2A" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="selected" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Border Background="#FAEEDA" BorderBrush="#BA7517" BorderThickness="1"
                                CornerRadius="2" Padding="8,4,12,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="5" Height="5" Fill="#BA7517" VerticalAlignment="Center" />
                                <TextBlock Text="item" FontSize="11" Foreground="#633806" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="required" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Opacity="0.28">
                        <Border BorderBrush="#40FFFFFF" BorderThickness="1"
                                CornerRadius="2" Padding="8,4,12,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="5" Height="5" Fill="#CCCCCC" VerticalAlignment="Center" />
                                <TextBlock Text="item" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="unavailable" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

                <!-- Layer groups -->
                <ItemsControl ItemsSource="{Binding Layers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LayerGroupViewModel">
                            <StackPanel Margin="0,0,0,28">
                                <!-- Layer header -->
                                <Border BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1"
                                        Padding="0,0,0,8" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="{StaticResource FontSizeBody}" FontStyle="Italic" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="{StaticResource FontSizeSmall}" Classes="muted"
                                                   VerticalAlignment="Bottom"
                                                   Margin="8,0,0,1" />
                                    </StackPanel>
                                </Border>
                                <!-- Chips -->
                                <ItemsControl ItemsSource="{Binding Chips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChipViewModel">
                                            <Button Command="{Binding ToggleCommand}"
                                                    Margin="0,0,8,8"
                                                    Classes.chip="True"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Classes.required="{Binding IsRequired}"
                                                    Classes.disabled="{Binding IsDisabled}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Ellipse Width="5" Height="5"
                                                             Fill="{Binding $parent[Button].Foreground}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky footer: status panel + action bar -->
        <StackPanel Grid.Row="1" Background="#1F1F1E">

            <!-- Status panel (conditional) -->
            <Border IsVisible="{Binding HasWarning}"
                    Background="#141413"
                    BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0"
                    Padding="48,12">
                <Grid ColumnDefinitions="Auto,*">
                    <ic:SymbolIcon Grid.Column="0" Symbol="Info" IconVariant="Regular"
                                   FontSize="14" Margin="0,1,10,0"
                                   VerticalAlignment="Top"
                                   Foreground="#7A7870" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               IsVisible="{Binding IsViolation}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="#BA7517" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               IsVisible="{Binding !IsViolation}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="#9A9690" />
                </Grid>
            </Border>

            <!-- Action bar -->
            <Border BorderBrush="#25FFFFFF" BorderThickness="0,1,0,0"
                    Padding="48,16">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCount}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="22" FontStyle="Italic" />
                        <TextBlock Text="items selected" Classes="small muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Clear" Command="{Binding ClearCommand}" Classes="compact" />
                        <Button Content="Back" Command="{Binding BackCommand}" Classes="compact" />
                        <Button Content="Integrate" Command="{Binding IntegrateCommand}"
                                Classes="primary" IsEnabled="{Binding CanFinalize}" />
                        <Button Content="Save outfit" Command="{Binding SaveOutfitCommand}"
                                Classes="primary" IsEnabled="{Binding CanFinalize}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>

    </Grid>

</UserControl>
