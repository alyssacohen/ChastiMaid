<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:v="using:ChastiMaid.Views.Controls"
             xmlns:d="using:ChastiMaid.Views.Dialogs"
             xmlns:conv="using:ChastiMaid.Views.Converters"
             x:DataType="vm:ConfirmOutfitViewModel"
             x:Class="ChastiMaid.Views.ConfirmOutfitView"
             Background="{DynamicResource BrushWindowBackground}">

    <Panel>

        <Grid RowDefinitions="Auto,*,Auto">

        <!-- Row 0: Top section — confirmation controls -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    MaxWidth="640"
                    Margin="{StaticResource SpacingXxlThickness}"
                    Spacing="{StaticResource SpacingLg}">

            <TextBlock Classes="PageTitle"
                       Text="Outfit Confirmed"
                       HorizontalAlignment="Center" />

            <TextBlock Classes="EmployerVoice"
                       Text="Go change into the outfit below. When you are ready, press the button to confirm."
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

        </StackPanel>

        <!-- Row 1: Bottom section — layer cards + multiplier row (fixed, does not reflow) -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center"
                        MaxWidth="720"
                        Margin="{StaticResource SpacingXxlThickness}"
                        Spacing="{StaticResource SpacingMd}">

                <!-- Layer cards -->
                <ItemsControl ItemsSource="{Binding OutfitVm.Layers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource SpacingMd}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OutfitLayerViewModel">
                            <Border Background="{StaticResource BrushSurfaceBase}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="{StaticResource SpacingMdThickness}">
                                <Grid ColumnDefinitions="160,*">

                                    <!-- Left: layer category + layer index -->
                                    <StackPanel Grid.Column="0"
                                                Spacing="{StaticResource SpacingXs}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">
                                        <TextBlock Classes="LabelUI"
                                                   Text="{Binding LayerLabel, Converter={x:Static conv:UpperCaseConverter.Instance}}" />
                                        <TextBlock Classes="BodySmall"
                                                   Text="{Binding LayerIndex}"
                                                   Foreground="{StaticResource TextAccent}" />
                                    </StackPanel>

                                    <!-- Right: chip badges showing item name + body zones -->
                                    <ItemsControl Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OutfitLayerItem">
                                                <Border Classes="chip info"
                                                        Background="{StaticResource BrushSurfaceMuted}"
                                                        BorderBrush="{StaticResource BrushBorderSubtle}"
                                                        BorderThickness="1">
                                                    <StackPanel Spacing="{StaticResource SpacingXs}">
                                                        <TextBlock Classes="chip-label"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock Classes="BodySmall"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   Text="{Binding ZonesDisplay}"
                                                                   IsVisible="{Binding ZonesDisplay,
                                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Multiplier row -->
                <Border Background="{DynamicResource BrushSurfaceMuted}"
                        CornerRadius="6"
                        Padding="{StaticResource SpacingMdThickness}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="{StaticResource SpacingMd}">
                        <TextBlock Classes="Caption"
                                   Text="Total Multiplier"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock Classes="NumberMedium"
                                   Text="{Binding MultiplierDisplay}"
                                   Foreground="{StaticResource TextAccent}" />
                        <Rectangle Width="1"
                                   Height="20"
                                   Fill="{DynamicResource BrushBorderSubtle}"
                                   VerticalAlignment="Center" />
                        <TextBlock Classes="Caption"
                                   Text="{Binding ItemCountDisplay}"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        
        <StackPanel Grid.Row="2" Spacing="{StaticResource SpacingMd}"
                    Margin="{StaticResource SpacingButtonStripThickness}">
            <Button Classes="Primary"
                    Content="I'm wearing the outfit, continue"
                    Command="{Binding ConfirmOutfitCommand}"
                    HorizontalAlignment="Center" />
        </StackPanel>

        </Grid>

        <!-- Webcam capture dialog overlay -->
        <ContentControl Content="{Binding ActiveDialog}"
                        IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:WebcamCaptureDialogViewModel">
                    <d:WebcamCaptureDialog />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Panel>

</UserControl>
