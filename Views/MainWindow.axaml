<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ChastiMaid.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:vm="using:ChastiMaid.ViewModels"
        WindowState="FullScreen"
        Title="ChastiMaid"
        Background="{StaticResource BrushWindowBackground}">

    <!--
    Design.DataContext omesso: MainWindowViewModel richiede parametri nel costruttore.
    Il preview XAML non è supportato per questa finestra.
    -->

    <TransitioningContentControl Content="{Binding CurrentPage}">
        <TransitioningContentControl.PageTransition>
            <CrossFade Duration="0:00:00.250" />
        </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>

</Window>