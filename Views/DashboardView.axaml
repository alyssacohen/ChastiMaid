<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:DashboardViewModel"
             x:Class="ChastiMaid.Views.DashboardView">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,16">
            <TextBlock Text="{Binding DebtDisplay}"
                       Classes="h1"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- Chore list -->
        <ScrollViewer Grid.Row="1" Padding="24,0">
            <ItemsControl ItemsSource="{Binding Chores}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChoreItemViewModel">
                        <Border Padding="16,12" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='{}{0:F0} cr'}"
                                           Opacity="0.7" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="24,16">
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <Button Content="Complete Game"
                        Command="{Binding CompleteGameCommand}"
                        IsVisible="{Binding CanComplete}"
                        HorizontalAlignment="Center"
                        Padding="48,14" />
                <Button Content="End Session"
                        Command="{Binding EndSessionCommand}"
                        HorizontalAlignment="Center"
                        Padding="48,14" />
            </StackPanel>
        </Border>

    </Grid>

</UserControl>
