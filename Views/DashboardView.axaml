<UserControl
    Background="{DynamicResource BrushWindowBackground}"
    x:Class="ChastiMaid.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="using:ChastiMaid.Views.Controls"
    xmlns:conv="using:ChastiMaid.Converters"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:v="using:ChastiMaid.Views.Dialogs"
    xmlns:vm="using:ChastiMaid.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Panel>

        <!--
            ══════════════════════════════════════════════════════
            IDLE MODE — full dashboard layout
            ══════════════════════════════════════════════════════
        -->
        <Grid IsVisible="{Binding IsIdle}">

            <!--  ── PORTRAIT layout ──  -->
            <Grid IsVisible="{Binding !IsLandscape}" RowDefinitions="Auto,*,Auto">

                <!--  Status bar  -->
                <Border
                    Background="{DynamicResource BrushSurfaceBase}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Grid.Row="0"
                    Height="50"
                    Padding="16,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Ellipse
                                Fill="{DynamicResource BrushStatusIdle}"
                                Height="10"
                                Width="10" />
                            <TextBlock
                                Classes="BodySmall"
                                Text="{conv:Tr DashboardStatusIdle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Classes="SmallGhost"
                            Command="{Binding ToggleOutfitDrawerCommand}"
                            Content="{conv:Tr DashboardOutfitToggle}"
                            Grid.Column="2"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!--  Scrollable content  -->
                <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="16,16,16,0" Spacing="20">

                        <controls:DebtWidget DebtSettled="{Binding DebtSettled}" DebtTotal="{Binding DebtTotal}" />

                        <!--  Tasks section  -->
                        <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                <TextBlock
                                    Classes="SectionTitle"
                                    Grid.Column="0"
                                    Text="{conv:Tr DashboardTasksHeading}"
                                    VerticalAlignment="Center" />
                                <Border
                                    Background="{DynamicResource BrushSurfaceBase}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                    <TextBlock Classes="Caption" Text="{Binding Tasks.Count}" />
                                </Border>
                                <Button
                                    Classes="Add compact"
                                    Command="{Binding OpenAddTaskFormCommand}"
                                    Content="{conv:Tr DashboardAddOccasionalTask}"
                                    Grid.Column="2"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Border Background="{DynamicResource BrushBorderSubtle}" Height="1" />

                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskItemViewModel">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="56">
                                                <Ellipse
                                                    Fill="{Binding StatusBrushKey, Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}"
                                                    Grid.Column="0"
                                                    Height="8"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Width="8" />
                                                <TextBlock
                                                    Classes="Body"
                                                    Grid.Column="1"
                                                    Text="{Binding Name}"
                                                    VerticalAlignment="Center" />
                                                <Button
                                                    Classes="SmallGhost"
                                                    Command="{Binding ToggleExpandedCommand}"
                                                    Grid.Column="2"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center">
                                                    <ic:SymbolIcon
                                                        FontSize="14"
                                                        IconVariant="Regular"
                                                        Symbol="ChevronDown" />
                                                </Button>
                                                <Button
                                                    Classes="Primary compact"
                                                    Command="{Binding StartCommand}"
                                                    Content="{conv:Tr Start}"
                                                    Grid.Column="3"
                                                    MinHeight="44"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel
                                                IsVisible="{Binding IsExpanded}"
                                                Margin="18,0,0,10"
                                                Spacing="2">
                                                <TextBlock
                                                    Classes="Caption"
                                                    Foreground="{Binding StatusBrushKey, Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}"
                                                    Text="{Binding LastCompletedLabel}" />
                                                <TextBlock Classes="Caption" Text="{Binding FrequencyLabel}" />
                                            </StackPanel>
                                            <Border Background="{DynamicResource BrushBorderSubtle}" Height="0.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Classes="Caption"
                                HorizontalAlignment="Center"
                                Margin="0,16"
                                Text="{conv:Tr DashboardNoPendingTasks}">
                                <TextBlock.IsVisible>
                                    <Binding
                                        Converter="{x:Static ObjectConverters.IsNull}"
                                        FallbackValue="False"
                                        Path="Tasks.Count" />
                                </TextBlock.IsVisible>
                            </TextBlock>

                        </StackPanel>

                        <!--  Punishment button  -->
                        <Button
                            Classes="Amber"
                            Command="{Binding OpenPunishmentsCommand}"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsEnabled="{Binding HasPendingPunishments}"
                            Padding="16,14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="Body"
                                    Grid.Column="0"
                                    Text="{conv:Tr PendingPunishments}"
                                    VerticalAlignment="Center" />
                                <Border
                                    Background="{DynamicResource BrushAmberText}"
                                    CornerRadius="12"
                                    Grid.Column="1"
                                    Height="24"
                                    IsVisible="{Binding HasPendingPunishments}"
                                    MinWidth="24"
                                    Padding="6,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Classes="Caption"
                                        Foreground="{DynamicResource BrushWindowBackground}"
                                        HorizontalAlignment="Center"
                                        Text="{Binding PendingPunishmentsCount}"
                                        VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Border Height="16" />

                    </StackPanel>
                </ScrollViewer>

                <!--  Action bar (pinned bottom)  -->
                <Border
                    Background="{DynamicResource BrushSurfaceBase}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Grid.Row="2"
                    Padding="8,8">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">

                        <Button
                            Classes="Ghost compact"
                            Command="{Binding RequestPermissionCommand}"
                            Content="{conv:Tr DashboardRequestPermission}"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />

                        <Button
                            Classes="Ghost compact"
                            Command="{Binding OpenShopCommand}"
                            Content="{conv:Tr DashboardShop}"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />

                        <Button
                            Classes="Danger compact"
                            Command="{Binding EndSessionCommand}"
                            Content="{conv:Tr DashboardEndSession}"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />

                    </Grid>
                </Border>

            </Grid>

            <!--  ── LANDSCAPE layout ──  -->
            <Grid IsVisible="{Binding IsLandscape}" RowDefinitions="Auto,*,Auto">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource NavPanelWidthGridLength}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Status bar (spans both columns)  -->
                <Border
                    Background="{DynamicResource BrushSurfaceBase}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Grid.ColumnSpan="2"
                    Grid.Row="0"
                    Height="50"
                    Padding="16,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Ellipse
                                Fill="{DynamicResource BrushStatusIdle}"
                                Height="10"
                                Width="10" />
                            <TextBlock
                                Classes="BodySmall"
                                Text="{conv:Tr DashboardStatusIdle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Classes="SmallGhost"
                            Command="{Binding ToggleOutfitDrawerCommand}"
                            Content="{conv:Tr DashboardOutfitToggle}"
                            Grid.Column="2"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!--  Left rail  -->
                <Border
                    Background="{DynamicResource BrushWindowBackground}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,1,0"
                    Grid.Column="0"
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Padding="12">
                    <DockPanel>
                        <StackPanel Spacing="8">
                            <controls:DebtWidget
                                DebtSettled="{Binding DebtSettled}"
                                DebtTotal="{Binding DebtTotal}"
                                Margin="0,0,0,12" />

                            <Button
                                Classes="Ghost compact"
                                Command="{Binding RequestPermissionCommand}"
                                Content="{conv:Tr DashboardRequestPermission}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="44" />

                            <Button
                                Classes="Ghost compact"
                                Command="{Binding OpenShopCommand}"
                                Content="{conv:Tr DashboardShop}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="44" />

                            <Button
                                Classes="Danger compact"
                                Command="{Binding EndSessionCommand}"
                                Content="{conv:Tr DashboardEndSession}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="44" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--  Right: scrollable tasks + punishment  -->
                <ScrollViewer Grid.Column="1" Grid.Row="1">
                    <StackPanel Margin="16,16,16,0" Spacing="20">

                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                            <TextBlock
                                Classes="SectionTitle"
                                Grid.Column="0"
                                Text="{conv:Tr DashboardTasksHeading}"
                                VerticalAlignment="Center" />
                            <Border
                                Background="{DynamicResource BrushSurfaceBase}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Padding="8,2"
                                VerticalAlignment="Center">
                                <TextBlock Classes="Caption" Text="{Binding Tasks.Count}" />
                            </Border>
                            <Button
                                Classes="Add compact"
                                Command="{Binding OpenAddTaskFormCommand}"
                                Content="{conv:Tr DashboardAddOccasionalTask}"
                                Grid.Column="2"
                                VerticalAlignment="Center" />
                        </Grid>

                        <Border Background="{DynamicResource BrushBorderSubtle}" Height="1" />

                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="56">
                                            <Ellipse
                                                Fill="{Binding StatusBrushKey, Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}"
                                                Grid.Column="0"
                                                Height="8"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Width="8" />
                                            <TextBlock
                                                Classes="Body"
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Classes="SmallGhost"
                                                Command="{Binding ToggleExpandedCommand}"
                                                Grid.Column="2"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center">
                                                <ic:SymbolIcon
                                                    FontSize="14"
                                                    IconVariant="Regular"
                                                    Symbol="ChevronDown" />
                                            </Button>
                                            <Button
                                                Classes="Primary compact"
                                                Command="{Binding StartCommand}"
                                                Content="{conv:Tr Start}"
                                                Grid.Column="3"
                                                MinHeight="44"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel
                                            IsVisible="{Binding IsExpanded}"
                                            Margin="18,0,0,10"
                                            Spacing="2">
                                            <TextBlock
                                                Classes="Caption"
                                                Foreground="{Binding StatusBrushKey, Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}"
                                                Text="{Binding LastCompletedLabel}" />
                                            <TextBlock Classes="Caption" Text="{Binding FrequencyLabel}" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource BrushBorderSubtle}" Height="0.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button
                            Classes="Primary"
                            Command="{Binding CompleteGameCommand}"
                            Content="{conv:Tr DashboardCompleteGame}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding CanComplete}"
                            Margin="0,8,0,16" />

                    </StackPanel>
                </ScrollViewer>

                <!--  Punishment bar (pinned bottom, right column only)  -->
                <Border
                    Background="{DynamicResource BrushSurfaceBase}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Grid.Column="1"
                    Grid.Row="2"
                    Padding="16,12">
                    <Button
                        Classes="Amber"
                        Command="{Binding OpenPunishmentsCommand}"
                        CornerRadius="6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding HasPendingPunishments}"
                        Padding="16,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="Body"
                                Grid.Column="0"
                                Text="{conv:Tr PendingPunishments}"
                                VerticalAlignment="Center" />
                            <Border
                                Background="{DynamicResource BrushAmberText}"
                                CornerRadius="12"
                                Grid.Column="1"
                                Height="24"
                                IsVisible="{Binding HasPendingPunishments}"
                                MinWidth="24"
                                Padding="6,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Classes="Caption"
                                    Foreground="{DynamicResource BrushWindowBackground}"
                                    HorizontalAlignment="Center"
                                    Text="{Binding PendingPunishmentsCount}"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </Border>

            </Grid>

        </Grid>

        <!--
            ══════════════════════════════════════════════════════
            BUSY MODE overlay
            ══════════════════════════════════════════════════════
        -->
        <Grid
            Background="{DynamicResource BrushWindowBackground}"
            IsVisible="{Binding IsBusy}"
            RowDefinitions="Auto,Auto,*,Auto">

            <TextBlock
                Classes="PageTitle"
                Grid.Row="0"
                HorizontalAlignment="Center"
                Margin="0,24"
                Text="{Binding BusyChoreName}" />

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                Spacing="4">
                <TextBlock
                    Classes="Body"
                    HorizontalAlignment="Center"
                    Text="{Binding BusyChoreDescription}" />
                <TextBlock
                    Classes="Caption"
                    HorizontalAlignment="Center"
                    Text="{Binding BusyChoreValueDisplay}" />
            </StackPanel>

            <TextBlock
                Classes="NumberDisplay"
                Grid.Row="2"
                HorizontalAlignment="Center"
                Text="{Binding BusyElapsed}"
                VerticalAlignment="Center" />

            <Button
                Classes="Primary"
                Command="{Binding EndChoreCommand}"
                Content="{conv:Tr DashboardEndChore}"
                Grid.Row="3"
                HorizontalAlignment="Center"
                Margin="0,0,0,24" />
        </Grid>

        <!--  ##    POPUP OVERLAY    ##  -->
        <controls:DashboardIdlePopupOverlay />

        <!--  ##    CHORE RESULT OVERLAY    ##  -->
        <controls:DashboardChoreResultOverlay />

        <!--  ##    PENDING PUNISHMENTS OVERLAY    ##  -->
        <controls:DashboardPunishmentsPanel />

        <!--  ##    PERMISSIONS FLOW (request, outcome, active break)    ##  -->
        <controls:DashboardPermissionsPanel />

        <!--  ##    ADD OCCASIONAL TASK OVERLAY    ##  -->
        <controls:DashboardAddTaskForm />

        <!--
            ══════════════════════════════════════════════════════
            OUTFIT DRAWER (topmost overlay)
            ══════════════════════════════════════════════════════
        -->
        <controls:OutfitDrawer
            IsOpen="{Binding IsOutfitDrawerOpen}"
            MultiplierDisplay="{Binding OutfitMultiplierDisplay}"
            Outfit="{Binding CurrentOutfitVm}"
            x:Name="OutfitDrawerControl" />

        <!--  Confirmation dialog overlay  -->
        <ContentControl Content="{Binding ActiveDialog}" IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:ConfirmDialogViewModel">
                    <v:ConfirmDialog />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Panel>

</UserControl>