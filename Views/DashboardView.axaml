<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:DashboardViewModel"
             x:Class="ChastiMaid.Views.DashboardView">

    <Grid>
        <!-- ==================== IDLE MODE ==================== -->
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsIdle}">

            <Border Grid.Row="0" Padding="24,16">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding DebtDisplay}"
                               Classes="heading"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding InitialDebtDisplay}"
                               HorizontalAlignment="Center" Classes="small muted" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="65*,Auto,35*" Margin="24,0">

                <!-- Left: Chore list -->
                <ScrollViewer Grid.Column="0">
                    <ItemsControl ItemsSource="{Binding Chores}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChoreItemViewModel">
                                <Border Padding="16,12" Margin="0,4">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ValueDisplay}"
                                                   Classes="muted" VerticalAlignment="Center" Margin="16,0" />
                                        <Button Grid.Column="2" Content="Start"
                                                Command="{Binding StartChoreCommand}"
                                                Classes="compact" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Separator -->
                <Border Grid.Column="1" Width="1" Background="#33FFFFFF" Margin="16,0" />

                <!-- Right: Current outfit -->
                <ScrollViewer Grid.Column="2">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Current Outfit" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding CurrentOutfit}" Classes="small" Opacity="0.85" />
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <Border Grid.Row="2" Padding="24,16">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="{Binding PayRate}" HorizontalAlignment="Center" Classes="muted" />
                    <TextBlock Text="{Binding TimeToNextWage}" HorizontalAlignment="Center" Classes="muted" />
                    <StackPanel Classes="buttonBar" Margin="0,8,0,0">
                        <Button Content="Complete Game"
                                Command="{Binding CompleteGameCommand}"
                                IsVisible="{Binding CanComplete}" />
                        <Button Content="End Session"
                                Command="{Binding EndSessionCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== BUSY MODE ==================== -->
        <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsBusy}">
            <TextBlock Grid.Row="0" Text="{Binding BusyChoreName}"
                       Classes="heading" HorizontalAlignment="Center" Margin="0,24" />

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding BusyChoreDescription}" HorizontalAlignment="Center" Classes="muted" />
                <TextBlock Text="{Binding BusyChoreValueDisplay}" HorizontalAlignment="Center" Classes="muted" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{Binding BusyElapsed}"
                       Classes="display" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Button Grid.Row="3" Content="End Chore"
                    Command="{Binding EndChoreCommand}"
                    HorizontalAlignment="Center" Classes="primary" Margin="0,0,0,24" />
        </Grid>

        <!-- ==================== TRIVIA POPUP OVERLAY ==================== -->
        <Panel IsVisible="{Binding IsPopupVisible}" Classes="dialogOverlay">
            <Border Classes="dialogBox" MaxWidth="500">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding PopupCountdown, StringFormat='Time: {0}s'}"
                               HorizontalAlignment="Center" Foreground="OrangeRed" />
                    <TextBlock Text="{Binding PopupQuestion}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding PopupAnswers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,4"
                                        Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).AnswerCommand}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>

</UserControl>
