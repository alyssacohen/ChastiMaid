<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:DashboardViewModel"
             x:Class="ChastiMaid.Views.DashboardView">

    <Grid>
        <!-- ==================== IDLE MODE ==================== -->
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsIdle}">

            <Border Grid.Row="0" Padding="24,16">
                <TextBlock Text="{Binding DebtDisplay}"
                           Classes="h1"
                           HorizontalAlignment="Center" />
            </Border>

            <ScrollViewer Grid.Row="1" Padding="24,0">
                <ItemsControl ItemsSource="{Binding Chores}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChoreItemViewModel">
                            <Border Padding="16,12" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='{}{0:F0} cr'}"
                                               Opacity="0.7" VerticalAlignment="Center" Margin="16,0" />
                                    <Button Grid.Column="2" Content="Start"
                                            Command="{Binding StartChoreCommand}"
                                            Padding="24,8" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="24,16">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="{Binding PayRate}" HorizontalAlignment="Center" Opacity="0.7" />
                    <TextBlock Text="{Binding TimeToNextWage}" HorizontalAlignment="Center" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                        <Button Content="Complete Game"
                                Command="{Binding CompleteGameCommand}"
                                IsVisible="{Binding CanComplete}"
                                Padding="48,14" />
                        <Button Content="End Session"
                                Command="{Binding EndSessionCommand}"
                                Padding="48,14" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== BUSY MODE ==================== -->
        <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsBusy}">
            <TextBlock Grid.Row="0" Text="{Binding BusyChoreName}"
                       Classes="h1" HorizontalAlignment="Center" Margin="0,24" />

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding BusyChoreDescription}" HorizontalAlignment="Center" Opacity="0.7" />
                <TextBlock Text="{Binding BusyChoreValue, StringFormat='{}{0:F0} credits'}"
                           HorizontalAlignment="Center" Opacity="0.7" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{Binding BusyElapsed}"
                       FontSize="72" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Button Grid.Row="3" Content="End Chore"
                    Command="{Binding EndChoreCommand}"
                    HorizontalAlignment="Center" Padding="48,14" Margin="0,0,0,24" />
        </Grid>

        <!-- ==================== TRIVIA POPUP OVERLAY ==================== -->
        <Border IsVisible="{Binding IsPopupVisible}"
                Background="#CC000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    CornerRadius="12" Padding="32" MaxWidth="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding PopupCountdown, StringFormat='Time: {0}s'}"
                               FontSize="24" HorizontalAlignment="Center" Foreground="OrangeRed" />
                    <TextBlock Text="{Binding PopupQuestion}"
                               FontSize="20" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding PopupAnswers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="16,10" Margin="0,4"
                                        Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).AnswerCommand}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Border>
    </Grid>

</UserControl>
