<UserControl
    Background="{DynamicResource BrushWindowBackground}"
    x:Class="ChastiMaid.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="using:ChastiMaid.Views.Controls"
    xmlns:conv="using:ChastiMaid.Views.Converters"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:v="using:ChastiMaid.Views.Dialogs"
    xmlns:vm="using:ChastiMaid.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Panel>

        <!--
            ══════════════════════════════════════════════════════
            IDLE MODE — full dashboard layout
            ══════════════════════════════════════════════════════
        -->
        <Grid IsVisible="{Binding IsIdle}">

            <!--  ── PORTRAIT layout ──  -->
            <Grid IsVisible="{Binding !IsLandscape}" RowDefinitions="Auto,*,Auto">

                <!--  Status bar  -->
                <Border
                    Background="{DynamicResource BrushSurfaceBase}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Grid.Row="0"
                    Height="50"
                    Padding="16,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Ellipse
                                Fill="{DynamicResource BrushStatusIdle}"
                                Height="10"
                                Width="10" />
                            <TextBlock
                                Classes="BodySmall"
                                Text="{conv:Tr DashboardStatusIdle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Classes="SmallGhost"
                            Command="{Binding ToggleOutfitDrawerCommand}"
                            Content="{conv:Tr DashboardOutfitToggle}"
                            Grid.Column="2"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!--  Scrollable content  -->
                <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="16,16,16,0" Spacing="20">

                        <controls:DebtWidget DebtSettled="{Binding DebtSettled}" DebtTotal="{Binding DebtTotal}" />

                        <!--  Chore rejected feedback  -->
                        <Border
                            Background="{DynamicResource BrushAmberBackground}"
                            BorderBrush="{DynamicResource BrushAmber}"
                            BorderThickness="1"
                            CornerRadius="6"
                            IsVisible="{Binding ChoreResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Padding="12,8">
                            <TextBlock
                                Classes="BodySmall"
                                Foreground="{DynamicResource BrushAmberText}"
                                Text="{Binding ChoreResultMessage}"
                                TextWrapping="Wrap" />
                        </Border>

                        <!--  Tasks section  -->
                        <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock
                                    Classes="SectionTitle"
                                    Grid.Column="0"
                                    Text="{conv:Tr DashboardTasksHeading}"
                                    VerticalAlignment="Center" />
                                <Border
                                    Background="{DynamicResource BrushSurfaceBase}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Grid.Column="1"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                    <TextBlock Classes="Caption" Text="{Binding Tasks.Count}" />
                                </Border>
                            </Grid>

                            <Border Background="{DynamicResource BrushBorderSubtle}" Height="1" />

                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskItemViewModel">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="56">
                                                <Ellipse
                                                    Fill="{Binding StatusBrushKey, Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}"
                                                    Grid.Column="0"
                                                    Height="8"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Width="8" />
                                                <TextBlock
                                                    Classes="Body"
                                                    Grid.Column="1"
                                                    Text="{Binding Name}"
                                                    VerticalAlignment="Center" />
                                                <Button
                                                    Classes="SmallGhost"
                                                    Command="{Binding ToggleExpandedCommand}"
                                                    Grid.Column="2"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center">
                                                    <ic:SymbolIcon
                                                        FontSize="14"
                                                        IconVariant="Regular"
                                                        Symbol="ChevronDown" />
                                                </Button>
                                                <Button
                                                    Classes="Primary compact"
                                                    Command="{Binding StartCommand}"
                                                    Content="{conv:Tr Start}"
                                                    Grid.Column="3"
                                                    MinHeight="44"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel
                                                IsVisible="{Binding IsExpanded}"
                                                Margin="18,0,0,10"
                                                Spacing="2">
                                                <TextBlock
                                                    Classes="Caption"
                                                    Foreground="{Binding StatusBrushKey, Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}"
                                                    Text="{Binding LastCompletedLabel}" />
                                                <TextBlock Classes="Caption" Text="{Binding FrequencyLabel}" />
                                            </StackPanel>
                                            <Border Background="{DynamicResource BrushBorderSubtle}" Height="0.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Classes="Caption"
                                HorizontalAlignment="Center"
                                Margin="0,16"
                                Text="{conv:Tr DashboardNoPendingTasks}">
                                <TextBlock.IsVisible>
                                    <Binding
                                        Converter="{x:Static ObjectConverters.IsNull}"
                                        FallbackValue="False"
                                        Path="Tasks.Count" />
                                </TextBlock.IsVisible>
                            </TextBlock>

                        </StackPanel>

                        <!--  Punishment button  -->
                        <Button
                            Classes="Amber"
                            Command="{Binding OpenPunishmentsCommand}"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsEnabled="{Binding HasPendingPunishments}"
                            Padding="16,14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Classes="Body"
                                    Grid.Column="0"
                                    Text="{conv:Tr PendingPunishments}"
                                    VerticalAlignment="Center" />
                                <Border
                                    Background="{DynamicResource BrushAmberText}"
                                    CornerRadius="12"
                                    Grid.Column="1"
                                    Height="24"
                                    IsVisible="{Binding HasPendingPunishments}"
                                    MinWidth="24"
                                    Padding="6,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Classes="Caption"
                                        Foreground="{DynamicResource BrushWindowBackground}"
                                        HorizontalAlignment="Center"
                                        Text="{Binding PendingPunishmentsCount}"
                                        VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Border Height="16" />

                    </StackPanel>
                </ScrollViewer>

                <!--  Action bar (pinned bottom)  -->
                <Border
                    Background="{DynamicResource BrushSurfaceBase}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Grid.Row="2"
                    Padding="8,8">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">

                        <Button
                            Classes="Ghost compact"
                            Command="{Binding RequestPermissionCommand}"
                            Content="{conv:Tr DashboardRequestPermission}"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />

                        <Button
                            Classes="Ghost compact"
                            Command="{Binding OpenShopCommand}"
                            Content="{conv:Tr DashboardShop}"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />

                        <Button
                            Classes="Ghost compact"
                            Command="{Binding EndSessionCommand}"
                            Content="{conv:Tr DashboardEndSession}"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />

                        <Button
                            Classes="Danger compact"
                            Command="{Binding EmergencyBreakCommand}"
                            Content="{conv:Tr DashboardEmergencyBreak}"
                            Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />

                    </Grid>
                </Border>

            </Grid>

            <!--  ── LANDSCAPE layout ──  -->
            <Grid
                IsVisible="{Binding IsLandscape}"
                RowDefinitions="Auto,*,Auto">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource NavPanelWidthGridLength}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Status bar (spans both columns)  -->
                <Border
                    Background="{DynamicResource BrushSurfaceBase}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Grid.ColumnSpan="2"
                    Grid.Row="0"
                    Height="50"
                    Padding="16,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Ellipse
                                Fill="{DynamicResource BrushStatusIdle}"
                                Height="10"
                                Width="10" />
                            <TextBlock
                                Classes="BodySmall"
                                Text="{conv:Tr DashboardStatusIdle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Classes="SmallGhost"
                            Command="{Binding ToggleOutfitDrawerCommand}"
                            Content="{conv:Tr DashboardOutfitToggle}"
                            Grid.Column="2"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!--  Left rail  -->
                <Border
                    Background="{DynamicResource BrushSurfaceBase}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,1,0"
                    Grid.Column="0"
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Padding="12">
                    <DockPanel>
                        <StackPanel Spacing="8">
                            <controls:DebtWidget
                                DebtSettled="{Binding DebtSettled}"
                                DebtTotal="{Binding DebtTotal}"
                                Margin="0,0,0,12" />

                            <Button
                                Classes="Ghost compact"
                                Command="{Binding RequestPermissionCommand}"
                                Content="{conv:Tr DashboardRequestPermission}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="44" />

                            <Button
                                Classes="Ghost compact"
                                Command="{Binding OpenShopCommand}"
                                Content="{conv:Tr DashboardShop}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="44" />

                            <Button
                                Classes="Ghost compact"
                                Command="{Binding EndSessionCommand}"
                                Content="{conv:Tr DashboardEndSession}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="44" />

                            <Button
                                Classes="Danger compact"
                                Command="{Binding EmergencyBreakCommand}"
                                Content="{conv:Tr DashboardEmergencyBreak}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="44" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--  Right: scrollable tasks + punishment  -->
                <ScrollViewer Grid.Column="1" Grid.Row="1">
                    <StackPanel Margin="16,16,16,0" Spacing="20">

                        <!--  Chore rejected feedback  -->
                        <Border
                            Background="{DynamicResource BrushAmberBackground}"
                            BorderBrush="{DynamicResource BrushAmber}"
                            BorderThickness="1"
                            CornerRadius="6"
                            IsVisible="{Binding ChoreResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Padding="12,8">
                            <TextBlock
                                Classes="BodySmall"
                                Foreground="{DynamicResource BrushAmberText}"
                                Text="{Binding ChoreResultMessage}"
                                TextWrapping="Wrap" />
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock
                                Classes="SectionTitle"
                                Grid.Column="0"
                                Text="{conv:Tr DashboardTasksHeading}"
                                VerticalAlignment="Center" />
                            <Border
                                Background="{DynamicResource BrushSurfaceBase}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Grid.Column="1"
                                Padding="8,2"
                                VerticalAlignment="Center">
                                <TextBlock Classes="Caption" Text="{Binding Tasks.Count}" />
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource BrushBorderSubtle}" Height="1" />

                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="56">
                                            <Ellipse
                                                Fill="{Binding StatusBrushKey, Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}"
                                                Grid.Column="0"
                                                Height="8"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Width="8" />
                                            <TextBlock
                                                Classes="Body"
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Classes="SmallGhost"
                                                Command="{Binding ToggleExpandedCommand}"
                                                Grid.Column="2"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center">
                                                <ic:SymbolIcon
                                                    FontSize="14"
                                                    IconVariant="Regular"
                                                    Symbol="ChevronDown" />
                                            </Button>
                                            <Button
                                                Classes="Primary compact"
                                                Command="{Binding StartCommand}"
                                                Content="{conv:Tr Start}"
                                                Grid.Column="3"
                                                MinHeight="44"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel
                                            IsVisible="{Binding IsExpanded}"
                                            Margin="18,0,0,10"
                                            Spacing="2">
                                            <TextBlock
                                                Classes="Caption"
                                                Foreground="{Binding StatusBrushKey, Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}"
                                                Text="{Binding LastCompletedLabel}" />
                                            <TextBlock Classes="Caption" Text="{Binding FrequencyLabel}" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource BrushBorderSubtle}" Height="0.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button
                            Classes="Primary"
                            Command="{Binding CompleteGameCommand}"
                            Content="{conv:Tr DashboardCompleteGame}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding CanComplete}"
                            Margin="0,8,0,16" />

                    </StackPanel>
                </ScrollViewer>

                <!--  Punishment bar (pinned bottom, right column only)  -->
                <Border
                    Background="{DynamicResource BrushSurfaceBase}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Grid.Column="1"
                    Grid.Row="2"
                    Padding="16,12">
                    <Button
                        Classes="Amber"
                        Command="{Binding OpenPunishmentsCommand}"
                        CornerRadius="6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding HasPendingPunishments}"
                        Padding="16,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="Body"
                                Grid.Column="0"
                                Text="{conv:Tr PendingPunishments}"
                                VerticalAlignment="Center" />
                            <Border
                                Background="{DynamicResource BrushAmberText}"
                                CornerRadius="12"
                                Grid.Column="1"
                                Height="24"
                                IsVisible="{Binding HasPendingPunishments}"
                                MinWidth="24"
                                Padding="6,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Classes="Caption"
                                    Foreground="{DynamicResource BrushWindowBackground}"
                                    HorizontalAlignment="Center"
                                    Text="{Binding PendingPunishmentsCount}"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </Border>

            </Grid>

        </Grid>

        <!--
            ══════════════════════════════════════════════════════
            BUSY MODE overlay
            ══════════════════════════════════════════════════════
        -->
        <Grid
            Background="{DynamicResource BrushWindowBackground}"
            IsVisible="{Binding IsBusy}"
            RowDefinitions="Auto,Auto,*,Auto">

            <TextBlock
                Classes="PageTitle"
                Grid.Row="0"
                HorizontalAlignment="Center"
                Margin="0,24"
                Text="{Binding BusyChoreName}" />

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                Spacing="4">
                <TextBlock
                    Classes="Body"
                    HorizontalAlignment="Center"
                    Text="{Binding BusyChoreDescription}" />
                <TextBlock
                    Classes="Caption"
                    HorizontalAlignment="Center"
                    Text="{Binding BusyChoreValueDisplay}" />
            </StackPanel>

            <TextBlock
                Classes="NumberLarge"
                Grid.Row="2"
                HorizontalAlignment="Center"
                Text="{Binding BusyElapsed}"
                VerticalAlignment="Center" />

            <Button
                Classes="Primary"
                Command="{Binding EndChoreCommand}"
                Content="{conv:Tr DashboardEndChore}"
                Grid.Row="3"
                HorizontalAlignment="Center"
                Margin="0,0,0,24" />
        </Grid>

        <!--  ##    POPUP OVERLAY    ##  -->
        <Panel
            Classes="dialogOverlay"
            IsVisible="{Binding IsPopupVisible}"
            PointerPressed="OnPopupOverlayPointerPressed">
            <Border
                Classes="dialogBox"
                MaxHeight="{Binding PopupDialogMaxHeight}"
                MaxWidth="500"
                PointerPressed="OnPopupDialogBoxPointerPressed">
                <Panel>
                    <StackPanel IsVisible="{Binding IsShowingQuestionPanel}" Spacing="16">
                        <controls:WebcamPreviewControl
                            Height="{Binding PopupPreviewHeight}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding IsWebcamPreviewNeededInQuestionPanel}"
                            Service="{Binding Webcam}"
                            Stretch="UniformToFill"
                            Width="{Binding PopupPreviewWidth}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding Webcam.HasMultipleCameras}"
                            ItemsSource="{Binding Webcam.AvailableCameras}"
                            SelectedItem="{Binding Webcam.SelectedCamera}" />
                        <TextBlock
                            Classes="Body"
                            HorizontalAlignment="Center"
                            Text="{Binding PopupQuestion}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding PopupAnswers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button
                                        Classes="Ghost"
                                        Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).AnswerCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsPoseCountdownActive}" Spacing="16">
                        <controls:WebcamPreviewControl
                            Height="{Binding PopupPreviewHeight}"
                            HorizontalAlignment="Center"
                            Service="{Binding Webcam}"
                            Stretch="UniformToFill"
                            Width="{Binding PopupPreviewWidth}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding Webcam.HasMultipleCameras}"
                            ItemsSource="{Binding Webcam.AvailableCameras}"
                            SelectedItem="{Binding Webcam.SelectedCamera}" />
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{conv:Tr PoseForCameraCountdownLabel}"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="NumberLarge"
                            HorizontalAlignment="Center"
                            Text="{Binding PoseCountdown}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsCurtsyCountdownActive}" Spacing="16">
                        <controls:WebcamPreviewControl
                            Height="{Binding PopupPreviewHeight}"
                            HorizontalAlignment="Center"
                            Service="{Binding Webcam}"
                            Stretch="UniformToFill"
                            Width="{Binding PopupPreviewWidth}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding Webcam.HasMultipleCameras}"
                            ItemsSource="{Binding Webcam.AvailableCameras}"
                            SelectedItem="{Binding Webcam.SelectedCamera}" />
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{conv:Tr CurtsyCountdownLabel}"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="NumberLarge"
                            HorizontalAlignment="Center"
                            Text="{Binding CurtsyCountdown}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsCurtsyRecordingActive}" Spacing="16">
                        <controls:WebcamPreviewControl
                            Height="{Binding PopupPreviewHeight}"
                            HorizontalAlignment="Center"
                            Service="{Binding Webcam}"
                            Stretch="UniformToFill"
                            Width="{Binding PopupPreviewWidth}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            IsVisible="{Binding Webcam.HasMultipleCameras}"
                            ItemsSource="{Binding Webcam.AvailableCameras}"
                            SelectedItem="{Binding Webcam.SelectedCamera}" />
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{conv:Tr CurtsyRecordingLabel}"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="NumberLarge"
                            HorizontalAlignment="Center"
                            Text="{Binding CurtsyRecordingSecondsLeft}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsQuoteListeningActive}" Spacing="16">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{conv:Tr MotivationalQuoteListeningLabel}"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="Body"
                            HorizontalAlignment="Center"
                            Text="{Binding PopupQuestion}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="NumberLarge"
                            HorizontalAlignment="Center"
                            Text="{Binding QuoteListenCountdown}" />
                        <TextBlock
                            Classes="Caption"
                            HorizontalAlignment="Center"
                            Text="{Binding QuoteAttemptsRemaining, StringFormat={conv:Tr MotivationalQuoteAttemptsRemainingFormat}}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsQuoteTypingActive}" Spacing="16">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{conv:Tr MotivationalQuoteTypingLabel}"
                            TextAlignment="Center" />
                        <TextBlock
                            Classes="Body"
                            HorizontalAlignment="Center"
                            Text="{Binding PopupQuestion}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBox
                            Classes="underline"
                            PlaceholderText="{conv:Tr MotivationalQuoteTypeWatermark}"
                            Text="{Binding QuoteTypedAnswer}" />
                        <TextBlock
                            Classes="Caption"
                            HorizontalAlignment="Center"
                            Text="{Binding QuoteAttemptsRemaining, StringFormat={conv:Tr MotivationalQuoteAttemptsRemainingFormat}}" />
                        <Button
                            Classes="Ghost"
                            Command="{Binding SubmitQuoteTypedAnswerCommand}"
                            Content="{conv:Tr MotivationalQuoteSubmit}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsKneelFramingActive}" Spacing="16">
                        <controls:WebcamPreviewControl
                            Height="{Binding PopupPreviewHeight}"
                            HorizontalAlignment="Center"
                            Service="{Binding Webcam}"
                            Stretch="UniformToFill"
                            Width="{Binding PopupPreviewWidth}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding Webcam.HasMultipleCameras}"
                            ItemsSource="{Binding Webcam.AvailableCameras}"
                            SelectedItem="{Binding Webcam.SelectedCamera}" />
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{conv:Tr KneelFramingLabel}"
                            TextAlignment="Center" />
                        <Button
                            Classes="Ghost"
                            Command="{Binding ConfirmKneelFramingCommand}"
                            Content="{conv:Tr KneelFramingConfirm}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsKneelActive}" Spacing="16">
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{Binding PopupQuestion}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Classes="NumberLarge"
                            HorizontalAlignment="Center"
                            Text="{Binding KneelCountdown}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsShowingPopupOutcome}" Spacing="16">
                        <Image
                            Height="{Binding PopupPreviewHeight}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding CapturedPosePhoto, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Source="{Binding CapturedPosePhoto}"
                            Stretch="UniformToFill"
                            Width="{Binding PopupPreviewWidth}" />
                        <TextBlock
                            Classes="EmployerVoice"
                            HorizontalAlignment="Center"
                            Text="{Binding PopupOutcomeMessage}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Panel>
            </Border>
        </Panel>

        <!--  ##    PENDING PUNISHMENTS OVERLAY    ##  -->
        <Panel Classes="dialogOverlay" IsVisible="{Binding IsPunishmentsPanelVisible}">
            <Border
                Classes="dialogBox"
                MaxWidth="460"
                Padding="0">
                <DockPanel>

                    <!--  Header (amber)  -->
                    <Border
                        Background="{DynamicResource BrushAmberBackground}"
                        CornerRadius="8,8,0,0"
                        DockPanel.Dock="Top"
                        Height="52"
                        Padding="20,0,12,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="SectionTitle"
                                Foreground="{DynamicResource BrushAmberText}"
                                Grid.Column="0"
                                Text="{conv:Tr PendingPunishments}"
                                VerticalAlignment="Center" />
                            <Button
                                Classes="Ghost"
                                Command="{Binding ClosePunishmentsPanelCommand}"
                                Grid.Column="1"
                                Height="44"
                                Padding="0"
                                VerticalAlignment="Center"
                                Width="44"
                                ToolTip.Tip="{conv:Tr Close}"
                                AutomationProperties.Name="{conv:Tr Close}">
                                <ic:SymbolIcon
                                    FontSize="14"
                                    Foreground="{DynamicResource BrushAmberText}"
                                    HorizontalAlignment="Center"
                                    IconVariant="Regular"
                                    Symbol="Dismiss"
                                    VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <!--  Footer  -->
                    <Border
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        DockPanel.Dock="Bottom"
                        Padding="20,12">
                        <Button
                            Classes="Ghost"
                            Command="{Binding ClosePunishmentsPanelCommand}"
                            Content="{conv:Tr Close}"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            MinWidth="100" />
                    </Border>

                    <!--  Punishment rows  -->
                    <ScrollViewer MaxHeight="400">
                        <ItemsControl ItemsSource="{Binding Punishments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PunishmentItemViewModel">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" Margin="20,0" MinHeight="56">
                                            <StackPanel
                                                Grid.Column="0"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Classes="Body" Text="{Binding Name}" />
                                                    <TextBlock
                                                        Classes="Caption"
                                                        Foreground="{DynamicResource TextAccent}"
                                                        IsVisible="{Binding DetailLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                        Text="{Binding DetailLabel}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Classes="Caption" Text="{Binding AssignedLabel}" />
                                                <TextBlock
                                                    Classes="Caption"
                                                    FontStyle="Italic"
                                                    Foreground="{DynamicResource TextMuted}"
                                                    IsVisible="{Binding ReasonLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    Text="{Binding ReasonLabel}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button
                                                Classes="Primary compact"
                                                Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).StartPunishmentCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{conv:Tr Start}"
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                MinHeight="44"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                        <Border
                                            Background="{DynamicResource BrushBorderSubtle}"
                                            Height="0.5"
                                            Margin="20,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </DockPanel>
            </Border>
        </Panel>

        <!--
            ══════════════════════════════════════════════════════
            OUTFIT DRAWER (topmost overlay)
            ══════════════════════════════════════════════════════
        -->
        <controls:OutfitDrawer
            IsOpen="{Binding IsOutfitDrawerOpen}"
            MultiplierDisplay="{Binding OutfitMultiplierDisplay}"
            Outfit="{Binding CurrentOutfitVm}"
            x:Name="OutfitDrawerControl" />

        <!--  Confirmation dialog overlay  -->
        <ContentControl Content="{Binding ActiveDialog}" IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:ConfirmDialogViewModel">
                    <v:ConfirmDialog />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Panel>

</UserControl>