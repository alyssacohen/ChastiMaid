<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:controls="using:ChastiMaid.Views.Controls"
             xmlns:conv="using:ChastiMaid.Views.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:DataType="vm:DashboardViewModel"
             x:Class="ChastiMaid.Views.DashboardView"
             Background="{DynamicResource BrushWindowBackground}">

    <Panel>

        <!-- ══════════════════════════════════════════════════════
             IDLE MODE — full dashboard layout
             ══════════════════════════════════════════════════════ -->
        <Grid IsVisible="{Binding IsIdle}">

            <!-- ── PORTRAIT layout ── -->
            <Grid RowDefinitions="Auto,*,Auto"
                  IsVisible="{Binding !IsLandscape}">

                <!-- Status bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BrushSurfaceBase}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Height="50"
                        Padding="16,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10"
                                     Fill="{DynamicResource BrushStatusIdle}" />
                            <TextBlock Classes="BodySmall"
                                       Text="{conv:Tr DashboardStatusIdle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="{conv:Tr DashboardOutfitToggle}"
                                Command="{Binding ToggleOutfitDrawerCommand}"
                                Classes="SmallGhost"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Scrollable content -->
                <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="16,16,16,0" Spacing="20">

                        <controls:DebtWidget DebtTotal="{Binding DebtTotal}"
                                             DebtSettled="{Binding DebtSettled}" />

                        <!-- Chore rejected feedback -->
                        <Border Background="{DynamicResource BrushAmberBackground}"
                                BorderBrush="{DynamicResource BrushAmber}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                IsVisible="{Binding ChoreResultMessage,
                                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="BodySmall"
                                       Text="{Binding ChoreResultMessage}"
                                       Foreground="{DynamicResource BrushAmberText}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Tasks section -->
                        <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Grid.Column="0"
                                           Classes="Subheading"
                                           Text="{conv:Tr DashboardTasksHeading}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{DynamicResource BrushSurfaceBase}"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Classes="Caption"
                                               Text="{Binding Tasks.Count}" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" />

                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskItemViewModel">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="56">
                                                <Ellipse Grid.Column="0"
                                                         Width="8" Height="8"
                                                         Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding StatusBrushKey,
                                                                Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}" />
                                                <TextBlock Grid.Column="1"
                                                           Classes="Body"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Command="{Binding ToggleExpandedCommand}"
                                                        Classes="SmallGhost"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,4,0">
                                                    <ic:SymbolIcon Symbol="ChevronDown"
                                                                   IconVariant="Regular"
                                                                   FontSize="14" />
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Content="{conv:Tr Start}"
                                                        Command="{Binding StartCommand}"
                                                        Classes="Primary compact"
                                                        MinHeight="44"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel IsVisible="{Binding IsExpanded}"
                                                        Margin="18,0,0,10"
                                                        Spacing="2">
                                                <TextBlock Classes="Caption"
                                                           Text="{Binding LastCompletedLabel}"
                                                           Foreground="{Binding StatusBrushKey,
                                                                        Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}" />
                                                <TextBlock Classes="Caption"
                                                           Text="{Binding FrequencyLabel}" />
                                            </StackPanel>
                                            <Border Height="0.5"
                                                    Background="{DynamicResource BrushBorderSubtle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="Caption"
                                       Text="{conv:Tr DashboardNoPendingTasks}"
                                       HorizontalAlignment="Center"
                                       Margin="0,16">
                                <TextBlock.IsVisible>
                                    <Binding Path="Tasks.Count"
                                             Converter="{x:Static ObjectConverters.IsNull}"
                                             FallbackValue="False" />
                                </TextBlock.IsVisible>
                            </TextBlock>

                        </StackPanel>

                        <!-- Punishment button -->
                        <Button Command="{Binding OpenPunishmentsCommand}"
                                IsEnabled="{Binding HasPendingPunishments}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="6"
                                Classes="Amber">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Classes="Body"
                                           Text="{conv:Tr PendingPunishments}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{DynamicResource BrushAmberText}"
                                        CornerRadius="12"
                                        MinWidth="24"
                                        Height="24"
                                        Padding="6,0"
                                        IsVisible="{Binding HasPendingPunishments}"
                                        VerticalAlignment="Center">
                                    <TextBlock Classes="Caption"
                                               Text="{Binding PendingPunishmentsCount}"
                                               Foreground="{DynamicResource BrushWindowBackground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Border Height="16" />

                    </StackPanel>
                </ScrollViewer>

                <!-- Action bar (pinned bottom) -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BrushSurfaceBase}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="8,8">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">

                        <Button Grid.Column="0"
                                Content="{conv:Tr DashboardRequestPermission}"
                                Command="{Binding RequestPermissionCommand}"
                                Classes="Ghost compact"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="{conv:Tr DashboardShop}"
                                Command="{Binding OpenShopCommand}"
                                Classes="Ghost compact"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                        <Button Grid.Column="2"
                                Content="{conv:Tr DashboardEndSession}"
                                Command="{Binding EndSessionCommand}"
                                Classes="Ghost compact"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                        <Button Grid.Column="3"
                                Content="{conv:Tr DashboardEmergencyBreak}"
                                Command="{Binding EmergencyBreakCommand}"
                                Classes="Emergency compact"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                    </Grid>
                </Border>

            </Grid>

            <!-- ── LANDSCAPE layout ── -->
            <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,*"
                  IsVisible="{Binding IsLandscape}">

                <!-- Status bar (spans both columns) -->
                <Border Grid.Row="0" Grid.ColumnSpan="2"
                        Background="{DynamicResource BrushSurfaceBase}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Height="50"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10"
                                 Fill="{DynamicResource BrushStatusIdle}" />
                        <TextBlock Classes="BodySmall"
                                   Text="{conv:Tr DashboardStatusIdle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Left rail -->
                <Border Grid.Row="1" Grid.Column="0"
                        Background="{DynamicResource BrushSurfaceBase}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,1,0"
                        Padding="12">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom"
                                Content="{conv:Tr DashboardCurrentOutfitToggle}"
                                Command="{Binding ToggleOutfitDrawerCommand}"
                                Classes="Ghost"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0,8,0,0" />

                        <StackPanel Spacing="8">
                            <controls:DebtWidget DebtTotal="{Binding DebtTotal}"
                                                 DebtSettled="{Binding DebtSettled}"
                                                 Margin="0,0,0,12" />

                            <Button Content="{conv:Tr DashboardRequestPermission}"
                                    Command="{Binding RequestPermissionCommand}"
                                    Classes="Ghost compact"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="44" />

                            <Button Content="{conv:Tr DashboardShop}"
                                    Command="{Binding OpenShopCommand}"
                                    Classes="Ghost compact"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="44" />

                            <Button Content="{conv:Tr DashboardEndSession}"
                                    Command="{Binding EndSessionCommand}"
                                    Classes="Ghost compact"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="44" />

                            <Button Content="{conv:Tr DashboardEmergencyBreak}"
                                    Command="{Binding EmergencyBreakCommand}"
                                    Classes="Emergency compact"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="44" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Right: scrollable tasks + punishment -->
                <ScrollViewer Grid.Row="1" Grid.Column="1">
                    <StackPanel Margin="16,16,16,0" Spacing="20">

                        <!-- Chore rejected feedback -->
                        <Border Background="{DynamicResource BrushAmberBackground}"
                                BorderBrush="{DynamicResource BrushAmber}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                IsVisible="{Binding ChoreResultMessage,
                                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="BodySmall"
                                       Text="{Binding ChoreResultMessage}"
                                       Foreground="{DynamicResource BrushAmberText}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0"
                                       Classes="Subheading"
                                       Text="{conv:Tr DashboardTasksHeading}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BrushSurfaceBase}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="Caption"
                                           Text="{Binding Tasks.Count}" />
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" />

                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="56">
                                            <Ellipse Grid.Column="0"
                                                     Width="8" Height="8"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrushKey,
                                                            Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="Body"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    Command="{Binding ToggleExpandedCommand}"
                                                    Classes="SmallGhost"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,4,0">
                                                <ic:SymbolIcon Symbol="ChevronDown"
                                                               IconVariant="Regular"
                                                               FontSize="14" />
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Content="{conv:Tr Start}"
                                                    Command="{Binding StartCommand}"
                                                    Classes="Primary compact"
                                                    MinHeight="44"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel IsVisible="{Binding IsExpanded}"
                                                    Margin="18,0,0,10"
                                                    Spacing="2">
                                            <TextBlock Classes="Caption"
                                                       Text="{Binding LastCompletedLabel}"
                                                       Foreground="{Binding StatusBrushKey,
                                                                    Converter={x:Static conv:ResourceBrushKeyConverter.Instance}}" />
                                            <TextBlock Classes="Caption"
                                                       Text="{Binding FrequencyLabel}" />
                                        </StackPanel>
                                        <Border Height="0.5"
                                                Background="{DynamicResource BrushBorderSubtle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Punishment button -->
                        <Button Command="{Binding OpenPunishmentsCommand}"
                                IsEnabled="{Binding HasPendingPunishments}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="6"
                                Classes="Amber">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Classes="Body"
                                           Text="{conv:Tr PendingPunishments}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{DynamicResource BrushAmberText}"
                                        CornerRadius="12"
                                        MinWidth="24"
                                        Height="24"
                                        Padding="6,0"
                                        IsVisible="{Binding HasPendingPunishments}"
                                        VerticalAlignment="Center">
                                    <TextBlock Classes="Caption"
                                               Text="{Binding PendingPunishmentsCount}"
                                               Foreground="{DynamicResource BrushWindowBackground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Content="{conv:Tr DashboardCompleteGame}"
                                Command="{Binding CompleteGameCommand}"
                                IsVisible="{Binding CanComplete}"
                                Classes="Primary"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,16" />

                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- ══════════════════════════════════════════════════════
             BUSY MODE overlay
             ══════════════════════════════════════════════════════ -->
        <Grid RowDefinitions="Auto,Auto,*,Auto"
              IsVisible="{Binding IsBusy}"
              Background="{DynamicResource BrushWindowBackground}">

            <TextBlock Grid.Row="0"
                       Text="{Binding BusyChoreName}"
                       Classes="PageTitle"
                       HorizontalAlignment="Center"
                       Margin="0,24" />

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Classes="Body"
                           Text="{Binding BusyChoreDescription}"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="Caption"
                           Text="{Binding BusyChoreValueDisplay}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="{Binding BusyElapsed}"
                       Classes="NumberLarge"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <Button Grid.Row="3"
                    Content="{conv:Tr DashboardEndChore}"
                    Command="{Binding EndChoreCommand}"
                    HorizontalAlignment="Center"
                    Classes="Primary"
                    Margin="0,0,0,24" />
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             IMPOSSIBLE QUESTION POPUP overlay
             ══════════════════════════════════════════════════════ -->
        <Panel IsVisible="{Binding IsPopupVisible}" Classes="dialogOverlay"
               PointerPressed="OnPopupOverlayPointerPressed">
            <Border Classes="dialogBox" MaxWidth="500" MaxHeight="{Binding PopupDialogMaxHeight}"
                    PointerPressed="OnPopupDialogBoxPointerPressed">
              <Panel>
                <StackPanel Spacing="16" IsVisible="{Binding IsShowingQuestionPanel}">
                    <TextBlock Classes="Caption"
                               Text="{Binding PopupCountdown, StringFormat={conv:Tr DashboardPopupCountdownFormat}}"
                               Foreground="{DynamicResource BrushEmergencyText}"
                               HorizontalAlignment="Center" />
                    <controls:WebcamPreviewControl Service="{Binding Webcam}"
                                                    Width="{Binding PopupPreviewWidth}"
                                                    Height="{Binding PopupPreviewHeight}"
                                                    Stretch="UniformToFill"
                                                    HorizontalAlignment="Center"
                                                    IsVisible="{Binding IsWebcamPreviewNeededInQuestionPanel}" />
                    <TextBlock Classes="Body"
                               Text="{Binding PopupQuestion}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding PopupAnswers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{Binding}"
                                        Classes="Ghost"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,4"
                                        Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).AnswerCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Spacing="16" IsVisible="{Binding IsPoseCountdownActive}">
                    <controls:WebcamPreviewControl Service="{Binding Webcam}"
                                                    Width="{Binding PopupPreviewWidth}"
                                                    Height="{Binding PopupPreviewHeight}"
                                                    Stretch="UniformToFill"
                                                    HorizontalAlignment="Center" />
                    <TextBlock Classes="EmployerVoice"
                               Text="{conv:Tr PoseForCameraCountdownLabel}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding PoseCountdown}"
                               Classes="NumberLarge"
                               HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="16" IsVisible="{Binding IsCurtsyCountdownActive}">
                    <controls:WebcamPreviewControl Service="{Binding Webcam}"
                                                    Width="{Binding PopupPreviewWidth}"
                                                    Height="{Binding PopupPreviewHeight}"
                                                    Stretch="UniformToFill"
                                                    HorizontalAlignment="Center" />
                    <TextBlock Classes="EmployerVoice"
                               Text="{conv:Tr CurtsyCountdownLabel}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CurtsyCountdown}"
                               Classes="NumberLarge"
                               HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="16" IsVisible="{Binding IsCurtsyRecordingActive}">
                    <controls:WebcamPreviewControl Service="{Binding Webcam}"
                                                    Width="{Binding PopupPreviewWidth}"
                                                    Height="{Binding PopupPreviewHeight}"
                                                    Stretch="UniformToFill"
                                                    HorizontalAlignment="Center" />
                    <TextBlock Classes="EmployerVoice"
                               Text="{conv:Tr CurtsyRecordingLabel}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CurtsyRecordingSecondsLeft}"
                               Classes="NumberLarge"
                               HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="16" IsVisible="{Binding IsShowingPopupOutcome}">
                    <Image Source="{Binding CapturedPosePhoto}"
                           Width="{Binding PopupPreviewWidth}"
                           Height="{Binding PopupPreviewHeight}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding CapturedPosePhoto, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Classes="EmployerVoice"
                               Text="{Binding PopupOutcomeMessage}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
            </Border>
        </Panel>

        <!-- ══════════════════════════════════════════════════════
             OUTFIT DRAWER (topmost overlay)
             ══════════════════════════════════════════════════════ -->
        <controls:OutfitDrawer x:Name="OutfitDrawerControl"
                               IsOpen="{Binding IsOutfitDrawerOpen}"
                               Outfit="{Binding CurrentOutfitVm}" />

    </Panel>

</UserControl>