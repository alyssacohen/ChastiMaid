<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:controls="using:ChastiMaid.Views.Controls"
             x:DataType="vm:DashboardViewModel"
             x:Class="ChastiMaid.Views.DashboardView"
             Background="{DynamicResource BrushWindowBackground}">

    <Panel>

        <!-- ══════════════════════════════════════════════════════
             IDLE MODE — full dashboard layout
             ══════════════════════════════════════════════════════ -->
        <Grid IsVisible="{Binding IsIdle}">

            <!-- ── PORTRAIT layout ── -->
            <Grid RowDefinitions="Auto,*,Auto"
                  IsVisible="{Binding !IsLandscape}">

                <!-- Status bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BrushSurfaceBase}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Height="50"
                        Padding="16,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10"
                                     Fill="{DynamicResource BrushStatusIdle}" />
                            <TextBlock Classes="BodySmall"
                                       Text="Idle"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="Outfit ▸"
                                Command="{Binding ToggleOutfitDrawerCommand}"
                                Classes="SmallGhost"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Scrollable content -->
                <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="16,16,16,0" Spacing="20">

                        <controls:DebtWidget DebtTotal="{Binding DebtTotal}"
                                             DebtSettled="{Binding DebtSettled}" />

                        <!-- Tasks section -->
                        <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Grid.Column="0"
                                           Classes="Subheading"
                                           Text="Tasks"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{DynamicResource BrushSurfaceBase}"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Classes="Caption"
                                               Text="{Binding Tasks.Count}" />
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" />

                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskItemViewModel">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                                                <StackPanel Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            Spacing="2"
                                                            Margin="0,0,8,0">
                                                    <TextBlock Classes="Body"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Classes="Caption"
                                                               Text="{Binding EstimatedDurationLabel}"
                                                               IsVisible="{Binding EstimatedDurationLabel,
                                                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Start"
                                                        Command="{Binding StartCommand}"
                                                        Classes="Primary compact"
                                                        MinHeight="44"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                            <Border Height="0.5"
                                                    Background="{DynamicResource BrushBorderSubtle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="Caption"
                                       Text="No pending tasks"
                                       HorizontalAlignment="Center"
                                       Margin="0,16">
                                <TextBlock.IsVisible>
                                    <Binding Path="Tasks.Count"
                                             Converter="{x:Static ObjectConverters.IsNull}"
                                             FallbackValue="False" />
                                </TextBlock.IsVisible>
                            </TextBlock>

                        </StackPanel>

                        <!-- Punishment button -->
                        <Button Command="{Binding OpenPunishmentsCommand}"
                                IsEnabled="{Binding HasPendingPunishments}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="6"
                                Classes="Amber">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Classes="Body"
                                           Text="Pending Punishments"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{DynamicResource BrushAmberText}"
                                        CornerRadius="12"
                                        MinWidth="24"
                                        Height="24"
                                        Padding="6,0"
                                        IsVisible="{Binding HasPendingPunishments}"
                                        VerticalAlignment="Center">
                                    <TextBlock Classes="Caption"
                                               Text="{Binding PendingPunishmentsCount}"
                                               Foreground="{DynamicResource BrushWindowBackground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Border Height="16" />

                    </StackPanel>
                </ScrollViewer>

                <!-- Action bar (pinned bottom) -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BrushSurfaceBase}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="8,8">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">

                        <Button Grid.Column="0"
                                Content="Request Permission"
                                Command="{Binding RequestPermissionCommand}"
                                Classes="Ghost compact"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="Shop"
                                Command="{Binding OpenShopCommand}"
                                Classes="Ghost compact"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                        <Button Grid.Column="2"
                                Content="End Session"
                                Command="{Binding EndSessionCommand}"
                                Classes="Ghost compact"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                        <Button Grid.Column="3"
                                Content="Emergency Break"
                                Command="{Binding EmergencyBreakCommand}"
                                Classes="Emergency compact"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                    </Grid>
                </Border>

            </Grid>

            <!-- ── LANDSCAPE layout ── -->
            <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,*"
                  IsVisible="{Binding IsLandscape}">

                <!-- Status bar (spans both columns) -->
                <Border Grid.Row="0" Grid.ColumnSpan="2"
                        Background="{DynamicResource BrushSurfaceBase}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Height="50"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10"
                                 Fill="{DynamicResource BrushStatusIdle}" />
                        <TextBlock Classes="BodySmall"
                                   Text="Idle"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Left rail -->
                <Border Grid.Row="1" Grid.Column="0"
                        Background="{DynamicResource BrushSurfaceBase}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,1,0"
                        Padding="12">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom"
                                Content="Current Outfit ▸"
                                Command="{Binding ToggleOutfitDrawerCommand}"
                                Classes="Ghost"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0,8,0,0" />

                        <StackPanel Spacing="8">
                            <controls:DebtWidget DebtTotal="{Binding DebtTotal}"
                                                 DebtSettled="{Binding DebtSettled}"
                                                 Margin="0,0,0,12" />

                            <Button Content="Request Permission"
                                    Command="{Binding RequestPermissionCommand}"
                                    Classes="Ghost compact"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="44" />

                            <Button Content="Shop"
                                    Command="{Binding OpenShopCommand}"
                                    Classes="Ghost compact"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="44" />

                            <Button Content="End Session"
                                    Command="{Binding EndSessionCommand}"
                                    Classes="Ghost compact"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="44" />

                            <Button Content="Emergency Break"
                                    Command="{Binding EmergencyBreakCommand}"
                                    Classes="Emergency compact"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="44" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Right: scrollable tasks + punishment -->
                <ScrollViewer Grid.Row="1" Grid.Column="1">
                    <StackPanel Margin="16,16,16,0" Spacing="20">

                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0"
                                       Classes="Subheading"
                                       Text="Tasks"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BrushSurfaceBase}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="Caption"
                                           Text="{Binding Tasks.Count}" />
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" />

                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskItemViewModel">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" MinHeight="56">
                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Spacing="2"
                                                        Margin="0,0,8,0">
                                                <TextBlock Classes="Body"
                                                           Text="{Binding Name}" />
                                                <TextBlock Classes="Caption"
                                                           Text="{Binding EstimatedDurationLabel}"
                                                           IsVisible="{Binding EstimatedDurationLabel,
                                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Start"
                                                    Command="{Binding StartCommand}"
                                                    Classes="Primary compact"
                                                    MinHeight="44"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="0.5"
                                                Background="{DynamicResource BrushBorderSubtle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Punishment button -->
                        <Button Command="{Binding OpenPunishmentsCommand}"
                                IsEnabled="{Binding HasPendingPunishments}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="6"
                                Classes="Amber">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Classes="Body"
                                           Text="Pending Punishments"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{DynamicResource BrushAmberText}"
                                        CornerRadius="12"
                                        MinWidth="24"
                                        Height="24"
                                        Padding="6,0"
                                        IsVisible="{Binding HasPendingPunishments}"
                                        VerticalAlignment="Center">
                                    <TextBlock Classes="Caption"
                                               Text="{Binding PendingPunishmentsCount}"
                                               Foreground="{DynamicResource BrushWindowBackground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Content="Complete Game"
                                Command="{Binding CompleteGameCommand}"
                                IsVisible="{Binding CanComplete}"
                                Classes="Primary"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,16" />

                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- ══════════════════════════════════════════════════════
             BUSY MODE overlay
             ══════════════════════════════════════════════════════ -->
        <Grid RowDefinitions="Auto,Auto,*,Auto"
              IsVisible="{Binding IsBusy}"
              Background="{DynamicResource BrushWindowBackground}">

            <TextBlock Grid.Row="0"
                       Text="{Binding BusyChoreName}"
                       Classes="Heading"
                       HorizontalAlignment="Center"
                       Margin="0,24" />

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Classes="Body"
                           Text="{Binding BusyChoreDescription}"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="Caption"
                           Text="{Binding BusyChoreValueDisplay}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="{Binding BusyElapsed}"
                       Classes="NumberLarge"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <Button Grid.Row="3"
                    Content="End Chore"
                    Command="{Binding EndChoreCommand}"
                    HorizontalAlignment="Center"
                    Classes="Primary"
                    Margin="0,0,0,24" />
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             TRIVIA POPUP overlay
             ══════════════════════════════════════════════════════ -->
        <Panel IsVisible="{Binding IsPopupVisible}" Classes="dialogOverlay">
            <Border Classes="dialogBox" MaxWidth="500">
                <StackPanel Spacing="16">
                    <TextBlock Classes="Caption"
                               Text="{Binding PopupCountdown, StringFormat='Time: {0}s'}"
                               Foreground="{DynamicResource BrushEmergencyText}"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="Body"
                               Text="{Binding PopupQuestion}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding PopupAnswers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{Binding}"
                                        Classes="Ghost"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,4"
                                        Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).AnswerCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ══════════════════════════════════════════════════════
             OUTFIT DRAWER (topmost overlay)
             ══════════════════════════════════════════════════════ -->
        <controls:OutfitDrawer x:Name="OutfitDrawerControl"
                               IsOpen="{Binding IsOutfitDrawerOpen}"
                               Outfit="{Binding CurrentOutfitVm}" />

    </Panel>

</UserControl>
