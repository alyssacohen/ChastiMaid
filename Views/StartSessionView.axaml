<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:v="using:ChastiMaid.Views"
             x:DataType="vm:StartSessionViewModel"
             x:Class="ChastiMaid.Views.StartSessionView">

    <Panel>
        <StackPanel HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="30">

            <TextBlock Text="Today's Outfit"
                       Classes="display"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <TextBlock Text="I have taken the liberty of choosing your attire. I am sure you will like it."
                       Classes="heading"
                       HorizontalAlignment="Center"
                       TextWrapping="WrapWithOverflow" />

            <TextBlock Text="{Binding ProposedOutfit}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="16">
                <Button Content="Accept"
                        Command="{Binding AcceptCommand}"
                        Classes="primary" />
                <Button Content="Regenerate"
                        Command="{Binding RegenerateCommand}"
                        IsEnabled="{Binding !IsLocked}" />
                <Button Content="Modify"
                        Command="{Binding ModifyCommand}"
                        IsEnabled="{Binding !IsLocked}" />
            </StackPanel>

        </StackPanel>

        <!-- Confirmation dialog overlay -->
        <ContentControl Content="{Binding ActiveDialog}"
                        IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:ConfirmDialogViewModel">
                    <v:ConfirmDialog />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Panel>

</UserControl>
