<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:StartSessionViewModel"
             x:Class="ChastiMaid.Views.StartSessionView">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="24">

        <TextBlock Text="{Binding DebtDisplay}"
                   HorizontalAlignment="Center"
                   Opacity="0.7"
                   FontSize="16" />

        <TextBlock Text="Today's Outfit"
                   Classes="h1"
                   HorizontalAlignment="Center" />

        <TextBlock Text="{Binding ProposedOutfit}" FontSize="16" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16">
            <Button Content="Accept"
                    Command="{Binding AcceptCommand}"
                    Padding="32,12" />
            <Button Content="Change Outfit"
                    Command="{Binding ChangeOutfitCommand}"
                    Padding="32,12" />
        </StackPanel>

    </StackPanel>

</UserControl>
