<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             xmlns:v="using:ChastiMaid.Views.Dialogs"
             x:DataType="vm:StartSessionViewModel"
             x:Class="ChastiMaid.Views.StartSessionView">

    <Panel>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="480"
                    Margin="40"
                    Spacing="16">

            <TextBlock Classes="PageTitle"
                       Text="Today's Outfit"
                       HorizontalAlignment="Center" />

            <TextBlock Classes="EmployerVoice"
                       Text="I have taken the liberty of choosing your attire. I am sure you will like it."
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <TextBlock Classes="Body"
                       Text="{Binding ProposedOutfit}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
                <Button Content="Accept"
                        Command="{Binding AcceptCommand}"
                        Classes="Primary" />
                <Button Content="Regenerate"
                        Command="{Binding RegenerateCommand}"
                        Classes="Ghost"
                        IsEnabled="{Binding CanRegenOrModify}" />
                <Button Content="Modify"
                        Command="{Binding ModifyCommand}"
                        Classes="Ghost"
                        IsEnabled="{Binding CanRegenOrModify}" />
                <Button Content="Quit"
                        Command="{Binding QuitCommand}"
                        Classes="Ghost" />
            </StackPanel>

        </StackPanel>

        <!-- Confirmation dialog overlay -->
        <ContentControl Content="{Binding ActiveDialog}"
                        IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:ConfirmDialogViewModel">
                    <v:ConfirmDialog />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Panel>

</UserControl>
