<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:ConfirmDialogViewModel"
             x:Class="ChastiMaid.Views.ConfirmDialog">

    <Panel Classes="dialogOverlay">
        <Border Classes="dialogBox">
            <StackPanel Spacing="16">

                <TextBlock Text="{Binding Title}"
                           Classes="heading"
                           HorizontalAlignment="Center" />

                <TextBlock Text="{Binding Message}"
                           TextAlignment="Center"
                           Opacity="0.85"
                           TextWrapping="Wrap" />

                <StackPanel Classes="buttonBar" Margin="0,8,0,0">
                    <Button Content="{Binding ConfirmLabel}"
                            Command="{Binding ConfirmCommand}"
                            Classes="primary" />
                    <Button Content="{Binding CancelLabel}"
                            Command="{Binding CancelCommand}"
                            Classes="secondary"
                            IsVisible="{Binding HasCancel}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>

</UserControl>
