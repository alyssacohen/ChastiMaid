<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:ConfirmDialogViewModel"
             x:Class="ChastiMaid.Views.ConfirmDialog">

    <!-- Overlay semitrasparente che copre tutta la view parent -->
    <Panel Background="#AA000000">
        <Border Background="{DynamicResource SystemChromeMediumColor}"
                CornerRadius="4"
                Padding="32,24"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16">

                <TextBlock Text="{Binding Title}"
                           Classes="heading"
                           HorizontalAlignment="Center" />

                <TextBlock Text="{Binding Message}"
                           TextAlignment="Center"
                           Opacity="0.85"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            Margin="0,8,0,0">

                    <Button Content="{Binding ConfirmLabel}"
                            Command="{Binding ConfirmCommand}" />

                    <Button Content="{Binding CancelLabel}"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding HasCancel}" />

                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>

</UserControl>
