<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:GameCompleteViewModel"
             x:Class="ChastiMaid.Views.GameCompleteView">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="24"
                MaxWidth="520">

        <TextBlock Text="Game Complete!"
                   Classes="heading"
                   HorizontalAlignment="Center" />

        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8"
                   Text="Congratulations! You have paid off your debt.&#10;You may export your session media before the save slot is freed." />

        <!-- Export buttons -->
        <StackPanel Spacing="12">
            <Button Content="Export Outfit Video"
                    Command="{Binding ExportOutfitVideoCommand}"
                    IsVisible="{Binding HasOutfitVideo}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />

            <Button Content="Export Safe Combination Photo"
                    Command="{Binding ExportSafePhotoCommand}"
                    IsVisible="{Binding HasSafePhoto}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
        </StackPanel>

        <!-- Status message -->
        <TextBlock Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center"
                   Opacity="0.7"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Finish -->
        <Button Content="Finish and Free Slot"
                Command="{Binding FinishCommand}"
                HorizontalAlignment="Center"
                Classes="primary"
                Margin="0,8,0,0" />

    </StackPanel>

</UserControl>
