<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:GameCompleteViewModel"
             x:Class="ChastiMaid.Views.GameCompleteView">

    <StackPanel Classes="pageContent">

        <TextBlock Text="Game Complete!" Classes="pageTitle" />

        <TextBlock Classes="subtitle"
                   Text="Congratulations! You have paid off your debt.&#10;You may export your session media before the save slot is freed." />

        <!-- Export buttons -->
        <StackPanel Spacing="12">
            <Button Content="Export Outfit Video"
                    Command="{Binding ExportOutfitVideoCommand}"
                    IsVisible="{Binding HasOutfitVideo}"
                    Classes="secondary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />

            <Button Content="Export Safe Combination Photo"
                    Command="{Binding ExportSafePhotoCommand}"
                    IsVisible="{Binding HasSafePhoto}"
                    Classes="secondary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
        </StackPanel>

        <!-- Status message -->
        <TextBlock Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center"
                   Classes="muted"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Finish -->
        <Button Content="Finish and Free Slot"
                Command="{Binding FinishCommand}"
                HorizontalAlignment="Center"
                Classes="primary" />

    </StackPanel>

</UserControl>
