<UserControl xmlns:ic="using:ChastiMaid.Views" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ChastiMaid.Localization"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:GameCompleteViewModel"
             x:Class="ChastiMaid.Views.GameCompleteView">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="480"
                Margin="40"
                Spacing="16">

        <TextBlock Classes="PageTitle"
                   Text="{l:Tr 'Service Complete'}"
                   HorizontalAlignment="Center" />

        <TextBlock Classes="EmployerVoice"
                   Text="{l:Tr 'Your debt is paid in full. That will do very nicely indeed.&#10;You may export your session media before the save slot is freed.'}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />

        <!-- Export buttons -->
        <StackPanel Spacing="12">
            <Button
                    Command="{Binding ExportOutfitVideoCommand}"
                    IsVisible="{Binding HasOutfitVideo}"
                    Classes="Ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.Video}" />
                    <TextBlock Text="{l:Tr 'Export Outfit Video'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button
                    Command="{Binding ExportSafePhotoCommand}"
                    IsVisible="{Binding HasSafePhoto}"
                    Classes="Ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                    <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.Image}" />
                    <TextBlock Text="{l:Tr 'Export Safe Combination Photo'}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Status message -->
        <TextBlock Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center"
                   Classes="Caption"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Finish -->
        <Button
                Command="{Binding FinishCommand}"
                HorizontalAlignment="Center"
                Classes="Primary">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                <TextBlock Classes="icon small" Text="{x:Static ic:LucideIcon.CheckCircle}" />
                <TextBlock Text="{l:Tr 'Finish and Free Slot'}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

    </StackPanel>

</UserControl>