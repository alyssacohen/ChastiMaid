<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChastiMaid.ViewModels"
             x:DataType="vm:GameCompleteViewModel"
             x:Class="ChastiMaid.Views.GameCompleteView">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="480"
                Margin="40"
                Spacing="16">

        <TextBlock Classes="PageTitle"
                   Text="Game Complete!"
                   HorizontalAlignment="Center" />

        <TextBlock Classes="EmployerVoice"
                   Text="Congratulations! You have paid off your debt.&#10;You may export your session media before the save slot is freed."
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />

        <!-- Export buttons -->
        <StackPanel Spacing="12">
            <Button Content="Export Outfit Video"
                    Command="{Binding ExportOutfitVideoCommand}"
                    IsVisible="{Binding HasOutfitVideo}"
                    Classes="Ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />

            <Button Content="Export Safe Combination Photo"
                    Command="{Binding ExportSafePhotoCommand}"
                    IsVisible="{Binding HasSafePhoto}"
                    Classes="Ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
        </StackPanel>

        <!-- Status message -->
        <TextBlock Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center"
                   Classes="Caption"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Finish -->
        <Button Content="Finish and Free Slot"
                Command="{Binding FinishCommand}"
                HorizontalAlignment="Center"
                Classes="Primary" />

    </StackPanel>

</UserControl>