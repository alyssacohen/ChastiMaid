<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Compile Remove="ChastiMaid.Tests\**\*.cs" />
    <Compile Remove="ChastiMaid.Launcher\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <None Include="Content\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Only the parts the app uses: the NAudio meta-package also pulls NAudio.WinForms, which drags in the
         Windows Desktop runtime (WinForms). -->
    <PackageReference Include="NAudio.Core" Version="3.0.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.0.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.5" />
    <PackageReference Include="ReactiveUI" Version="24.1.0" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.1" />
    <PackageReference Include="ReactiveUI.SourceGenerators" Version="3.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="GetText.NET" Version="10.0.1" />
  </ItemGroup>

  <!-- Translations: locale/*.po are the source of truth; the .mo catalogs are compiled on every build
       (never committed) and shipped as Content/locale/{lang}/LC_MESSAGES/ChastiMaid.mo. -->
  <PropertyGroup>
    <LocaleMoDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)locale</LocaleMoDir>
  </PropertyGroup>

  <ItemGroup>
    <LocalePo Include="locale/*.po" />
  </ItemGroup>

  <Target Name="CompileLocale"
          Inputs="@(LocalePo);tools/ChastiMaid.L10n/*.cs;tools/ChastiMaid.L10n/ChastiMaid.L10n.csproj"
          Outputs="@(LocalePo->'$(LocaleMoDir)/%(Filename)/LC_MESSAGES/ChastiMaid.mo')">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/tools/ChastiMaid.L10n&quot; -c Release -- compile &quot;$(MSBuildProjectDirectory)/locale&quot; &quot;$(LocaleMoDir)&quot;" />
  </Target>

  <Target Name="IncludeLocale" DependsOnTargets="CompileLocale" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Include="@(LocalePo->'$(LocaleMoDir)/%(Filename)/LC_MESSAGES/ChastiMaid.mo')"
            Link="Content/locale/%(Filename)/LC_MESSAGES/ChastiMaid.mo"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
