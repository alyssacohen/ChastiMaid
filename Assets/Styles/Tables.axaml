<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- TableRow — base style, enforces minimum height -->
  <Style Selector="Grid.TableRow">
    <Setter Property="MinHeight" Value="48"/>
  </Style>

  <!-- Border.even — alternating row background in wardrobe table -->
  <Style Selector="Border.even">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceSubtle}"/>
  </Style>

</Styles>
