<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- TableRow — base style, enforces minimum height -->
  <Style Selector="Grid.TableRow">
    <Setter Property="MinHeight" Value="48"/>
  </Style>

  <!-- TableRow.even — primary background (white) -->
  <Style Selector="Grid.TableRow.even">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceBase}"/>
  </Style>

  <!-- TableRow.odd — subtle alternating background -->
  <Style Selector="Grid.TableRow.odd">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceSubtle}"/>
  </Style>

</Styles>
