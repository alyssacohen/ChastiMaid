<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════
       SPACING SCALE (base 4px)
  ═══════════════════════════════════════════ -->
    <!-- Double values — for StackPanel.Spacing, WrapPanel.Spacing -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingLg">16</x:Double>
    <x:Double x:Key="SpacingXl">24</x:Double>
    <x:Double x:Key="SpacingXxl">40</x:Double>

    <!-- Thickness values — for Margin and Padding (uniform on all sides) -->
    <Thickness x:Key="SpacingXsThickness">4</Thickness>
    <Thickness x:Key="SpacingSmThickness">8</Thickness>
    <Thickness x:Key="SpacingMdThickness">12</Thickness>
    <Thickness x:Key="SpacingLgThickness">16</Thickness>
    <Thickness x:Key="SpacingXlThickness">24</Thickness>
    <Thickness x:Key="SpacingXxlThickness">40</Thickness>

    <!-- Button strip: more bottom breathing room than top -->
    <Thickness x:Key="SpacingButtonStripThickness">0,20,0,36</Thickness>

    <!-- ═══════════════════════════════════════════
       LAYOUT CONSTANTS
  ═══════════════════════════════════════════ -->
    <x:Double x:Key="NavPanelWidth">220</x:Double>
    <x:Double x:Key="TouchTargetMin">44</x:Double>
    <x:Double x:Key="TableRowHeight">48</x:Double>
    <x:Double x:Key="ChipHeight">30</x:Double>

</ResourceDictionary>