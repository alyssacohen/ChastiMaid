<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Previewer samples of the Wardrobe states: chip full / partial / none, number field with a value / mixed -->
    <Design.PreviewWith>
        <Border Background="{DynamicResource BrushSurfaceBase}" Padding="{DynamicResource SpacingXlThickness}">
            <StackPanel Spacing="{DynamicResource SpacingLg}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingSm}">
                    <ToggleButton Classes="filterChip" IsChecked="True" Content="maid" />
                    <ToggleButton Classes="filterChip" IsChecked="{x:Null}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXs}">
                            <TextBlock Text="wool" />
                            <TextBlock Classes="chip-count" Text="2/5" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="filterChip" IsChecked="False" Content="lace" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXl}">
                    <NumericUpDown Classes="underline stacked-spinner compact" Value="1.2"
                                   FormatString="0.0#" Increment="0.1" Minimum="0" />
                    <NumericUpDown Classes="underline stacked-spinner compact"
                                   FormatString="0.0#" Increment="0.1" Minimum="0" PlaceholderText="Different values" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- dialogOverlay — full-screen semi-transparent backdrop -->
    <Style Selector="Panel.dialogOverlay">
        <Setter Property="Background" Value="#80000000" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- dialogBox — centred modal card inside a dialogOverlay -->
    <Style Selector="Border.dialogBox">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceBase}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BoxShadow" Value="0 8 32 0 #30000000" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- fit — dialogBox that grows with its content instead of capping at the default width -->
    <Style Selector="Border.dialogBox.fit">
        <Setter Property="MaxWidth" Value="{x:Static x:Double.PositiveInfinity}" />
    </Style>

    <!-- dialogMessage — wrapped dialog text, capped so long copy wraps while the box can still grow for its buttons -->
    <Style Selector="TextBlock.dialogMessage">
        <Setter Property="MaxWidth" Value="432" />
    </Style>

    <!-- cameraMedia — camera preview or captured photo. Put it in a Grid "*" row (never in a StackPanel):
         it then takes all the height the texts and buttons leave, keeping the picture's own proportions -->
    <Style Selector=":is(Control).cameraMedia">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <!-- .between — a cameraMedia with texts above it too (full-page camera screens) -->
    <Style Selector=":is(Control).cameraMedia.between">
        <Setter Property="Margin" Value="0,16" />
    </Style>

    <!-- cameraText — texts and buttons around a cameraMedia, kept at dialog width while the picture can grow wider -->
    <Style Selector="StackPanel.cameraText">
        <Setter Property="MaxWidth" Value="452" />
        <Setter Property="Spacing" Value="16" />
    </Style>

    <!-- punishmentDrawer — bottom-anchored drawer inside a dialogOverlay, offset past the left nav rail -->
    <Style Selector="Border.punishmentDrawer">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceBase}" />
        <Setter Property="CornerRadius" Value="8,8,0,0" />
        <Setter Property="BoxShadow" Value="0 -8 32 0 #30000000" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="{DynamicResource NavPanelWidthThickness}" />
    </Style>

    <!-- card — surface card with subtle border (Settings forms) -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- contractPaper — the sheet the New Game contract is written on (centred column, scrolls inside a ScrollViewer) -->
    <Style Selector="Border.contractPaper">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="{DynamicResource SpacingXlThickness}" />
        <Setter Property="Margin" Value="{DynamicResource SpacingLgThickness}" />
        <Setter Property="MaxWidth" Value="{DynamicResource ContractPaperMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- contractActionBar — pinned strip under the contract holding its actions -->
    <Style Selector="Border.contractActionBar">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{DynamicResource SpacingLgThickness}" />
    </Style>

    <!-- statCard — compact metric tile (Writing Lines performance stats row) -->
    <Style Selector="Border.statCard">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceMuted}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- typewriterInput — real, visible TextBox for the Writing Lines live typing field (Writing Lines
         punishment). Text is bound one-way from the ViewModel's TypedText, always a valid correct prefix
         of the target phrase by construction, so it renders uniformly in the "correct" color.
         PlaceholderText shows the muted target phrase through the very same control — no separate
         watermark element to go out of alignment with, and a real native caret instead of a simulated one. -->
    <Style Selector="TextBox.typewriterInput">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTypingCorrect}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource TextMuted}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushSurfaceMuted}" />
        <Setter Property="FontFamily" Value="avares://ChastiMaid/Assets/Fonts/SpecialElite#Special Elite" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBox.typewriterInput /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- filterChip — ToggleButton chip for layer filters (WardrobeToolbar) -->
    <!-- Same footprint as before (ChipHeight 30): 1 px margin + 28 px chip, whose 1 px border takes 1 px of padding -->
    <Style Selector="ToggleButton.filterChip">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceMuted}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushChipBorder}" />
    </Style>
    <!-- Fluent recolours the border per state on the template's presenter: keep the chip border in every state
         (unselected, hover, disabled); checked and partial set their own below -->
    <Style Selector="ToggleButton.filterChip /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushChipBorder}" />
    </Style>
    <Style Selector="ToggleButton.filterChip:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushChipSelected}" />
    </Style>

    <Style Selector="ToggleButton.filterChip:checked">
        <Setter Property="Background" Value="{DynamicResource BrushChipSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushButtonPrimaryText}" />
    </Style>

    <!-- filterChip partial (IsChecked = null): only some of the edited items have the value. Faded fill and an accent
         border, plus an n/total counter (TextBlock.chip-count) in the content. Fluent styles this state on the
         template's presenter, so the override goes there too. Not dashed: Avalonia's Border cannot draw dashes. -->
    <Style Selector="ToggleButton.filterChip:indeterminate /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushChipPartial}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushChipSelected}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.filterChip TextBlock.chip-count">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ──────────────────────────────────────────────────────────
       navItem — ToggleButton for the Settings left-column nav
  ────────────────────────────────────────────────────────────── -->
    <Style Selector="RadioButton.navItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="16,0,16,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Child TextBlocks inherit the nav item foreground (overrides Typography classes) -->
    <Style Selector="RadioButton.navItem TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <!-- Icons keep the Lucide font. No :not(.icon) above: it would raise that rule's priority over the Typography classes -->
    <Style Selector="RadioButton.navItem TextBlock.icon">
        <Setter Property="FontFamily" Value="avares://ChastiMaid/Assets/Fonts/Lucide#lucide" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style Selector="RadioButton.navItem:pointerover, RadioButton.navItem:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushNavItemBorder}" />
    </Style>

    <!-- Selected state: subtle background highlight + left accent bar -->
    <Style Selector="RadioButton.navItem:checked">
        <Setter Property="Background" Value="{DynamicResource BrushNavItemSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushNavItemBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="RadioButton.navItem:checked TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ──────────────────────────────────────────────────────────
       Wardrobe master/detail (Settings › Wardrobe)
  ────────────────────────────────────────────────────────────── -->

    <!-- pane — bordered surface of the list and of the detail; paneHeader / paneFooter are its fixed bands -->
    <Style Selector="Border.pane">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.paneHeader">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="{DynamicResource TouchTargetMin}" />
    </Style>
    <Style Selector="Border.paneFooter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{DynamicResource SpacingMdThickness}" />
    </Style>

    <!-- wardrobeRow — a list row; checked rows are tinted, the active one has the checked nav-item tint and a
         semi-bold name. Hover shows rowHover, a veil under the whole row (checkbox and pencil included). -->
    <Style Selector="Border.wardrobeRow">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
    </Style>
    <Style Selector="Border.wardrobeRow.checked">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceMuted}" />
    </Style>
    <Style Selector="Border.wardrobeRow.active">
        <Setter Property="Background" Value="{DynamicResource BrushNavItemSelected}" />
    </Style>
    <Style Selector="Border.wardrobeRow:pointerover Border.rowHover">
        <Setter Property="Background" Value="{DynamicResource BrushRowHover}" />
    </Style>
    <Style Selector="Border.wardrobeRow.active TextBlock.rowName">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- rowButton — the clickable name area of a row (select; double-tap renames) -->
    <Style Selector="Button.rowButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="{DynamicResource TableRowHeight}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.rowButton /template/ ContentPresenter,
                     Button.rowButton:pointerover /template/ ContentPresenter,
                     Button.rowButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- checkCell — a touch-sized cell around a checkbox kept at its natural size, so the box stays centred;
         a tap anywhere in the cell toggles it (see SettingsWardrobeTab.OnCheckCellTapped) -->
    <Style Selector="Panel.checkCell">
        <Setter Property="Width" Value="{DynamicResource TouchTargetMin}" />
        <Setter Property="MinHeight" Value="{DynamicResource TouchTargetMin}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Panel.checkCell CheckBox">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- listCaption — the layers of an item beside its name; truncated first so the name keeps the room -->
    <Style Selector="TextBlock.listCaption">
        <Setter Property="MaxWidth" Value="{DynamicResource WardrobeListCaptionMaxWidth}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- badge — small count on an icon button (active filters) -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource BrushButtonPrimary}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-8,-12,0" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushButtonPrimaryText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Link — hyperlink-style action (Manage slots / tags, Edit rules); the label is a TextBlock.linkText -->
    <Style Selector="Button.Link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="{DynamicResource TouchTargetMin}" />
    </Style>
    <Style Selector="Button.Link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.linkText">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextAccent}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- menuItem — a full-width entry of a popover list (sort keys); .active is the current one -->
    <Style Selector="Button.menuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="{DynamicResource TouchTargetMin}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style Selector="Button.menuItem.active">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- popover — the panel of a Flyout / MenuFlyout opened from the toolbar (FlyoutPresenterClasses="popover") -->
    <Style Selector="FlyoutPresenter.popover">
        <!-- No horizontal scrolling: the width is capped, so chip lists wrap -->
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="{DynamicResource SpacingLgThickness}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter.popover MenuItem">
        <Setter Property="MinHeight" Value="{DynamicResource TouchTargetMin}" />
    </Style>

    <!-- fieldError — inline validation message under a field -->
    <Style Selector="TextBlock.fieldError">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushButtonDanger}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- notice — transient message at the bottom (deleted items, with Undo); dark on purpose, like the old bulk bar -->
    <Style Selector="Border.notice">
        <Setter Property="Background" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,4,4,4" />
        <Setter Property="Margin" Value="{DynamicResource SpacingXlThickness}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Border.notice TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushWindowBackground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.notice Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushWindowBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="MinHeight" Value="{DynamicResource TouchTargetMin}" />
        <Setter Property="MinWidth" Value="{DynamicResource TouchTargetMin}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.notice Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushWindowBackground}" />
    </Style>


    <!-- ──────────────────────────────────────────────────────────
       TextBox.underline — bottom border only, same visual as TagInput
  ────────────────────────────────────────────────────────────── -->
    <Style Selector="TextBox.underline">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,4,0,6" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBox.underline /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style
        Selector="TextBox.underline:focus /template/ Border#PART_BorderElement,
                   TextBox.underline:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonPrimary}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBox.underline:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ──────────────────────────────────────────────────────────
       NumericUpDown.underline — bottom border only, spinner icon-only
  ────────────────────────────────────────────────────────────── -->
    <Style Selector="NumericUpDown.underline">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown.underline /template/ ButtonSpinner">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="NumericUpDown.underline:focus-within /template/ ButtonSpinner">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonPrimary}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <!-- Strip inner TextBox chrome using descendant selector (works across template boundaries) -->
    <Style Selector="NumericUpDown.underline TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style
        Selector="NumericUpDown.underline TextBox:focus /template/ Border#PART_BorderElement,
                   NumericUpDown.underline TextBox:focus-within /template/ Border#PART_BorderElement,
                   NumericUpDown.underline TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Spinner buttons: icon-only, no border/background -->
    <Style Selector="NumericUpDown.underline RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="NumericUpDown.underline RepeatButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ──────────────────────────────────────────────────────────
       NumericUpDown.stacked-spinner — vertical up/down chevrons
  ────────────────────────────────────────────────────────────── -->
    <Style Selector="NumericUpDown.stacked-spinner StackPanel#PART_SpinnerPanel">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="2" />
    </Style>
    <!-- Restore symmetric padding so stacked buttons stay tap-friendly -->
    <Style Selector="NumericUpDown.stacked-spinner RepeatButton">
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <!-- NumericUpDown.touch — easier to use by finger without growing taller (compact layout): the stacked chevrons
         are a full touch target wide, and touch keyboards open their number layout -->
    <Style Selector="NumericUpDown.touch RepeatButton">
        <Setter Property="MinWidth" Value="{DynamicResource TouchTargetMin}" />
    </Style>
    <Style Selector="NumericUpDown.touch TextBox">
        <Setter Property="TextInputOptions.ContentType" Value="Number" />
    </Style>

    <!-- ──────────────────────────────────────────────────────────
       Underline field left empty on purpose (PlaceholderText, e.g.
       "Different values" when the edited items differ): the
       placeholder is italic and muted. Fluent binds no FontStyle on
       PART_Placeholder, so it is set on the part itself.
  ────────────────────────────────────────────────────────────── -->
    <Style Selector="NumericUpDown.underline TextBox">
        <Setter Property="PlaceholderForeground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="NumericUpDown.underline TextBox /template/ TextBlock#PART_Placeholder">
        <Setter Property="FontStyle" Value="Italic" />
    </Style>


    <!-- ──────────────────────────────────────────────────────────
       NumericUpDown.compact — fixed narrow width, right-aligned digits.
       Pairs with .underline.stacked-spinner in label+field rows so the
       label column can size to its full text (Grid = "*,Auto") instead
       of clipping at a fixed pixel width.
  ────────────────────────────────────────────────────────────── -->
    <Style Selector="NumericUpDown.compact">
        <Setter Property="Width" Value="{DynamicResource NumericFieldWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="NumericUpDown.compact TextBox">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!-- Every NumericUpDown parses as Float in the current culture: the default Any also reads the thousands separator,
         so on an Italian Windows "1.5" became 15; now the wrong separator is refused and the previous value comes back. -->
    <Style Selector="NumericUpDown">
        <Setter Property="ParsingNumberStyle" Value="Float" />
    </Style>

    <!-- unitSuffix — unit symbol (e.g. "%") in its own column to the right of a numeric field -->
    <Style Selector="TextBlock.unitSuffix">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ──────────────────────────────────────────────────────────
       Global: light selection highlight on all TextBoxes.
       TextBox.SelectionForegroundBrush (swapping the TEXT to a light
       color) is inert on the pinned Avalonia 12.0.5 — it's a known
       upstream regression (AvaloniaUI/Avalonia#21460) where selected
       text never repaints in the new brush. So instead of fighting
       that, the HIGHLIGHT itself is tinted light (accent-light) and
       the text keeps its normal dark Foreground, which stays legible
       without depending on the buggy property.
       NumericUpDown selector needed because its inner TextBox lives
       inside a ControlTemplate, where a more specific selector may
       be required to outrank the Fluent ControlTheme setter.
  ────────────────────────────────────────────────────────────── -->
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorLight3}" />
    </Style>
    <Style Selector="NumericUpDown TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorLight3}" />
    </Style>

</Styles>