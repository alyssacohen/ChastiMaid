<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- chip — default unselected state -->
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource BrushChipDefault}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="30" />
    </Style>

    <!-- chip.selected — user-selected value -->
    <Style Selector="Border.chip.selected">
        <Setter Property="Background" Value="{DynamicResource BrushChipSelected}" />
    </Style>

    <!-- chip.required — forced/required value -->
    <Style Selector="Border.chip.required">
        <Setter Property="Background" Value="{DynamicResource BrushChipRequired}" />
    </Style>

    <!-- chip-label — inner text for all chip states -->
    <Style Selector="TextBlock.chip-label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- chip-label on selected or required chip — inverted text -->
    <Style
        Selector="Border.chip.selected TextBlock.chip-label,
                   Border.chip.required TextBlock.chip-label">
        <Setter Property="Foreground" Value="{DynamicResource BrushButtonPrimaryText}" />
    </Style>

    <!-- × indicator — always visible; whole chip is the click target via Tapped -->
    <Style Selector="Border.chip TextBlock.chip-x">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!-- chip.info — two-line display chip (outfit proposal/confirm); auto height -->
    <Style Selector="Border.chip.info">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="4, 0" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Whole chip highlights on hover -->
    <Style Selector="Border.chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceMuted}" />
    </Style>

    <!-- ──────────────────────────────────────────────────────────
       Button.chip — interactive chip variant (ChangeOutfitView)
  ────────────────────────────────────────────────────────────── -->
    <Style Selector="Button.chip">
        <Setter Property="Background" Value="{DynamicResource BrushChipDefault}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.chip.selected">
        <Setter Property="Background" Value="{DynamicResource BrushChipSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushButtonPrimaryText}" />
    </Style>

    <Style Selector="Button.chip.required">
        <Setter Property="Background" Value="{DynamicResource BrushChipRequired}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushButtonPrimaryText}" />
    </Style>

    <Style Selector="Button.chip.disabled">
        <Setter Property="Opacity" Value="0.28" />
    </Style>

</Styles>