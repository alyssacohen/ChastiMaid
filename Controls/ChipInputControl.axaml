<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ChastiMaid.Controls"
             x:Class="ChastiMaid.Controls.ChipInputControl"
             x:DataType="local:ChipInputViewModel">

  <Grid RowDefinitions="Auto,Auto">

    <!-- Row 0: chip container + inline input -->
    <Border Grid.Row="0"
            Name="ContainerBorder"
            Background="Transparent"
            BorderBrush="{DynamicResource BrushBorderSubtle}"
            BorderThickness="0,0,0,1"
            Padding="0,4,0,6">

      <WrapPanel Name="ChipWrapPanel"
                 Orientation="Horizontal"
                 VerticalAlignment="Center">

        <!-- Chips rendered in code-behind -->
        <ItemsControl Name="ChipList"
                      ItemsSource="{Binding Values}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="chip"
                      Margin="0,2,4,2"
                      VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Classes="chip-label"
                             VerticalAlignment="Center"
                             Text="{Binding}"/>
                  <Button Background="Transparent"
                          BorderThickness="0"
                          Padding="6,0"
                          VerticalAlignment="Center"
                          FontSize="13"
                          Foreground="{DynamicResource TextMuted}"
                          Content="×"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Inline text input -->
        <TextBox Name="InputBox"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="4,2"
                 MinWidth="120"
                 FontFamily="Inter"
                 FontSize="13"
                 Foreground="{DynamicResource TextSecondary}"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 Text="{Binding InputText}"
                 PlaceholderText="{Binding Placeholder}"/>

      </WrapPanel>
    </Border>

    <!-- Row 1: autocomplete dropdown — floats via ZIndex -->
    <Border Grid.Row="1"
            Name="DropdownPanel"
            IsVisible="{Binding IsDropdownOpen}"
            Background="{DynamicResource BrushSurfaceBase}"
            BorderThickness="0"
            CornerRadius="0,0,6,6"
            Padding="0,4,0,8"
            ZIndex="100">

      <StackPanel Spacing="0">

        <TextBlock Classes="LabelUI"
                   Text="GIÀ USATI IN QUESTO PROGETTO"
                   Margin="8,0,0,6"/>

        <ItemsControl Name="SuggestionList"
                      ItemsSource="{Binding FilteredSuggestions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Name="SuggestionRow"
                      CornerRadius="0"
                      Padding="8,0"
                      Height="32"
                      Cursor="Hand">
                <TextBlock Classes="Body"
                           VerticalAlignment="Center"
                           Text="{Binding}"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </Border>

  </Grid>
</UserControl>
